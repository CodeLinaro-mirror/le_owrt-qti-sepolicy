;; Sepolicy rules for location daemon - lowi-server
(in .file
	;; location exec files transition
	(call .loc_lowi_server.obj_type_transition_execfile (unconfined.subj_typeattr)))

;;#============= Lowi Server ==============
(block loc_lowi_server
	;;
	;; Contexts
	;; --------
	(filecon "/usr/bin/lowi-server" file execfile_file_context)

	;;
	;; Macros
	;; ------
	(macro obj_type_transition_execfile ((type ARG1))
		(call .file.execfile_obj_type_transition
			(ARG1 execfile file "lowi-server")))

	;;
	;; Policy
	;; ------
	(blockinherit .agent.base_template)
	(blockinherit .file.exec.obj_macro_template)
	(blockinherit .loc_daemons_common.loc_daemons_common_template)

	(allow subj self (capability (net_admin)))

	;; import common rules for location deamons
	(call loc_daemons_common_rules (subj))

	(call subj_type_transition (subj))

	(call .sys.requestmodule (subj))

	(call .unknown.manage_miscfile_dirs (subj))

	(call .loc_launcher.use_fds (subj))

	;; connect to loc_launcher target stream
	(call .loc_launcher.connectto_unix_stream_sockets (subj))

	;;connect to mlid socket
	(call .mlid.connectto_unix_stream_sockets (subj))
	(allow subj mlid.subj create_unix_stream_socket)

	;; netlink sockets
	(allow subj self create_netlink_route_socket)
	(allow subj self create_netlink_generic_socket)
	(allow subj self create_netlink_socket)

	;; Create udp_socket
	(allow subj self create_udp_socket)
)
