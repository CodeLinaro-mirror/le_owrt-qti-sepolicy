;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

;; Copyright (c) 2022-2023 Qualcomm Innovation Center, Inc. All rights reserved.
;; SPDX-License-Identifier: BSD-3-Clause-Clear

(in .sys
    (call .qcmap_cm.subj_type_transition (subj)))

(in .file
    (call .qcmap_cm.obj_type_transition_execfile (unconfined.subj_typeattr))
    (call .qcmap_cm.obj_type_transition_conffile (unconfined.subj_typeattr))
    (call .qcmap_cm.obj_type_transition_datafile (unconfined.subj_typeattr dir data_qcmap))
    (call .qcmap_cm.obj_type_transition_runtimetmpfile (unconfined.subj_typeattr dir data)))

(block qcmap_cm
        ;;
        ;;Contexts
        ;;
        (filecon
        "/usr/bin/QCMAP_ConnectionManager"
        file
        execfile_file_context)

        (filecon
        "/etc/data"
        dir
        conffile_file_context)

        (filecon
        "/etc/data/.*"
        any
        conffile_file_context)

        (filecon
        "/data/data_qcmap"
        dir
        datafile_file_context)

        (filecon
        "/data/data_qcmap/.*"
        any
        datafile_file_context)

        (filecon
        "/dev/socket/data/.*"
        socket
        tmpfile_file_context)

        (filecon
        "/tmp/run/qnicorn_connect"
        any
        runtimetmpfile_file_context)

        (filecon
        "/tmp/data"
        dir
        tmpfile_file_context)

        (filecon
        "/tmp/data/*"
        any
        tmpfile_file_context)

        (filecon
        "/tmp/run/data"
         dir
         runtimetmpfile_file_context)

        ;; COPY FILECON STATEMENTS FROM QCMAP_CLI

        (filecon
         "/usr/bin/QCMAP_StaInterface"
         file
         execfile_file_context)

        (filecon
         "/tmp/run/charon\.vici"
         socket
         runtimetmpfile_file_context)

        (filecon
         "/tmp/run/charon\.ctl"
         socket
         runtimetmpfile_file_context)

        (filecon
         "/tmp/run/charon\.dck"
         socket
         runtimetmpfile_file_context)

        (filecon
         "/tmp/run/charon\.wlst"
         socket
         runtimetmpfile_file_context)

         (filecon
         "/tmp/run/charon\.xml"
         socket
         runtimetmpfile_file_context)

        (filecon
         "/tmp/run/starter\.charon\.pid"
         file
         runtimetmpfile_file_context)

        (filecon
         "/tmp/run/charon.pid"
         file
         runtimetmpfile_file_context)

        (filecon
         "/tmp/ipsec"
         dir
         tmpfile_file_context)

        (filecon
         "/tmp/ipsec/*"
         any
         tmpfile_file_context)

        (filecon
         "/tmp/swanctl"
         dir
         tmpfile_file_context)

        (filecon
         "/tmp/swanctl/*"
         any
         tmpfile_file_context)

        ;; COPY FILECON STATEMENTS FROM QCMAP_REF
        (filecon
         "/tmp/*"
         file
         tmpfile_file_context)

        (filecon
         "/dev/socket/data/nl_qcmap_client_uds_file"
         socket
         tmpfile_file_context)

        (filecon
         "/dev/socket/data/qcmap_client_nl_uds_file"
         socket
         tmpfile_file_context)

        ;; Macros
        ;;

        (macro obj_type_transition_execfile ((type ARG1))
              (call .file.execfile_obj_type_transition (ARG1 execfile file "qcmap_cm")))

        (macro obj_type_transition_conffile ((type ARG1))
              (call .file.conffile_obj_type_transition (ARG1 conffile dir "data")))

        (macro obj_type_transition_datafile ((type ARG1)(class ARG2)(name ARG3))
               (call .file.datafile_obj_type_transition (ARG1 datafile ARG2 ARG3)))

        (macro obj_type_transition_runtimetmpfile ((type ARG1)(class ARG2)(name ARG3))
               (call .tmpfile.runtimetmpfile_obj_type_transition (ARG1 runtimetmpfile ARG2 ARG3)))

        (macro obj_type_transition_tmpfile ((type ARG1)(class ARG2)(name ARG3))
               (call .tmp.fs_obj_type_transition (ARG1 tmpfile ARG2 ARG3)))

        ;; MACROS COPIED FROM QCMAP_CLI
        (macro obj_type_transition_runtimetmpfile_2 ((type ARG1))
               (call .tmpfile.runtimetmpfile_obj_type_transition (ARG1 runtimetmpfile sock_file "charon.ctl"))
               (call .tmpfile.runtimetmpfile_obj_type_transition (ARG1 runtimetmpfile sock_file "charon.dck"))
               (call .tmpfile.runtimetmpfile_obj_type_transition (ARG1 runtimetmpfile sock_file "charon.wlst"))
               (call .tmpfile.runtimetmpfile_obj_type_transition (ARG1 runtimetmpfile sock_file "charon.xml"))
               (call .tmpfile.runtimetmpfile_obj_type_transition (ARG1 runtimetmpfile file "starter.charon.pid"))
               (call .tmpfile.runtimetmpfile_obj_type_transition (ARG1 runtimetmpfile file "charon.pid")))

        (macro pidof_denials ((type ARG1) (type ARG2))
              (allow ARG1 ARG2 (dir (read open search getattr)))
              (allow ARG1 ARG2 (file (read open)))
              (allow ARG1 ARG2 (lnk_file (read))))

        ;; Policy
           (blockinherit .agent.base_template)
           (blockinherit file.conf.obj_template)
           (blockinherit .tmpfile.runtime.obj_template)
           (blockinherit file.data.obj_template)
           (blockinherit .tmpfile.obj_template)
           (blockinherit .dev.tty.obj_template)
        ;; (blockinherit .subj.subj_all_macro_template)

           (call obj_type_transition_runtimetmpfile (subj file "*"))
           (call obj_type_transition_tmpfile (subj sock_file "*"))
           (call obj_type_transition_datafile (subj dir "data_qcmap"))
           (call obj_type_transition_datafile (subj dir "qti"))
           (call .xtables.obj_type_transition_runtimetmpfile (subj))

        ;; Need creat for packet_socket, rawip_socket, udp_socket, qipcrtr_socket, unix_dgram_socket, unix_stream_socket, netlink_socket,
        ;; netlink_kobject_uevent_socket
           (allow subj self create_packet_socket)
           (allow subj self create_rawip_socket)
           (allow subj self create_udp_socket)
           (allow subj self create_netlink_socket)
           (allow subj self create_qipcrtr_socket)
           (allow subj self create_unix_dgram_socket)
           (allow subj self create_unix_stream_stream_socket)
           (allow subj self create_netlink_kobject_uevent_socket)
           (allow subj self create_netlink_netfilter_socket)

        ;; Need search on config files is needed - which is done on start /Stop  of services
          (call .qcmap_cm.search_conffile_dirs (subj))
        ;; Need for search on etc dir
          (call .file.search_conffile_dirs (subj))

        ;; TODO:we will allow this for intial version will remove later
           (allow subj self (capability (dac_override dac_read_search net_raw net_admin)))

        ;; Need for /dev/logd or logging
        ;; this will add write permission also
           (call .logd.unix_dgram_send(subj))

        ;; Needed for search on /sys/class
           (call .class.search_sysfile_dirs (subj))

        ;; Need search on /tmp/run dir
           (call .tmpfile.search_runtimetmpfile_dirs (subj))

        ;; Need search on /tmp/state/
           (call .tmpfile.search_statetmpfile_dirs (subj))

        ;; Need search, add_name on /dev/socket/data dir
           (call .qcmap_cm.search_runtimetmpfile_dirs (subj))
           (call .qcmap_cm.addname_runtimetmpfile_dirs (subj))
           (call .qcmap_cm.write_runtimetmpfile_dirs (subj))

        ;; Need write on qnicorn_connect
           (call .qcmap_cm.write_runtimetmpfile_sock_files (subj))

        ;; Need search on proc dir
           (call .sys.search_sysctlfile_dirs (subj))

        ;; (call .file.read_execfile_lnk_files (subj))

        ;; Needed for the /dev/kmsg write
           (call .kmsg.readwrite_nodedev_chr_files (subj))

        ;; Needed for /dev/socket/data/qcmap_dsi_uds_file
           (allow subj self (unix_dgram_socket (sendto)))

        ;; Need search, read, write on /proc/sys/net/netfilter/nf_conntrack_enable_sip_segmentation
           (call .netfilter.search_sysctlfile_dirs(subj))
           (call .netfilter.readwrite_sysctlfile(subj))
           (call .netfilter.readwrite_sysctlfile_sock_files (subj))

        ;; Module load is been called from the code which is not advised, adding the required permission for now.
           (call .sys.requestmodule (subj))

        ;; Need for search , manage , add_name in /dev
           (call .devices.search_sysfile_dirs (subj))
           (call .devices.manage_sysfile_files (subj))
           (call .devices.addname_sysfile_dirs (subj))
           (call .devices.write_sysfile_dirs (subj))

        ;; Need for busybox read, open, execute
           (call .shell.execute_execfile_files (subj))

        ;; Need for netlink_route_socket
           (allow subj self create_netlink_route_socket)

        ;; Need for search of net
           (call .net.search_sysctlfile_dirs (subj))

        ;; Need for create sock_file of nl_qcmap_uds_file tcontext qcmap_cm.tmpfile
           (call .qcmap_cm.create_tmpfile_sock_files (subj))
           (call .qcmap_cm.manage_tmpfile_sock_files (subj))
           (call .qcmap_cm.manage_tmpfile_dirs (subj))

        ;; Need module_request for kmod="netdev-rndis0" tcontext=u:r:sys.subj
           (call .sys.requestmodule (subj))

        ;; Need for connecto of unix_stream_socket
           (call .sys.connectto_unix_stream_sockets(subj))

        ;; Need for search on dir , write on files tcontext=u:r:ipv6.sysctlfile
           (call .ipv4.search_sysctlfile_dirs (subj))
           (call .ipv4.write_sysctlfile_files (subj))
           (call .ipv6.search_sysctlfile_dirs (subj))
           (call .ipv6.write_sysctlfile_files (subj))

        ;; Need nlmsg_read for netlink_route_socket
           (allow subj self (netlink_route_socket (nlmsg_read)))
           (allow subj self (netlink_route_socket (nlmsg_write)))

        ;; TODO : Have to move these dhcp_hosts denials to QCMAP LAN LIB file.Once we start handling the denials for QCMAP LAN LIB service.
        ;; Need create, read, write on name="dhcp_hosts" file
           (call .qcmap_cm.create_conffile_files(subj))
           (call .qcmap_cm.readwrite_conffile_files (subj))
        ;; Need write, add_name on /etc/data dir
           (call .qcmap_cm.addname_conffile_dirs(subj))
           (call .qcmap_cm.write_conffile_dirs(subj))
           (call .qcmap_cm.manage_conffile_files (subj))

        ;; Need search for fs dir with tcontext=u:r:fs.sysfile
           (call .fs.search_sysfile_dirs (subj))
        ;; Need search for tcontext=u:r:sys.fs tclass=dir
           (call .sys.search_fs_dirs (subj))
        ;; Need search on selinux dir
           (call .selinux.search_conffile_dirs(subj))
        ;; Need gettarr on selinux filesystem
           (call .selinux.getattr_filesystems(subj))

        ;; Need create, write, open, read on runtimetmpfile_files
           (call .qcmap_cm.create_runtimetmpfile_files (subj))
           (call .qcmap_cm.write_runtimetmpfile_files (subj))
           (call .qcmap_cm.read_runtimetmpfile_files (subj))
           (call .qcmap_cm.manage_runtimetmpfile_files (subj))

        ;; Need connectto for diag-router unix_stream_socket
           (call .diag-router.connectto_unix_stream_sockets (subj))

        ;; Need unlink for file tcontext qcmap_cm.conffile
           (allow subj qcmap_cm.conffile (file (unlink)))

        ;; Need read, open, execute on /usr/sbin/xtables-legacy-multi tcontext xtables.execfile
           (call .xtables.read_execfile_files (subj))
           (call .xtables.manage_execfile_files (subj))
           (call .xtables.mapexecute_execfile_files (subj))

       ;; Need read, open, create on /tmp/run/xtables.lock tcontext xtables.runtimetmpfile
          (call .xtables.create_runtimetmpfile_files (subj))
          (call .xtables.read_runtimetmpfile_files(subj))
          (call .xtables.manage_runtimetmpfile_files (subj))
          (call .xtables.addname_runtimetmpfile_dirs (subj))

          (call .kpi_values.append_sysfile_files (subj))
          (call .kpi_values.manage_sysfile_files (subj))
          (call .kernel.search_sysfile_dirs (subj))

      ;; Need open, iotcl, read, write on /tmp/data/kernel_ver.txt tcontext qcmap_cm.tmpfile
          (call .qcmap_cm.manage_tmpfile_files (subj))
      ;; Need manage on netmgr_connect_socket
         (call .netmgrd.manage_tmpfile_sock_files (subj))
         (call .netmgrd.connectto_unix_stream_sockets (subj))
      ;; Need remove on /tmp/ipv{4/6}config[0-9]+
          (call .qcmap_cm.manage_tmpfile_files (subj))
      ;; Need remove_name on /tmp/ to remove ipv{4/6}config[0-9]+ files
      ;; TODO : Remove below rule after changing location of ipv{4/6}config file
          (allow subj tmp.fs (dir(remove_name)))
          (call .modules.read_procfile_files (subj))
      ;; Need subj_type_transition on /usr/libexec/ip-tiny
          (call .ip.subj_type_transition (subj))
      ;; Need read on dhcp.leases
          (call .qcmap_cm.read_tmpfile_files (subj))

      ;; To kill hostapd/wpa_supplicant
      (allow subj .proc.fs (dir (read open)))
      ;; Need read on ipv6.sysctlfile
      (call .ipv6.read_sysctlfile_files (subj))
      ;; Need remove on /tmp/ipv{4/6}config[0-9]+
       (call .qcmap_cm.manage_tmpfile_files (subj))
      ;; Need for conntrack
      (call .conntrack.read_execfile_files (subj))
      (call .conntrack.execute_execfile_files (subj))

      ;;Need subj transition for ipa
      (call .ipacli.subj_type_transition (subj))
      (allow ipacli.subj qcmap_cm.subj (unix_stream_socket (read write)))
      (allow ipacli.subj qcmap_cm.subj readwriteinherited_fifo_file)
      (allow ipacli.subj qcmap_cm.subj (fd (use)))
      (allow ipacli.subj qcmap_cm.subj (netlink_socket (read write)))
      (allow ipacli.subj qcmap_cm.subj (packet_socket (read write)))
      (allow ipacli.subj qcmap_cm.subj (netlink_route_socket (read write)))
      (allow subj .net.procfile (lnk_file (read)))
      (allow subj .net.procfile (file (read open getattr)))
      (allow subj proc.fs (filesystem (getattr)))
      (call .resolv.read.subj_type (subj))
      (call .resolv.manage_tmpfile_files (subj))
      (call .resolv.search_tmpfile_dirs (subj))
      (call .resolv.readwrite_tmpfile_files (subj))
      (allow subj .net.netnode (udp_socket (node_bind)))
      (allow ip.subj qcmap_cm.subj (unix_dgram_socket (read write)))

      ;; Need open read on /
      (allow subj .sys.rootfile (dir(open read)))

      ;; Need execute on /sbin/uci
      (call .uci.execute_execfile_files (subj))
      (allow subj .uci.execfile (file(getattr read open map)))

      (call .uci.search_conffile_dirs (subj))
      (call .uci.readwrite_conffile_files (subj))
      (call .uci.manage_conffile_files (subj))

      ;; Need read open and execute_no_trans permission on /usr/sbin/ebtables
      (call .file.manage_conffile_files (subj))
      (call .file.execute_execfile_files (subj))

      ;; Need search on adpl dir
      (call .dataadpl.search_conffile_dirs (subj))
      ;; Need open read on adpl dir
      (call .dataadpl.read_conffile_files (subj))
      ;; Need watch on adpl dir
      (allow subj dataadpl.conffile (dir (watch)))
      ;; Need permission for sysfs
      (allow subj .class.sysfile (lnk_file (read)))

      ;; Need permission to run init.d script
      (call .wpad.subj_type_transition (subj))
      (call .qcmap_cm.execute_conffile_files (subj))
      (call .wifi.search_datafile_dirs (subj))
      (call .file.execute_initscriptfile_files (subj))
      (call .file.search_initscriptfile_dirs (subj))
      (allow subj .wifi.datafile (sock_file (write)))
      (allow subj .file.initscriptfile (file (execute read open)))

      ;; Need permissions write log from backhaulCommonConfig.sh
      (call .qcmap_cm.search_datafile_dirs (subj))
      (allow subj .qcmap_cm.datafile (file (append open)))

      ;; Need open on /etc/data/adpl/mhi_enable
      (call .dataadpl.manage_conffile_files (subj))
      ;; Need read on adpl dir
      (call .dataadpl.manage_conffile_dirs (subj))
      ;; Need permission for dhcp_release
      (allow subj .net.netif (netif (egress)))
      (allow subj .net.netnode (node (sendto)))
      (call .tmpfile.search_statetmpfile_dirs (subj))

      ;; SpeedTest related permissions
      (allow subj loc_etc.conffile (file (read open)))
      (allow subj leprop.miscfile (sock_file (write)))
      (allow subj leprop.subj (unix_stream_socket (connectto)))
      (allow subj loc_socket.nodedev (dir (search write add_name getattr)))
      (allow subj loc_socket.nodedev (sock_file (create setattr write)))
      (allow subj loc_data.datafile (dir (search)))
      (allow subj loc_hal_daemon.subj (unix_dgram_socket (sendto)))

      ;; Permissions to run ubus from qcmap_cm
      (call .ubusd.search_runtimetmpfile_dirs (subj))
      (call .ubusd.write_runtimetmpfile_sock_files (subj))
      (allow subj ubusd.subj (unix_stream_socket (connectto)))

      ;; Permissions for backhaulCommonC
      (allow subj functions.miscfile (file (read open getattr)))
      (allow subj functions.miscfile (dir (search)))
      (allow subj netifd.miscfile (dir (search)))
      (allow subj netifd.miscfile (file (read open)))
      (allow subj libubox.datafile (dir (search)))
      (allow subj libubox.datafile (file (read open)))
      (allow subj loc_socket.nodedev (dir (getattr)))
      (call .nameservice.read_miscfile_files (subj))

      ;; Ubus API related permissions
      (allow subj ubusd.runtimetmpfile (sock_file (write)))
      (allow subj ubusd.runtimetmpfile (dir (search)))
      (allow subj tmp.fs (file (read open)))
      ;; Need transition to kmodloader need this for lsmod(datapath optimization)
      (call .kmodloader.subj_type_transition (subj))
      (call .kmodloader.read_execfile_files (subj))
      (call .kmodloader.mapexecute_execfile_files(subj))
      (allow kmodloader.subj qcmap_cm.subj (fd (use)))
      (allow kmodloader.subj qcmap_cm.subj (unix_stream_socket (read write)))
      (allow kmodloader.subj qcmap_cm.subj (fifo_file (read write ioctl)))
      (allow kmodloader.subj qcmap_cm.subj (netlink_route_socket (read write ioctl)))
      (allow kmodloader.subj qcmap_cm.subj (packet_socket (read write ioctl)))
      (allow kmodloader.subj qcmap_cm.subj (netlink_socket (read write ioctl)))

      ;; COPIED FROM QCMAP_CLI

      (call obj_type_transition_runtimetmpfile_2 (subj))
      (call obj_type_transition_tmpfile (subj file "*"))

      ;; Need obj_type_transition for /etc/firewall.user.*
      (call .firewall.obj_type_transition_conffile_ext (subj))
    ;; Need for netlink_route_socket
    (allow subj self create_netlink_route_socket)
    (allow subj self create_rawip_socket)
    (allow subj self (capability (net_raw net_admin setgid setpcap setuid)))
    (allow subj self create_qipcrtr_socket)
    (allow subj self create_unix_stream_stream_socket)
    (call .diag-router.connectto_unix_stream_sockets (subj))
    (call .file.search_conffile_dirs (subj))
    (call .qcmap_cm.search_conffile_dirs (subj))
    (call .dev.readwriteinherited_ttydev_chr_files (subj))
    (call .console.readwriteinherited_ttydev_chr_files (subj))
    (call .ttyd.readwriteinherited_ptydev_chr_files (subj))
    (allow subj  ttydev readwriteinherited_chr_file)
    ;; Need read open execute on /etc/data/nat_alg_vpn_config.sh
    (call .qcmap_cm.search_conffile_dirs (subj))
    (call .qcmap_cm.execute_conffile_files (subj))
    ;; Need search on selinux dir
    (call .selinux.search_conffile_dirs(subj))
    ;; Need gettarr on selinux filesystem
    (call .selinux.getattr_filesystems (subj))
    (call .qcmap_cm.manage_conffile_dirs (subj))
    ;; Need search for fs dir with tcontext=u:r:fs.sysfile
    (call .fs.search_sysfile_dirs (subj))
    ;; Need search for tcontext=u:r:sys.fs tclass=dir
    (call .sys.search_fs_dirs (subj))
    ;; Need search on selinux dir
    (call .selinux.search_conffile_dirs(subj))
    ;; Need gettarr on selinux filesystem
    (call .selinux.getattr_filesystems(subj))
    ;; Need read, execute on /etc/init.d/network
    (call .file.search_initscriptfile_dirs (subj))
    ;; Need read write on /
    (allow subj .sys.rootfile (dir(open read)))
    ;; Need manage on /tmp/ipv{4/6}config[0-9]+
    (call .qcmap_cm.manage_tmpfile_files (subj))
    ;; Need execute on rmnet_update.sh
    (call .netifd.search_miscfile_dirs (subj))
    (call .netifd.execute_miscfile_files (subj))
    (call .netifd.manage_miscfile_files (subj))
    (allow subj netifd.tmpfile (file (getattr read open append create write)))
    (call .uci.subj_type_transition (subj))
    (call .ifup.subj_type_transition (subj))
    (call .ubus.subj_type_transition (subj))
    (call .rcnetwork.subj_type_transition (subj))
    (call .rcfirewall.subj_type_transition (subj))
    ;;(call .shell.execfile_subj_type_transition (subj .shell.subj))
    (call .shell.mapexecute_execfile_files (subj))
    (call .shell.manage_execfile_files (subj))
    (allow subj .shell.execfile (file (execute_no_trans)))
    ;;Need search manage on /lib/functions.sh
    (call .functions.manage_miscfile_files (subj))
    (call .functions.search_miscfile_dirs (subj))
    ;; Need read open on libubox
    (call .libubox.search_datafile_dirs (subj))
    (call .libubox.manage_datafile_files (subj))
    ;; Need remove_name on /tmp/ to remove ipv{4/6}config[0-9]+ files
    (allow subj tmp.fs (dir(remove_name)))
    ;; Need open write on /etc/firewall.user
    (call .firewall.manage_conffile_files (subj))
    ;; Need transition to ipa while indicating to ipa offload
    (call .ipacli.subj_type_transition (subj))
    ;; Need transition to run dnsmasq restart
    (call .rcdnsmasq.subj_type_transition (subj))
    ;; Need permission to reboot on first vlan creation
    (allow subj .sys.subj (process(signal)))
    (call .uci.search_conffile_dirs (subj))
    ;; Need permissions on /tmp/data/
    (call .qcmap_cm.manage_tmpfile_dirs (subj))
    ;; Need to print on adb shell
    (call .sys.readwriteinherited_ptydev_chr_files (subj))
    ;; Need to create unix_dgram_socket
    (allow subj self create_unix_dgram_socket)
    (call .nameservice.read_miscfile_files (subj))
    ;; Need this to indicate IPA on first vlan creation
    (allow ipacli.subj qcmap_cm.subj (unix_stream_socket (read write)))
    (allow ipacli.subj qcmap_cm.subj readwriteinherited_fifo_file)
    (allow ipacli.subj qcmap_cm.subj (fd (use)))
    (allow ipacli.subj file.conffile (dir (search)))
    ;; Need read open on /etc/misc/wifi/5g_wireless
    (allow subj .wpad.miscfile (dir (search getattr read)))
    (allow subj .wpad.miscfile (file (getattr read open)))
    ;; To execute /usr/sbin/hostapd_cli
