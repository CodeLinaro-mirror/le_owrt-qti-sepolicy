(in .fw3

;; policy

(allow subj self (capability (dac_read_search)))
(call .qcmap_cli.use_fds (subj))
(call .qcmap_cli.readwrite_unix_stream_sockets (subj))
(allow .fw3.subj .qcmap_cli.subj (fifo_file (read write ioctl)))
(allow subj .fw3.execfile (file (execute_no_trans execute map read write open)))
(call .qcmap_ref.use_fds (subj))
(call .qcmap_ref.readwrite_unix_stream_sockets (subj))
(allow .fw3.subj .qcmap_ref.subj (fifo_file (read write ioctl)))
(call .netifd.read_runtimetmpfile_files (subj))
(call .netifd.manage_runtimetmpfile_files(subj))
(call .mnt.search_miscfile_dirs (subj))
(allow subj .debug.fs (dir (search read open)))
(call .miniupnpd.read_datafile_files(subj))
(call .uci.mapexecute_execfile_files(subj))
(call .uci.read_execfile_files (subj))
(call .uci.subj_type_transition (subj))
(allow uci.subj fw3.subj (unix_stream_socket (read write)))
(allow uci.subj fw3.subj readwriteinherited_fifo_file)
(allow uci.subj fw3.subj (fd (use)))
(call .ubus.mapexecute_execfile_files(subj))
(call .ubus.read_execfile_files (subj))
(call .ubus.subj_type_transition (subj))
(allow ubus.subj fw3.subj (unix_stream_socket (read write)))
(allow ubus.subj fw3.subj readwriteinherited_fifo_file)
(allow ubus.subj fw3.subj (fd (use)))
(call .jsonfilter.mapexecute_execfile_files(subj))
(call .jsonfilter.read_execfile_files (subj))
(call .jsonfilter.subj_type_transition (subj))
(allow jsonfilter.subj fw3.subj (fd (use)))
(allow jsonfilter.subj fw3.subj (unix_stream_socket (read write)))
(allow jsonfilter.subj fw3.subj readwriteinherited_fifo_file)
(allow subj .ucode.subj (fd (use)))
;; denied { execute_no_trans } for  pid=11079 comm="sh" path="/sbin/fw3"
;; dev="mmcblk0p40" ino=1385 scontext=u:r:fw3.subj tcontext=u:r:fw3.execfile tclass=file
(call .fw3.subj_type_transition (subj))
(call .fw3.mapexecute_execfile_files(subj))
(call .fw3.read_execfile_files (subj))
(allow subj qcmap_ref.subj (netlink_route_socket (read write)))
;;open/write pmsg_dev.nodedev
(allow subj .pmsg_dev.nodedev (chr_file (write open)))
(allow subj .qcmap_cli.subj (fifo_file(getattr)))
(allow subj .qcmap_ref.subj (fifo_file(getattr)))
(allow subj .sys.fs (filesystem (getattr)))
(allow subj .filesystems.procfile (file (read open)))
(allow subj .qcmap_cm.conffile (dir (search)))
(allow subj ucode.subj (fd (use)))
(allow subj .firewall.conffile (file (getattr)))
(allow subj .qcmap_cm.conffile (file (getattr)))

(call .ifli.use_fds (subj))
(call .ifli.readwrite_unix_stream_sockets (subj))
(allow subj ifli.subj (tcp_socket (read write)))
(allow subj tmpfile.logtmpfile (file (append)))

;; Need permission for /usr/share/pbr/pbr.firewall.include
(allow subj .file.datafile (file (getattr)))

(dontaudit subj .sys.rootfile (dir (read)))
)



