;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

;; Sepolicy rules for EasyMesh Applicatio and daemons that support EasyMesh
;; which includes ezmesh, wsplcd, hyfi-bridge, hyctl, repacd.

(in .sys
    (call .ezmesh.subj_type_transition (subj))
)

(in .file
    (call .ezmesh.obj_type_transition_execfile_ez (unconfined.subj_typeattr))
    (call .ezmesh.obj_type_transition_tmpfile (unconfined.subj_typeattr file "wsplcd-lan.conf"))
    (call .ezmesh.obj_type_transition_tmpfile (unconfined.subj_typeattr file "firstboot"))
    (call .ezmesh.obj_type_transition_tmpfile (unconfined.subj_typeattr file "mad.conf"))
    (call .ezmesh.obj_type_transition_tmpfile (unconfined.subj_typeattr file "bootup_completed"))
    (call .ezmesh.obj_type_transition_tmpfile (unconfined.subj_typeattr file "ezmesh.log"))
    (call .ezmesh.obj_type_transition_tmpfile (unconfined.subj_typeattr file "wsplcd-lan.log"))
    (call .ezmesh.obj_type_transition_tmpfile (unconfined.subj_typeattr file "mapConfig.log"))
    (call .ezmesh.obj_type_transition_runtimetmpfile (unconfined.subj_typeattr)))

(block ezmesh
    ;;
    ;; Contexts
    ;;

    ;; Conf file contexts
    (filecon "/etc/ezmesh" dir conffile_file_context)
    (filecon "/etc/ezmesh/.*" any conffile_file_context)
    (filecon "/etc/wsplcd" dir conffile_file_context)
    (filecon "/etc/wsplcd/.*" any conffile_file_context)


    ;; exec file contexts
    (filecon "/usr/bin/wsplcd" file execfile_file_context)
    (filecon "/usr/bin/wsplcd-map" file execfile_file_context)
    (filecon "/usr/bin/ezmesh" file execfile_file_context)
    (filecon "/usr/bin/ezmesh-cmd" file execfile_file_context)
    (filecon "/usr/bin/ezmeshAgent" file execfile_file_context)
    (filecon "/usr/bin/ezmeshCtrl" file execfile_file_context)
    (filecon "/usr/bin/hyctl" file execfile_file_context)
    (filecon "/usr/bin/son_cli" file execfile_file_context)
    (filecon "/usr/bin/repacdcli" file execfile_file_context)
    (filecon "/usr/bin/repacd-run\.sh" file execfile_file_context)
    (filecon "/usr/bin/repacd-detect_device_mode\.sh" file execfile_file_context)
    (filecon "/usr/bin/mesh_app" file execfile_file_context)
    (filecon "/usr/bin/mat" file execfile_file_context)
    (filecon "/usr/bin/emt" file execfile_file_context)
    (filecon "/usr/bin/de_nb_client" file execfile_file_context)
    (filecon "/usr/bin/cfg80211tool_mesh" file execfile_file_context)

    ;; initscript filecontexts
    (filecon "/etc/init\.d/ezmesh" file initscriptfile_file_context)
    (filecon "/etc/init\.d/wsplcd" file initscriptfile_file_context)
    (filecon "/etc/init\.d/hyfi-bridging" file initscriptfile_file_context)
    (filecon "/etc/init\.d/repacd" file initscriptfile_file_context)
    (filecon "/etc/init\.d/mesh_app" file initscriptfile_file_context)

    ;; tmpfile filecontexts

    (filecon "/tmp/wsplcd-.*\.conf" file tmpfile_file_context)
    (filecon "/tmp/mad.conf" file tmpfile_file_context)
    (filecon "/tmp/firstboot" file tmpfile_file_context)
    (filecon "/tmp/bootup_completed" file tmpfile_file_context)
    (filecon "/tmp/ezmesh\.log" file tmpfile_file_context)
    (filecon "/tmp/\.vap_seting_lock" file tmpfile_file_context)
    (filecon "/tmp/\.ezmesh\.restart\.pending" file tmpfile_file_context)
    (filecon "/tmp/\.ezmesh\.restart\.pending" dir tmpfile_file_context)
    (filecon "/tmp/ezmesh-lan-tmp\.conf" any tmpfile_file_context)
    (filecon "/tmp/ezmesh-lan\.conf" any tmpfile_file_context)
    (filecon "/tmp/mapTempIntfList" any tmpfile_file_context)
    (filecon "/tmp/mapTempIntfListWsplcd" any tmpfile_file_context)
    (filecon "/tmp/map_key_info\.tmp" any tmpfile_file_context)

    ;; runtimetmpfile filecontexts for /tmp/run



    (filecon "/tmp/run/whc-wifi-config\.lock" dir runtimetmpfile_file_context)
    (filecon "/tmp/run/whc-wifi-config\.lock/.*" any runtimetmpfile_file_context)
    (filecon "/tmp/run/wsplcd_ctrl_ath[0-9]+[0-9]+" dir runtimetmpfile_file_context)
    (filecon "/tmp/run/wsplcd_ctrl_ath[0-9]+[0-9]+/.*" any runtimetmpfile_file_context)
    (filecon "/tmp/run/wsplcd\.lock" dir runtimetmpfile_file_context)
    (filecon "/tmp/run/wsplcd\.lock/.*" any runtimetmpfile_file_context)
    (filecon "/tmp/run/ezmesh-.*\.fifo" pipe runtimetmpfile_file_context)
    (filecon "/tmp/run/wsplcd_ctrl_ath0" file runtimetmpfile_file_context)
    (filecon "/tmp/run/mesh_server" socket runtimetmpfile_file_context)
    (filecon "/tmp/run/ubus/ubus\.sock" socket runtimetmpfile_file_context)
    (filecon "/tmp/run/wsplc\.pipe" pipe runtimetmpfile_file_context)
    (filecon "/tmp/run/mapserver" socket runtimetmpfile_file_context)
    (filecon "/tmp/run/mapclient" socket runtimetmpfile_file_context)
    (filecon "/tmp/run/dbus/system_bus_socket" socket runtimetmpfile_file_context)

    ;;
    ;; Macros
    ;;

    ;; execfile macros

     (macro obj_type_transition_execfile_ez ((type ARG1))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "wsplcd"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "wsplcd-map"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "ezmesh"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "ezmesh-cmd"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "ezmeshAgent"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "hyctl"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "son_cli"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "repacd-run.sh"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "repacd-detect_device_mode.sh"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "mesh_app"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "mat"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "emt"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "de_nb_client"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "cfg80211tool_mesh"))
    )

;; conffile macros

    (macro obj_type_transition_conffile ((type ARG1))
          (call .file.conffile_obj_type_transition
                (ARG1 conffile dir "ezmesh"))
          (call .file.conffile_obj_type_transition
                (ARG1 conffile dir "wsplcd")))


    (macro obj_type_transition_tmpfile ((type ARG1) (class ARG2) (name ARG3))
        (call .tmp.fs_obj_type_transition (ARG1 tmpfile ARG2 ARG3)))

    (macro dontaudit_pgrep_killall_cmd_search_perms ((type ARG1) (type ARG2))
        (dontaudit ARG1 ARG2 (dir (search write remove_name add_name create read open getattr execute map ioctl write)))
        (dontaudit ARG1 ARG2 (file (read open)))
        (dontaudit ARG1 ARG2 (lnk_file (getattr read open execute map)))
    )


(macro obj_type_transition_runtimetmpfile ((type ARG1))

(call .tmpfile.runtimetmpfile_obj_type_transition
                    (ARG1 runtimetmpfile dir "whc-wifi-config.lock"))
(call .tmpfile.runtimetmpfile_obj_type_transition
                    (ARG1 runtimetmpfile dir "wsplcd.lock"))
(call .tmpfile.runtimetmpfile_obj_type_transition
                    (ARG1 runtimetmpfile fifo_file "ezmesh-ctrl-cmd.fifo"))
(call .tmpfile.runtimetmpfile_obj_type_transition
                    (ARG1 runtimetmpfile fifo_file "ezmesh-agent-cmd.fifo"))
(call .tmpfile.runtimetmpfile_obj_type_transition
                    (ARG1 runtimetmpfile dir "ezmesh-agent-cmd.fifo"))
(call .tmpfile.runtimetmpfile_obj_type_transition
                    (ARG1 runtimetmpfile sock_file "mesh_server"))
(call .tmpfile.runtimetmpfile_obj_type_transition
                    (ARG1 runtimetmpfile sock_file "ubus.sock"))
(call .tmpfile.runtimetmpfile_obj_type_transition
                    (ARG1 runtimetmpfile sock_file "system_bus_socket"))
(call .tmpfile.runtimetmpfile_obj_type_transition
                    (ARG1 runtimetmpfile sock_file "*"))
(call .tmpfile.runtimetmpfile_obj_type_transition
                    (ARG1 runtimetmpfile fifo_file "wsplc.pipe"))
)

    (macro read_sysfile_dirs ((type ARG1))
        (allow ARG1 .block.sysfile (dir (search read open)))
    )

    (call obj_type_transition_tmpfile (subj dir "ezmesh-lan-tmp.conf"))
    (call obj_type_transition_tmpfile (subj file "ezmesh-lan-tmp.conf"))
    (call obj_type_transition_tmpfile (subj dir "mapTempIntfList"))
    (call obj_type_transition_tmpfile (subj file "mapTempIntfListWsplcd"))
    (call obj_type_transition_tmpfile (subj file "ezmesh-lan.conf"))
    (call obj_type_transition_tmpfile (subj file "wsplcd-lan.conf"))
    (call obj_type_transition_tmpfile (subj file "firstboot"))
    (call obj_type_transition_tmpfile (subj file "ezmesh.log"))
    (call obj_type_transition_tmpfile (subj file "wsplcd-lan.log"))
    (call obj_type_transition_tmpfile (subj file ".ezmesh.restart.pending"))
    (call obj_type_transition_tmpfile (subj dir ".ezmesh.restart.pending"))
    (call obj_type_transition_tmpfile (subj file ".vap_seting_lock"))
    (call obj_type_transition_tmpfile (subj file "map_key_info.tmp"))
    (call obj_type_transition_tmpfile (subj file "mapConfig.log"))
    (call obj_type_transition_tmpfile (subj file "*"))
    (call obj_type_transition_runtimetmpfile (subj))


   ;; calling exec macro
   (call obj_type_transition_execfile_ez (subj))

    ;;
    ;; Policy
    ;;
    (blockinherit .agent.base_template)
    (blockinherit .file.conf.obj_template)
    (blockinherit .tmpfile.obj_template)
    (blockinherit .file.initscript.obj_template)
    (blockinherit .tmpfile.runtime.obj_template)
    (blockinherit file.data.obj_template)

    ;;Ezmesh

    (allow subj self create_udp_socket)
    (allow subj self (process (getsched)))
    (allow subj self (capability (net_admin net_raw)))
    (allow subj self (shm (read associate unix_read unix_write create write)))
    (allow subj self (netlink_generic_socket (ioctl read setopt bind getattr listen sendto create write)))
    (allow subj self (netlink_crypto_socket (ioctl read setopt bind getattr listen sendto create write)))
    (allow subj self (netlink_route_socket (ioctl read setopt bind getattr listen sendto write nlmsg_write create)))
    (allow subj self (unix_dgram_socket (ioctl read setopt bind getattr getopt connect listen sendto)))
    (allow subj self (unix_stream_socket (create read write connect)))
    (allow subj self (netlink_socket (ioctl read setopt bind getattr listen sendto create write)))
    (allow subj self (sem (unix_read associate create write unix_write read )))
    (allow subj self (packet_socket (ioctl read setopt bind getattr getopt listen sendto create write)))
    (allow subj self (udp_socket (ioctl read setopt bind getattr listen sendto create )))
    (allow subj self (tcp_socket (ioctl read setopt bind getattr name_bind node_bind listen sendto accept write create connect)))
    (allow subj unreserved.netport (tcp_socket (ioctl read setopt bind getattr name_bind node_bind listen sendto name_connect)))
    (allow subj net.netnode (tcp_socket (ioctl read setopt bind getattr name_bind node_bind listen sendto)))
    (allow subj net.netnode (udp_socket (node_bind)))
    (allow subj wifi.subj (fd (use)))
    (allow subj wpad.subj (unix_dgram_socket (ioctl read setopt bind getattr listen sendto)))

    (allow subj .sys.subj (system (module_request)))
    (allow subj .sys.subj (fifo_file (unlink getattr read open map rename ioctl write create)))


    (allow subj wifi.datafile (file (getattr read open map rename execute )))
    (allow subj wifi.datafile (dir (search read open getattr)))
    (allow subj wifi.datafile (lnk_file (getattr read open map)))
    (allow subj wifi.datafile (fifo_file (getattr read open)))


    (allow subj version.procfile (file (getattr read open)))
    (allow subj version.procfile (dir (search read open getattr)))
    (allow subj version.procfile (lnk_file (getattr read open)))
    (allow subj version.procfile (fifo_file (getattr read open)))


    (allow subj wpad.runtimetmpfile (dir (search read open getattr)))
    (allow subj wpad.runtimetmpfile (file (getattr read open)))
    (allow subj wpad.runtimetmpfile (lnk_file (getattr read open map)))
    (allow subj wpad.runtimetmpfile (fifo_file (getattr read open)))
    (allow subj wpad.runtimetmpfile (sock_file (ioctl read getattr unlink setattr)))
    (allow subj wpad.tmpfile (file (read open)))


    (allow subj debug.fs (file (getattr read open)))
    (allow subj debug.fs (dir (search read open getattr)))
    (allow subj debug.fs (lnk_file (getattr read open map)))
    (allow subj debug.fs (fifo_file (getattr read open)))
    (allow subj debug.fs (sock_file (read getattr)))


    (allow subj qcmap_cli.tmpfile (file (getattr read open)))
    (allow subj qcmap_cli.subj (fifo_file (getattr read open map ioctl)))
    (allow subj qcmap_cli.tmpfile (dir (search read open getattr map)))
    (allow subj qcmap_cli.tmpfile (lnk_file (getattr read open)))
    (allow subj qcmap_cli.tmpfile (fifo_file (getattr read open map rename)))


    (allow subj uci.conffile (dir (search read open getattr)))
    (allow subj uci.conffile (file (getattr read open lock)))
    (allow subj uci.conffile (lnk_file (getattr read open map)))
    (allow subj uci.conffile (fifo_file (getattr read open)))
    (allow subj file.conffile (file (create append open ioctl read)))
    (allow subj file.conffile (dir (write add_name)))

    ;; R3 Service Prioritization specific
    (allow .uci.subj ezmesh.conffile (file (read)))
    (allow .uci.subj .tmp.fs (file (read)))

    (allow subj uci.tmpfile (dir (search read open getattr)))
    (allow subj uci.tmpfile (file (getattr read open lock)))
    (allow subj uci.tmpfile (lnk_file (getattr read open map)))
    (allow subj uci.tmpfile (fifo_file (getattr read open)))
    (allow subj uci.statetmpfile (file (getattr read open lock)))


    (allow subj class.sysfile (file (getattr read open)))
    (allow subj class.sysfile (dir (search read open getattr)))
    (allow subj class.sysfile (lnk_file (getattr read open map)))
    (allow subj class.sysfile (fifo_file (getattr read open)))


    (allow subj devices.sysfile (file (getattr read open)))
    (allow subj devices.sysfile (dir (search read open getattr)))
    (allow subj devices.sysfile (lnk_file (getattr read open)))
    (allow subj devices.sysfile (fifo_file (getattr read open)))


    (allow subj ezmesh.runtimetmpfile (dir (search read open getattr)))
    (allow subj ezmesh.runtimetmpfile (file (getattr read open)))
    (allow subj ezmesh.runtimetmpfile (lnk_file (getattr read open)))
    (allow subj ezmesh.runtimetmpfile (fifo_file (getattr read open unlink create write)))
    (allow subj ezmesh.runtimetmpfile (sock_file (read getattr setattr create write unlink)))

    ;; UCI subject transition
    (call .uci.subj_type_transition (subj))
    (allow .uci.subj .wpad.subj (fd (use)))

    (allow subj uci.execfile (dir (search read open getattr)))
    (allow subj uci.execfile (file (getattr read open execute map)))
    (allow subj uci.execfile (lnk_file (getattr read open)))
    (allow subj uci.execfile (fifo_file (getattr read open)))


    (allow subj tmpfile.statetmpfile (dir (search read open getattr)))
    (allow subj tmpfile.statetmpfile (file (getattr read open map)))
    (allow subj tmpfile.statetmpfile (lnk_file (getattr read open map)))
    (allow subj tmpfile.statetmpfile (fifo_file (getattr read open)))
    (allow subj tmp.fs (file (getattr read open create write ioctl append)))

    (allow subj selinux.fs(filesystem (getattr)))
    (allow subj selinux.conffile(dir (search)))
    (allow subj hotplugcall.subj (fd (use)))
    (allow subj hotplugcall.subj (fifo_file ( write ioctl )))

    ;; R3 DPP-Ubus Key
    (allow subj .ubusd.subj (unix_stream_socket (connectto)))
    (allow subj .ubusd.runtimetmpfile (dir (search)))
    (allow subj .ubusd.runtimetmpfile (sock_file (write)))

    ;; To insmod/rmmod
    (call .kmodloader.subj_type_transition (subj))

    ;; Need permission for hyfi-bridge communication respect to ezmesh
    (allow subj self create_unix_dgram_socket)
    (allow subj self (unix_dgram_socket (write )))

    ;;emt telnet session, respect to ezmesh
    (allow subj .net.netif (netif (egress)))
    (allow subj .net.netnode (node (sendto)))

    (allow subj .unreserved.netport (udp_socket (name_bind)))
    (allow subj .qcmap_ref.subj (fd (use)))
    (allow subj .qcmap_ref.subj (fifo_file (read)))
    (allow subj .qcmap_ref.subj (unix_stream_socket (read write)))
    (allow subj .qcmap_ref.subj (netlink_route_socket (read write)))
    (allow subj .tmpfile.runtimetmpfile (dir (remove_name )))
    (allow subj .tmpfile.runtimetmpfile (file (read open lock)))
    (allow subj .sys.rootfile (dir (read open)))
    (allow subj .dev.ttydev (chr_file (lock)))

    ;; Sigma specific cases
    (allow subj wifi.subj (fifo_file (write ioctl)))
    (allow subj wifi.logtmpfile (file (read append)))
    (allow subj wifi.subj (tcp_socket (read write)))
    (allow subj wifi.subj (unix_dgram_socket (sendto)))
    (allow subj .net.procfile (lnk_file (read)))
    (allow subj .net.procfile (file (read)))
    (allow subj .tmpfile.runtimetmpfile (sock_file (write)))

    (call .sys.search_fs_dirs (subj))
    (call .shell.execute_execfile_files (subj))
    (call .ezmesh.search_conffile_dirs (subj))
    (call .ezmesh.manage_conffile_files (subj))
    (call .ezmesh.execute_execfile_files (subj))
    (call .logd.write_miscfile_sock_files (subj))
    (call .class.search_sysfile_dirs (subj))
    (call .class.read_sysfile_lnk_files (subj))
    (call .devices.search_sysfile_dirs (subj))
    (call .devices.read_sysfile_lnk_files (subj))
    (call .devices.read_sysfile_files (subj))
    (call .kernel.search_sysfile_dirs (subj))
    (call .random.read_nodedev_chr_files (subj))

    ;; Use 'sync' command
    (call .fs.search_sysfile_dirs (subj))
    (call .filesystems.read_procfile_files (subj))
    (call read_sysfile_dirs (subj))
    (call .block.read_sysfile_lnk_files (subj))
    (call .ezmesh.create_tmpfile_dirs (subj))
    (call .tmp.read_fs_blk_files (subj))
    (call .ezmesh.readwrite_tmpfile_dirs (subj))
    (call .ezmesh.create_tmpfile_sock_files (subj))
    (call .ezmesh.delete_tmpfile_sock_files (subj))

    (call .wpad.write_runtimetmpfile_sock_files (subj))
    (call .file.execute_execfile_files (subj))

    ;; Need to print on serial console if 'hyctl show is given'
    (call .dev.readwriteinherited_ttydev_chr_files (subj))

    ;; Execute hostapd/wpa_supplicant binaries
    (call .wpad.subj_type_transition (subj))

    ;; Access to /var/run/{hostapd,wpa_supplicant} ctrl ifaces
    (call .wpad.search_runtimetmpfile_dirs (subj))
    (call .wpad.read_runtimetmpfile_sock_files (subj))

    ;; Access module parameters
    (call .module.read_sysfile_files (subj))

    ;; Use /usr/local/lib/libqca_nl80211_wrapper.so
    (call .ezmesh.mapexecute_datafile_files (subj))

    ;; Use /usr/sbin/cfg80211tool
    (call .ezmesh.execute_execfile_files (subj))

    ;; Execute /usr/bin/jsonfilter
    (call .jsonfilter.mapexecute_execfile_files (subj))
    (call .jsonfilter.read_execfile_files (subj))

    ;; Manage /tmp and /var/run files owned by ezmesh
    (call .wifi.manage_tmpfile_files (subj))
    (call .wifi.manage_runtimetmpfile_files (subj))

    ;; To access /etc/capabilities/{*.json}
    (call capabilities.getattr_conffile_files (subj))
    (call capabilities.search_conffile_dirs (subj))

    ;; Allow to create tmp file when update WCNSS_qcom_cfg.ini
    (call .wpad.manage_miscfile_files (subj))
    (call .wpad.write_miscfile_dirs (subj))

    ;; Read /tmp/sysinfo/board_name
    (call .preinit.search_tmpfile_dirs (subj))
    (call .preinit.read_tmpfile_files (subj))

    ;; Use openssl to encrypt files
    (call .tmpfile.search_conftmpfile_dirs (subj))

    (call .file.read_conffile_lnk_files (subj))
    (call .ezmesh.manage_tmpfile_files (subj))
    (call .ezmesh.write_conffile_dirs (subj))
    (call .fs.search_sysfile_dirs (subj))
    (call .filesystems.read_procfile_files (subj))

    (call .unknown.search_miscfile_dirs (subj))

    ;; Read /proc/cmdline
    (call .cmdline.read_procfile_files (subj))

    ;;mv
    (allow .ezmesh.tmpfile .xattr.fs (filesystem (associate)))
)

