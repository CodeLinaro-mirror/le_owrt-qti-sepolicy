;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

;; Sepolicy rules for location daemon - xtra-daemon
(in .file
    ;; location exec files transition
    (call .loc_xtra_daemon.obj_type_transition_execfile (unconfined.subj_typeattr)))

;;#============= Xtra Daemon ==============
(block loc_xtra_daemon
    ;;
    ;; Contexts
    ;; --------
    (filecon "/usr/bin/xtra-daemon" file execfile_file_context)

    ;;
    ;; Macros
    ;; ------
    (macro obj_type_transition_execfile ((type ARG1))
          (call .file.execfile_obj_type_transition
                (ARG1 execfile file "xtra-daemon")))

    ;;
    ;; Policy
    ;; ------
    (blockinherit .agent.base_template)
    (blockinherit .file.exec.obj_macro_template)
    (blockinherit .loc_daemons_common.loc_daemons_common_template)

    ;; import common rules for location deamons
    (call loc_daemons_common_rules (subj))

    (call subj_type_transition (subj))

    ;; communicate with location daemons via unix dgram sockets
    (call .loc_hal_daemon.sendto_unix_dgram_sockets (subj))

    ;; read /etc/group
    (call .nameservice.read_miscfile_files (subj))

    ;; Need qipcrtr socket creations
    (allow subj  self  create_qipcrtr_socket)

    (allow subj loc_launcher.subj (unix_stream_socket (read write)))

    ;; read resolv.conf
    (call .resolv.read.subj_type (subj))

    (call .net.egress_netifs (subj))
    (call .net.recvfromsendto_netnodes (subj))

    (call .net.udp_bind_netnodes (subj))

    ;; Search system directory
    (call .unknown.search_miscfile_dirs(subj))

    ;; Create udp_socket
    (allow subj self create_udp_socket)

    ;; KPI node access
    (call .kpi_values.manage_sysfile_files (subj))

    ;; read urandom
    (call .random.read_nodedev_chr_files (subj))

    (call .loc_launcher.use_fds (subj))

    ;; read kernel sysfs
    (call .kernel.search_sysfile_dirs (subj))
    (allow subj  leprop.miscfile  (sock_file  (read write)))

)
