(in .sys
    (call .data_path_opt.subj_type_transition (subj)))

(in .file
    (call .data_path_opt.obj_type_transition_execfile (unconfined.subj_typeattr)))

(block data_path_opt
        ;;
        ;;

        (filecon
        "/usr/bin/data_path_opt"
        file
        execfile_file_context)

        ;;
        ;; Macros
        ;;
        (macro obj_type_transition_execfile ((type ARG1))
              (call .file.execfile_obj_type_transition
                        (ARG1 execfile file "data_path_opt")))

        ;;
        ;; Policy
        ;;

          (blockinherit .agent.base_template)
          (allow subj file.conffile (dir(search)))
          (allow subj sys.fs (dir (search)))
          (allow subj fs.sysfile (dir(search)))
          (allow subj selinux.fs (filesystem(getattr)))
          (allow subj selinux.conffile (dir(search)))
          (allow subj kmodloader.execfile (file(getattr execute read open map)))
          (allow subj sys.rootfile (dir(read open)))
          (allow subj kmsg.nodedev (chr_file(write open)))
          (call .kmodloader.subj_type_transition (subj))
          (allow kmodloader.subj data_path_opt.subj (fd(use)))
          (allow kmodloader.subj data_path_opt.subj (fifo_file(read write ioctl)))
          (call .shell.execute_execfile_files (subj))
          (allow subj file.modulesfile(dir(search getattr read open write)))
          (allow subj file.modulesfile (file (getattr)))
          (allow subj sys.ptydev(chr_file(read write)))
          (allow subj sys.sysctlfile(dir(search)))
          (allow subj net.sysctlfile(dir(search)))
          (call .net.write_sysctlfile_files(subj))
          (call .debug.search_sysctlfile_dirs(subj))
          (call .debug.write_sysctlfile_files(subj))

	;; Domain Transition to initscriptfile
	(call .file.execute_initscriptfile_files (subj))
	(allow subj file.initscriptfile (dir (search)))
	(allow subj file.initscriptfile (file (execute read open)))

	(allow subj rccommon.conffile (file (read open getattr)))

	(allow subj functions.miscfile (dir (search)))
	(allow subj functions.miscfile (file (read open getattr)))

	(allow subj netfilter.sysctlfile (dir (search)))
	(allow subj netfilter.sysctlfile (file (open write)))

	(allow subj module.sysfile (dir (search getattr)))

	(allow subj libubox.datafile (dir (search)))
	(allow subj libubox.datafile (file (read open)))

	(allow subj tmpfile.runtimetmpfile (dir (search)))
	(allow subj tmpfile.locktmpfile (dir (search write add_name)))
	(allow subj tmpfile.locktmpfile (file (open create)))

	(call .jshn.subj_type_transition (subj))
	(allow jshn.subj data_path_opt.subj (fd (use)))
	(allow jshn.subj data_path_opt.subj (fifo_file (read write ioctl)))
	(allow subj jshn.execfile (file (getattr execute read open map)))

	;; Domain Transition to uci execfile
	(call .uci.execute_execfile_files (subj))
	(allow subj .uci.execfile (file (getattr read execute open map)))
	(allow subj uci.conffile (dir (search)))
	(allow subj uci.conffile (file (read getattr open lock)))
	(allow subj uci.tmpfile (dir (search)))

	(call .ubus.subj_type_transition (subj))
	(allow ubus.subj data_path_opt.subj (fd (use)))
	(allow ubus.subj data_path_opt.subj (fifo_file(read)))

	(allow subj ubusd.runtimetmpfile (dir (search)))
	(allow subj ubusd.runtimetmpfile (sock_file (write)))

	(allow subj kernel.sysfile (dir (search)))

	(allow subj debug.fs (dir (search)))
	(allow subj debug.fs (file (write open)))
	(dontaudit subj self (capability (sys_admin)))
)
