(in .odhcpd

     ;;policy

     ;; Need creat for packet_socket
     (allow subj self create_packet_socket)
     (allow subj .odhcpd.subj (rawip_socket (read write)))

     ;; Permissions to write to pd_manager socket
     (call .sys.connectto_unix_stream_sockets(subj))
     (allow subj self create_unix_stream_stream_socket)
     (allow subj .qcmap_cm.subj (unix_stream_socket (connectto)))
     (allow subj .qcmap_cm.tmpfile (sock_file (write)))
     (allow subj .qcmap_cm.subj (packet_socket (read write)))
     (allow subj .qcmap_cm.subj (netlink_socket (read write)))

     ;;Dont audit rule for odhcpd
     (dontaudit subj odhcpd.subj (capability (dac_read_search sys_admin)))
)
