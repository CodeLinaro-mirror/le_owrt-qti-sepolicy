;; Sepolicy rules for location daemon - mlid
(in .sys
    (call .mlid.subj_type_transition (subj)))


(in .file
    ;; mlid exec files transition
    (call .mlid.obj_type_transition_execfile (unconfined.subj_typeattr))
    (call .mlid_mink_socket.obj_type_transition_nodedev (unconfined.subj_typeattr)))

(block mlid_mink_socket
    ;;
    ;;Contexts
    ;;
    (filecon
    "/dev/socket/mlid-service"
    dir
    nodedev_file_context)

    (filecon
    "/dev/socket/mlid-service/mlid"
    socket
    nodedev_file_context)

    (macro obj_type_transition_nodedev ((type ARG1))
        (call .tmp.fs_obj_type_transition
            (ARG1 nodedev dir "mlid-service"))
        (call .tmp.fs_obj_type_transition
            (ARG1 nodedev socket "mlid")))

    (macro manage_mlid_socket_files ((type ARG1))
        (call manage_nodedev_dirs (ARG1))
        (call manage_nodedev_sock_files (ARG1)))

    (blockinherit .dev.node.obj_template)
)

;;#============= Mink Lowi Interface Daemon ==============
(block mlid
    ;;
    ;; Contexts
    ;; --------
    (filecon "/usr/bin/mink_lowi_server" file execfile_file_context)

    ;;
    ;; Macros
    ;; ------

    (macro obj_type_transition_execfile ((type ARG1))
          (call .file.execfile_obj_type_transition
                (ARG1 execfile file "mink_lowi_server")))

    (macro manage_mlid_data_files ((type ARG1))
          (call manage_datafile_dirs (ARG1))
          (call manage_datafile_files (ARG1)))

    ;;
    ;; Policy
    ;; ------
    (blockinherit .agent.base_template)
    (blockinherit .file.exec.obj_macro_template)
    (blockinherit .file.data.obj_template)
    (blockinherit .loc_daemons_common.loc_daemons_common_template)

    (call .mlid_mink_socket.manage_mlid_socket_files (subj))
    (call loc_daemons_common_rules (subj))

    (allow subj self (unix_stream_socket (sendto listen accept)))
    (allow subj self create_unix_stream_socket)
    (allow subj self create_unix_dgram_socket)
    (call .mlid.write_unix_dgram_sockets(subj))
    (allow subj self (unix_dgram_socket (sendto)))

    (call .mlid.manage_mlid_data_files (subj))


    ;; communicate with lowi server via unix dgram sockets
    (call .loc_lowi_server.sendto_unix_dgram_sockets (subj))
    (call .loc_lowi_server.connectto_unix_stream_sockets (subj))

    ;; netlink_generic_socket
    (allow subj self create_netlink_generic_socket)

    ;; Create udp_socket
    (allow subj self create_udp_socket)

    (call .sys.sendto_unix_dgram_sockets (subj))
    (call .sys.connectto_unix_stream_sockets (subj))

    (call .loc_socket.manage_loc_socket_files (subj))

    (call .loc_launcher.sendto_unix_dgram_sockets (subj))
    (call .loc_hal_daemon.sendto_unix_dgram_sockets (subj))

    (allow subj loc_launcher.subj (unix_stream_socket (read write)))

    ;; connect to loc_launcher target stream
    (call .loc_launcher.connectto_unix_stream_sockets (subj))

    (call .loc_launcher.use_fds (subj))
)
