(in ucode

;;
;; Macros
;;

    (macro allow_search_read_getattr_cmd_perms ((type ARG1))
       (allow subj ARG1 (dir (search)))
       (allow subj ARG1 (file (open read getattr)))
       (allow subj ARG1 (lnk_file (read getattr)))
    )


;; policy
        (allow subj self (capability (dac_read_search net_admin net_raw sys_ptrace)))

        (call .xtables.subj_type_transition (subj))
        (allow subj .xtables.execfile ( file (read open execute map getattr)))

        (allow subj .ucode.subj (netlink_netfilter_socket (read create bind getattr write)))
        (allow subj .ucode.subj (rawip_socket (create getopt setopt)))

        (call .uci.subj_type_transition (subj))
        (allow subj .uci.execfile (file(read open execute map getattr)))

        ;; Need for conntrack
        (call .conntrack.read_execfile_files (subj))
        (call .conntrack.execute_execfile_files (subj))
        (call .conntrack.subj_type_transition (subj))

        (allow subj .qcmap_cm.conffile (dir (search)))
        (call .qcmap_cm.read_conffile_files (subj))

        (allow subj .qcmap_cli.subj (fd (use)))
        (allow subj .qcmap_cli.subj (fifo_file (read write)))
        (allow subj .qcmap_cli.subj (unix_stream_socket (read write)))

        (allow subj .netifd.miscfile (dir (search getattr read open)))

        ;; Need obj_type_transition for /etc/firewall.user.*
        (call .firewall.obj_type_transition_conffile_ext (subj))
        (call .firewall.read_conffile_files (subj))

        ;; Need read for /etc/firewall.user
        (call .file.read_conffile_files (subj))
        (allow subj .rcfirewall.subj (fd (use)))

        (allow subj .ethagent.subj (dir (search)))
        (allow subj .qtether.subj (dir (search)))

        (allow subj .sys.rootfile (dir (open read)))
        (allow subj .sys.fs (filesystem (getattr)))

        (allow subj .filesystems.procfile (file (read open)))
        (allow subj file.datafile (dir (read open)))
        (allow subj file.datafile (file (read)))

        (allow subj bus.sysfile (dir (search read open)))
        (allow subj class.sysfile (dir (read open)))
        (allow subj proc.fs (dir (read open)))
        (allow subj fs.procfile (dir (search)))
        (allow subj sys.subj readwriteinherited_fifo_file)

        (allow subj self create_unix_dgram_socket)
        (allow subj self create_netlink_generic_socket)
        (allow subj wifi.subj  (fd (use)))
        (allow subj wifi.subj  (fifo_file ( write read  )))
        (allow subj wifi.tmpfile (file (write)))
        (allow subj wifi.miscfile (file (open)))

        (allow ucode.subj  logd.miscfile write_sock_file)
        (allow ucode.subj  logd.subj (unix_dgram_socket (sendto)))

        (call .nameservice.read_miscfile_files (subj))

        (allow subj self create_netlink_route_socket)
        (allow ucode.subj file.execfile (file  (execute_no_trans)))
        (allow ucode.subj file.datafile (file  (open)))
        (allow ucode.subj file.conffile (dir  (create write remove_name rename)))
        (allow ucode.subj file.conffile (file  (create write rename unlink)))

        (call .validatedata.subj_type_transition (subj))
        (allow subj validatedata.execfile (file (open read execute map)))
        (allow subj locale.miscfile (file (open read getattr map)))

        (allow subj file.initscriptfile (dir (search)))
        (allow subj file.initscriptfile (file (open read getattr execute execute_no_trans)))

        (allow subj rcfirewall.initscriptfile (file (open read)))
        (allow subj rccommon.conffile (file (open read)))

        (allow subj functions.miscfile (file (open read getattr)))
        (allow subj devices.sysfile (file (open read write)))

        (allow subj tmpfile.runtimetmpfile (file (getattr)))
        (allow subj tmpfile.locktmpfile (dir (write add_name)))
        (allow subj .tmpfile.locktmpfile (file (open create)))

        (call .jshn.subj_type_transition (subj))
        (allow subj jshn.execfile (file (open read map execute)))
        (call .ubus.subj_type_transition (subj))
        (allow subj ubus.execfile (file (open read map execute)))

        (call .jsonfilter.subj_type_transition (subj))
        (allow subj jsonfilter.execfile (file (open read map execute)))

        (allow subj miniupnpd.datafile (file (open read)))

        (allow subj board.miscfile (file (unlink)))

        (call .fw3.subj_type_transition (subj))
        (allow subj fw3.execfile (file (open read map execute)))

        ;; Provide access to ucode

        (call allow_search_read_getattr_cmd_perms(afc.subj))
        (call allow_search_read_getattr_cmd_perms(bus.sysfile))
        (call allow_search_read_getattr_cmd_perms(jshn.subj))
        (call allow_search_read_getattr_cmd_perms(ubus.subj))
        (call allow_search_read_getattr_cmd_perms(tmpfile.locktmpfile))
        (call allow_search_read_getattr_cmd_perms(libubox.datafile))
        (call allow_search_read_getattr_cmd_perms(board.miscfile))
        (call allow_search_read_getattr_cmd_perms(functions.miscfile))
        (call allow_search_read_getattr_cmd_perms(bus.procfile))
        (call allow_search_read_getattr_cmd_perms(net.procfile))
        (call allow_search_read_getattr_cmd_perms(dynamicdebug.procfile))
        (call allow_search_read_getattr_cmd_perms(firmware.sysfile))
        (call allow_search_read_getattr_cmd_perms(irq.procfile))
        (call allow_search_read_getattr_cmd_perms(tty.procfile))
        (call allow_search_read_getattr_cmd_perms(sys.sysctlfile))
        (call allow_search_read_getattr_cmd_perms(sysvipc.procfile))
        (call allow_search_read_getattr_cmd_perms(driver.procfile))
        (call allow_search_read_getattr_cmd_perms(firmware.miscfile))
        (call allow_search_read_getattr_cmd_perms(wifi.miscfile))
        (call allow_search_read_getattr_cmd_perms(sys.subj))
        (call allow_search_read_getattr_cmd_perms(ubusd.subj))
        (call allow_search_read_getattr_cmd_perms(urngd.subj))
        (call allow_search_read_getattr_cmd_perms(tftp_server.subj))
        (call allow_search_read_getattr_cmd_perms(diag-router.subj))
        (call allow_search_read_getattr_cmd_perms(mbim.subj))
        (call allow_search_read_getattr_cmd_perms(qcmap_cm.subj))
        (call allow_search_read_getattr_cmd_perms(dnsmasq.subj))
        (call allow_search_read_getattr_cmd_perms(leprop.subj))
        (call allow_search_read_getattr_cmd_perms(ipacm.subj))
        (call allow_search_read_getattr_cmd_perms(ipacmdiag.subj))
        (call allow_search_read_getattr_cmd_perms(netifd.subj))
        (call allow_search_read_getattr_cmd_perms(rmt_storage.subj))
        (call allow_search_read_getattr_cmd_perms(rpcd.subj))
        (call allow_search_read_getattr_cmd_perms(logd.subj))
        (call allow_search_read_getattr_cmd_perms(fs-scrub-daemon.subj))
        (call allow_search_read_getattr_cmd_perms(diagrebootapp.subj))
        (call allow_search_read_getattr_cmd_perms(qmuxbridge.subj))
        (call allow_search_read_getattr_cmd_perms(dropbear.subj))
        (call allow_search_read_getattr_cmd_perms(ip.subj))
        (call allow_search_read_getattr_cmd_perms(fw3.subj))
        (call allow_search_read_getattr_cmd_perms(nftables.subj))
        (call allow_search_read_getattr_cmd_perms(netmgrd.subj))
        (call allow_search_read_getattr_cmd_perms(xtables.subj))
        (call allow_search_read_getattr_cmd_perms(uci.subj))
        (call allow_search_read_getattr_cmd_perms(kmodloader.subj))
        (call allow_search_read_getattr_cmd_perms(qcmap_cli.subj))
        (call allow_search_read_getattr_cmd_perms(tlpd.subj))
        (call allow_search_read_getattr_cmd_perms(loc_launcher.subj))
        (call allow_search_read_getattr_cmd_perms (ethagent.subj))
        (call allow_search_read_getattr_cmd_perms (loc_xtra_daemon.subj))
        (call allow_search_read_getattr_cmd_perms (loc_lowi_server.subj))
        (call allow_search_read_getattr_cmd_perms (loc_hal_daemon.subj))
        (call allow_search_read_getattr_cmd_perms (hotplugcall.subj))
        (call allow_search_read_getattr_cmd_perms (dlsc.subj))
        (call allow_search_read_getattr_cmd_perms (qwesd.subj))
        (call allow_search_read_getattr_cmd_perms (qseecomd.subj))
        (call allow_search_read_getattr_cmd_perms (uhttpd.subj))
        (call allow_search_read_getattr_cmd_perms (rcdnsmasq.subj))
        (call allow_search_read_getattr_cmd_perms (wpad.subj))
        (call allow_search_read_getattr_cmd_perms (odhcpd.subj))
        (call allow_search_read_getattr_cmd_perms (qcmap_ref.subj))
        (call allow_search_read_getattr_cmd_perms (dataadpl.subj))
        (call allow_search_read_getattr_cmd_perms (qtether.subj))
        (call allow_search_read_getattr_cmd_perms (atfwd.subj))
        (call allow_search_read_getattr_cmd_perms (port-bridge.subj))
        (call allow_search_read_getattr_cmd_perms (odhcp6c.subj))
        (call allow_search_read_getattr_cmd_perms (qcril.subj))
        (call allow_search_read_getattr_cmd_perms (msdc.subj))
        (call allow_search_read_getattr_cmd_perms (perf-hal-service.subj))
        (call allow_search_read_getattr_cmd_perms (mlid.subj))
        (call allow_search_read_getattr_cmd_perms (stmfd.subj))
        (call allow_search_read_getattr_cmd_perms (qms.subj))
        (call allow_search_read_getattr_cmd_perms (emergencyalert.subj))
        (call allow_search_read_getattr_cmd_perms (logread.subj))
        (call allow_search_read_getattr_cmd_perms (ipcalc.subj))
        (call allow_search_read_getattr_cmd_perms (rcucitrack.subj))
        (call allow_search_read_getattr_cmd_perms (health_monitor.subj))
        (call allow_search_read_getattr_cmd_perms (ifstatus.subj))
        (call allow_search_read_getattr_cmd_perms (rccron.subj))
        (call allow_search_read_getattr_cmd_perms (jsonfilter.subj))
        (call allow_search_read_getattr_cmd_perms (rcsysntpd.subj))
        (call allow_search_read_getattr_cmd_perms (ezmesh.subj))
        (call allow_search_read_getattr_cmd_perms (qbt.subj))
        (call allow_search_read_getattr_cmd_perms (rcodhcpd.subj))
        (call allow_search_read_getattr_cmd_perms (rcdropbear.subj))
        (call allow_search_read_getattr_cmd_perms (rcgpioswitch.subj))
        (call allow_search_read_getattr_cmd_perms (mka_supplicant.subj))
        (call allow_search_read_getattr_cmd_perms (mka_authenticator.subj))
        (call allow_search_read_getattr_cmd_perms (ssgtzd.subj))
        (call allow_search_read_getattr_cmd_perms (wifi.subj))
        (call allow_search_read_getattr_cmd_perms (rcfirewall.subj))
        (call allow_search_read_getattr_cmd_perms (tcpdump.subj))
        (call allow_search_read_getattr_cmd_perms (iw.subj))

        ;;STC
        (call .file.read_datafile_files (subj))
        (call .file.manage_conffile_files (subj))
	(call allow_search_read_getattr_cmd_perms (loc_xtwifi_client.subj))
	(call allow_search_read_getattr_cmd_perms (ipacli.subj))
 	(call allow_search_read_getattr_cmd_perms (ifli.subj))
	(call allow_search_read_getattr_cmd_perms (aios_daemon.subj))
	(call allow_search_read_getattr_cmd_perms (data_path_opt.subj))

        (dontaudit subj self (capability (sys_admin)))
)
