(in .rcdropbear

(block rcdropbeartmp

	;; policy
	(blockinherit .agent.base_template))

	(allow subj self (capability (chown dac_override fowner dac_read_search fsetid )))

	(allow subj file.conffile (dir (setattr)))

	(call .uci.search_conffile_dirs (subj))
	(call .uci.read_conffile_files (subj))
	(call .uci.search_tmpfile_dirs (subj))

	(allow subj locale.miscfile (file (open read getattr map)))

	(dontaudit subj self (capability (sys_admin)))
)
