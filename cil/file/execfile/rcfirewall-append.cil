(in .rcfirewall

(block rcfirewalltmp

       ;; policy

       (blockinherit .agent.base_template))
       (call .random.read_nodedev_chr_files (subj))
       (call .sys.search_sysctlfile_dirs (subj))
       (call .ipv4.search_sysctlfile_dirs (subj))
       (call .ipv4.write_sysctlfile_files (subj))
       (call .ipv6.search_sysctlfile_dirs (subj))
       (call .ipv6.write_sysctlfile_files (subj))
       (allow subj self (capability (dac_read_search)))
       (call .xtables.subj_type_transition (subj))
       (call .qcmap_cli.use_fds (subj))
       (call .qcmap_cli.readwrite_unix_stream_sockets (subj))
       (allow .rcfirewall.subj .qcmap_cli.subj (fifo_file (read write ioctl)))
       (call .qcmap_ref.use_fds (subj))
       (call .qcmap_ref.readwrite_unix_stream_sockets (subj))
       (allow .rcfirewall.subj .qcmap_ref.subj (fifo_file (read write ioctl)))
       (call .odhcp6c.use_fds (subj))
       (call .odhcp6c.readwrite_unix_stream_sockets (subj))
       (allow .rcfirewall.subj .odhcp6c.subj (fifo_file (read write ioctl)))
       (call .netifd.use_fds (subj))
       (call .netifd.readwrite_unix_stream_sockets (subj))
       (allow .rcfirewall.subj .netifd.subj (fifo_file (read write ioctl)))
       (call .mnt.search_miscfile_dirs (subj))
       (allow subj .kernel.sysfile (dir (search)))
       (allow subj qcmap_ref.subj (netlink_route_socket (read write)))
       ;;open/write pmsg_dev.nodedev
       (allow subj .pmsg_dev.nodedev (chr_file (write open)))
       (allow subj netifd.miscfile (dir (search getattr)))
       ;; Need for pppd
       (allow subj .pppd.subj (fd (use)))
       (dontaudit subj rcfirewall.subj (capability (sys_admin)))

)
