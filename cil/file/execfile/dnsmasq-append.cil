(in .dnsmasq

  ;; Need this to label dnsmasq.conf.* file.
  ;; This is temporary workaround to label file when /tmp/etc is coming in tmp.fs(default context)
  ;; When /tmp/etc dir comes with unique context(proper context)
  ;; relabelling doesn't takes place as it is not needed.
  (filecon
     "/tmp/etc/*"
     file
     conftmpfile_file_context)

  (macro obj_type_transition_conftmpfile_2 ((type ARG1)(class ARG2)(name ARG3))
      (call .tmp.fs_obj_type_transition
         (ARG1 conftmpfile ARG2 ARG3)))

;; policy

(allow subj self (capability (dac_read_search)))
(call .netifd.use_fds (subj))
(allow subj .netifd.subj (fifo_file (read write)))
(allow subj .netifd.subj (netlink_route_socket (read write)))
(allow subj .netifd.subj (netlink_kobject_uevent_socket (read write)))
(call .qcmap_cli.use_fds (subj))
(call .qcmap_cli.readwrite_unix_stream_sockets (subj))
(allow subj .qcmap_cli.subj (fifo_file (read write)))
;; Need open read append getattr on /tmp/data/dhcp.leases
(call .qcmap_cm.manage_tmpfile_files (subj))
(call .qcmap_cm.search_tmpfile_dirs (subj))
(call .dnsmasq.read_conftmpfile_files (subj))
(call .dnsmasq.search_conftmpfile_dirs (subj))
;; Need name connect on tcp socket
(allow subj .dns.netport (tcp_socket (name_connect)))
(call .qcmap_ref.use_fds (subj))
(call .qcmap_ref.readwrite_unix_stream_sockets (subj))
(allow subj .qcmap_ref.subj (fifo_file (read write)))
(call .shell.mapexecute_execfile_files(subj))
(call .shell.read_execfile_files(subj))
(call .fs.search_sysfile_dirs (subj))
(call .sys.search_fs_dirs (subj))
(call .selinux.search_conffile_dirs(subj))
(call .selinux.getattr_filesystems(subj))
(call .libubox.manage_datafile_dirs (subj))
(call .libubox.read_datafile_files (subj))
(call .qcmap_cm.search_conffile_dirs (subj))

;; for DHCP_SCRIPT.sh and dnsmasq_script.sh
(call .shell.manage_execfile_files (subj))
(call .libubox.search_datafile_dirs (subj))
(allow subj qcmap_cm.conffile (file(getattr)))
(allow subj .ubus.execfile (file (getattr)))
(call .qcmap_cm.manage_conffile_files (subj))
(call .qcmap_cm.execute_conffile_files (subj))
(call .qcmap_cm.write_tmpfile_dirs (subj))
(allow subj .jshn.execfile (file(getattr)))
(call .ubus.execute_execfile_files (subj))
(allow subj .ip.execfile (file(getattr)))
(call .kernel.search_sysfile_dirs (subj))
(call .kmsg.write_nodedev_chr_files (subj))
(call .jshn.execute_execfile_files (subj))
(call .ip.execute_execfile_files (subj))
(call .kpi_values.append_sysfile_files(subj))
)



