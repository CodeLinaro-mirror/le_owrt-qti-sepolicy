(in .tcpdump

    (call .class.read_sysfile_lnk_files (subj))
    ;; Need create write to collect dumps in /tmp/data dir
    (call .qcmap_cm.write_tmpfile_dirs (subj))
    (call .qcmap_cm.search_tmpfile_dirs (subj))
    (call .qcmap_cm.create_tmpfile_files (subj))
    (call .qcmap_cm.write_tmpfile_files (subj))
    ;; Need permission to collect tcpdumps in /data/ dir
    (call .file.write_datafile_dirs (subj))
    (call .file.search_datafile_dirs (subj))
    (call .file.create_datafile_files (subj))
    (call .file.write_datafile_files (subj))
    (allow subj self (capability (net_admin)))
    ;; sys_module capability can't be given
    (dontaudit subj self (capability (sys_module)))
    ;; Need permission for tcpdump
    (allow subj .sys.subj (system (module_request)))
)
