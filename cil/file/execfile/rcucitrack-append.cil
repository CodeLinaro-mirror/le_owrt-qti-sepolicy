(in .rcucitrack

(block rcucitracktmp

       ;; policy

       (blockinherit .agent.base_template))
         (allow subj self (capability (dac_override dac_read_search)))
         (allow subj nftables.execfile (file(getattr)))

         (allow subj file.datafile (dir (open read)))
         (allow subj file.datafile (file (getattr)))

    (dontaudit subj self (capability (sys_admin)))
)
