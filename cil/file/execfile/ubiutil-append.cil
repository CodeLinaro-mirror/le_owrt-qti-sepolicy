(in .ubiutil

;; policy

	(call .file.writeinherited_all_fifo_files(subj))
	;; Need write on /dev/kmsg chr_file
	(call .kmsg.readwrite_nodedev_chr_files (subj))
	(dontaudit subj .sys.subj (fifo_file (write)))


)

