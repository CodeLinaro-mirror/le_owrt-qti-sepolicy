;; These is upstream domain for rcfiles related to wpad


(in .rcwpad
    ;;
    ;; Contexts
    ;;

    ;;
    ;; Macros
    ;;

    ;;
    ;;Policy
    ;;
    (allow subj .qcmap_cli.subj (fd (use)))
    (allow subj .qcmap_cli.subj (fifo_file (read write)))
    (allow subj .qcmap_cli.subj (unix_stream_socket (read write)))
    (allow subj .wifi.subj (fd (use)))
    (allow subj .kmsg.nodedev (chr_file (open write)))

    ;; Need read on /data/vendor/wifi/{hostapd-wlanX.* wpa_supplicant-wlanX.*}
    (call .wifi.read_datafile_files (subj))
    (call .wifi.search_datafile_dirs (subj))

    ;; Need search on /sys/class/net
    (call .class.search_sysfile_dirs (subj))
    ;; Need search on /etc/init.d                                                                                                                                           |
    (allow subj .file.initscriptfile (dir (search)))


    (allow subj .qcmap_ref.subj (fd (use)))
    (allow subj .qcmap_ref.subj (fifo_file (read write)))
    (allow subj .qcmap_ref.subj (unix_stream_socket (read write)))
)
