;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

(in .file
 ;;   (call .shell.obj_type_transition_execfile (unconfined.subj_typeattr))


       ;;
       ;; Contexts
       ;;


	(filecon
        "/sbin"
        file
        execfile_file_context)

	(filecon
        "/sbin/*"
        any
        execfile_file_context)

	(filecon
	"/usr/sbin"
	 file
	 execfile_file_context)

	(filecon
	"/data"
     	dir
     	datafile_file_context)

	(filecon
	"/data/.*"
     	any
     	datafile_file_context)
	   
	)
