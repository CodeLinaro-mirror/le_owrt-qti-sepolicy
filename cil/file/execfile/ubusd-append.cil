(in .ubusd

;; allow ubusd to read, open conf file
;; during run of mdns avahi-nodbus-daemon

(allow subj .file.conffile (file (read open)))
(allow subj .file.datafile (file (read)))
(allow subj .kmsg.nodedev (chr_file (read write)))
(allow subj .logd.miscfile (sock_file (write)))

(dontaudit subj self (capability (sys_admin)))

(block ubusdtmp

       ;; policy

       (blockinherit .agent.base_template))
         (allow subj self (capability (dac_read_search)))
)
