(in .rcboot

;; policy

    (allow subj .tmpfile.locktmpfile (dir (setattr)))
    (allow subj self (capability (dac_override dac_read_search fowner)))
    (call .rcuhttpd.execute_initscriptfile_files (subj))
     (call .kmsg.readwrite_nodedev_chr_files (subj))
     (call .modules.read_procfile_files (subj))
     (call .tmpfile.manage_locktmpfile_files (subj))
     (call .tmpfile.create_logtmpfile_dirs (subj))
     (allow subj .openssl.execfile (file (getattr)))
     (call .openssl.execute_execfile_files(subj))
     (call .ssl.search_certfile_dirs(subj))

    (allow subj .nameservice.miscfile (file (append)))
    (call .uci.manage_conffile_files (subj))
    (allow subj uci.conffile (dir( remove_name )))

    (allow subj tmp.fs (file (create open read write getattr unlink)))
    (allow subj tmp.fs (dir (remove_name)))
    (allow subj uci.defaults.conffile (dir (create add_name setattr rename reparent)))
    (allow subj file.conffile (chr_file (create link rename)))

    (allow subj dropbear.certfile (dir (search)))
)


