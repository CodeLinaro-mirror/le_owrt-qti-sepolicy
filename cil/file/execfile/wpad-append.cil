(in .file
    (call .wpad.obj_type_transition_tmpfile_logs (unconfined.subj_typeattr))
    (call .wpad.obj_type_transition_miscfile (unconfined.subj_typeattr dir "wifi"))
    (call .wpad.obj_type_transition_execfile_ext (unconfined.subj_typeattr))
)

(in .wpad
    ;;
    ;; Contexts
    ;;
    (filecon "/usr/bin/hostapd_cli" file execfile_file_context)
    (filecon "/usr/bin/wpa_supplicant" file execfile_file_context)
    (filecon "/usr/bin/wpa_cli" file execfile_file_context)
    (filecon "/etc/misc/wifi/.*" any miscfile_file_context)
    (filecon "/etc/misc/wifi" dir miscfile_file_context)
    (filecon "/tmp/hostapd-wlan[0-9]+\.log" file tmpfile_file_context)
    (filecon "/tmp/wpa_supplicant-wlan[0-9]+\.log" file tmpfile_file_context)

    ;;
    ;; Macros
    ;;
    (macro obj_type_transition_tmpfile_logs ((type ARG1))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "hostapd-wlan0.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "hostapd-wlan1.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "hostapd-wlan2.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "hostapd-wlan3.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "hostapd-wlan4.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "hostapd-wlan5.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "wpa_supplicant-wlan0.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "wpa_supplicant-wlan1.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "wpa_supplicant-wlan2.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "wpa_supplicant-wlan3.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "wpa_supplicant-wlan4.log"))
        (call .wpad.obj_type_transition_tmpfile (ARG1 file "wpa_supplicant-wlan5.log"))
    )

    (macro obj_type_transition_execfile_ext ((type ARG1))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "wpa_supplicant"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "wpa_cli"))
        (call .file.execfile_obj_type_transition (ARG1 execfile file "hostapd_cli"))
    )

    (macro obj_type_transition_miscfile ((type ARG1) (class ARG2) (name ARG3))
        (call .sys.rootfile_obj_type_transition (ARG1 miscfile ARG2 ARG3)))

    ;;
    ;; Policy
    ;;
    (blockinherit .file.misc.obj_template)
    (call obj_type_transition_tmpfile_logs (subj))
    (call obj_type_transition_miscfile (subj dir "wifi"))
    (call obj_type_transition_execfile_ext (subj))

    (allow subj .qcmap_cli.subj (fd (use)))
    (allow subj .qcmap_cli.subj (fifo_file (read write ioctl)))
    (allow subj .qcmap_cli.subj (unix_stream_socket (read write)))
    (allow subj .sys.subj (fifo_file (write)))
    (allow subj .tmp.fs (dir (remove_name)))

    (allow subj self create_qipcrtr_socket)

    ;; Need create append open ioctl on /tmp/{hostapd-wlanX.log wpa_supplicant-wlanX.log}
    (call .wpad.manage_tmpfile_files (subj))
    ;; Need read open on /tmp/run/{hostapd-wlanX.* wpa_supplicant-wlanX.*}
    (call .wifi.read_runtimetmpfile_files (subj))
    ;; Need read on sysfile phy80211
    (allow subj .devices.sysfile (lnk_file (read)))

    ;; Need to print on adb shell, such as hostapd_cli/wpa_cli
    (call .sys.readwriteinherited_ptydev_chr_files (subj))
)
