;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

(in .sys
    (call .qseecomd.subj_type_transition (subj)))

(block qseecomd
        ;;
        ;; Contexts
        ;;
        (filecon
            "/usr/bin/qseecomd"
            file
            execfile_file_context)
        ;;
        ;; Macros
        ;;
        (macro obj_type_transition_execfile ((type ARG1))
              (call .file.execfile_obj_type_transition
                          (ARG1 execfile file "qseecomd")))
        ;;
        ;;Policy
        ;;
        (blockinherit .agent.base_template)


;;needed for commuication on /dev/smcinvoke
        (call .smcinvoke.readwrite_nodedev_chr_files (subj))

;;needed for searching /etc
        (call .file.search_conffile_dirs (subj))

;;needed for reading of /proc/cmdline
        (call .cmdline.read_procfile_files (subj))


;;need for creating and read/write to unix_dgram_socket
        (allow subj self create_unix_dgram_socket)


;;access on /dev/log
       (call .logd.write_miscfile_sock_files(subj))
       (call .logd.sendto_unix_dgram_sockets(subj))

;;rpmb is raw partition on storage device, need
;;read write access to perform rpmb ops
;;access on /dev/mmcblk0rpmb
       (call .dev.stor.readwrite.subj_type(subj))

;;need to access  /dev/dma_heap/....
       (call .dma_heap.readwrite_nodedev_chr_files (subj))

       (allow  qseecomd.subj  dma_heap.nodedev  (dir (search)))
       (allow  qseecomd.subj.  file.conffile ( file (getattr read open)))
       (allow qseecomd.subj. persist.miscfile (dir (search read write open add_name create remove_name)))
       (allow qseecomd.subj. persist.miscfile (file (create read write open getattr unlink rename)))
       (allow qseecomd.subj. qseecomd.subj (unix_stream_socket (create connect write read)))
       (allow qseecomd.subj. leprop.miscfile (sock_file (write)))
       (allow qseecomd.subj. leprop.subj (unix_stream_socket (connectto)))
       (allow  qseecomd.subj.  file.datafile ( dir (read write open add_name create remove_name rmdir)))
       (allow  qseecomd.subj.  file.datafile ( file (create read write open getattr unlink)))
       (allow qseecomd.subj. mmc.stordev (chr_file (getattr open read write ioctl)))
       (allow qseecomd.subj. devices.sysfile (file (getattr read write open)))
       (allow qseecomd.subj. sys.fs (dir (search)))
       (allow qseecomd.subj. power.sysfile (dir (search append)))
       (allow qseecomd.subj. power.sysfile (file (open append)))
       (allow qseecomd.subj. devices.sysfile (dir (search)))
       (allow qseecomd.subj. devices.sysfile (lnk_file (read)))
       (allow qseecomd.subj. block.sysfile (dir (search)))
       (allow qseecomd.subj. block.sysfile (lnk_file (read)))

;;don't audit shell cmds denials
       (dontaudit qseecomd.subj shell.execfile (file (execute)))

)

