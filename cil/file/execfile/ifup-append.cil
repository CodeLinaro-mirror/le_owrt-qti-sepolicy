(in .ifup

  ;;policy

  (call .qcmap_cli.use_fds (subj))
  (call .netifd.use_fds (subj))
  (allow subj self (capability (dac_read_search)))
  (call .qcmap_cli.readwrite_unix_stream_sockets (subj))
  (allow .ifup.subj .qcmap_cli.subj (fifo_file (read write ioctl)))
  (allow .ifup.subj .netifd.subj (fifo_file (read write)))
  (allow .ifup.subj .netifd.subj (netlink_route_socket (read write)))
  (allow .ifup.subj .netifd.subj (netlink_kobject_uevent_socket (read write)))
  (call .netifd.manage_miscfile_dirs (subj))
  (allow .ifup.subj .qcmap_cli.subj (fifo_file (read write)))
  (allow .ifup.subj .qcmap_cli.subj (netlink_route_socket (read write)))
  (allow .ifup.subj .qcmap_cli.subj (netlink_kobject_uevent_socket (read write)))
  (allow .ifup.subj .qcmap_ref.subj (netlink_route_socket (read write)))
  ;;open/write pmsg_dev.nodedev
  (allow subj .pmsg_dev.nodedev (chr_file (write open)))
  ;; Sigma specific for ezmesh
  (allow .ifup.subj wifi.subj (fd (use)))
  (allow .ifup.subj wifi.logtmpfile (file (read append)))
  (allow .ifup.subj wifi.subj (tcp_socket (read write)))
)
