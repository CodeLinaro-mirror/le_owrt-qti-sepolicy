(in .jsonfilter
     ;;policy
     (call .qcmap_cli.use_fds (subj))
     (call .qcmap_cli.readwrite_unix_stream_sockets (subj))
     (allow subj .qcmap_cli.subj (fifo_file (read write)))
     (call .fw3.write_runtimetmpfile_files (subj))
)
