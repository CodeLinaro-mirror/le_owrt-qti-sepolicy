(in .rcnetwork

(block rcnetworktmp

       ;; policy

       (blockinherit .agent.base_template))
         (allow subj self (capability (dac_read_search dac_override)))
         (call .qcmap_cli.use_fds (subj))
         (call .qcmap_cli.readwrite_unix_stream_sockets (subj))
         (allow .rcnetwork.subj .qcmap_cli.subj (fifo_file (read write ioctl)))
         (call .qcmap_cm.search_tmpfile_dirs (subj))
         (allow subj .qcmap_cm.tmpfile (dir (getattr)))
         (allow subj .uci.conffile (dir (search)))

       ;;
       (allow .iw.subj .rcnetwork.subj (fd (use)))
       ;; Need execute permission for wifi
       (call .wifi.execute_execfile_files (subj))
)
