;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

(in .sys
    (call .hal_rec_test.subj_type_transition (subj))
    (call .hal_play_test.subj_type_transition (subj)))

(in .file
    (call .hal_rec_test.obj_type_transition_execfile (unconfined.subj_typeattr))
    (call .hal_play_test.obj_type_transition_execfile (unconfined.subj_typeattr)))


(block hal_rec_test
    ;;
    ;; Contexts
    ;;
    (filecon
        "/usr/bin/hal_rec_test"
        file
        execfile_file_context)

    ;;
    ;; Macros
    ;;
        (macro obj_type_transition_execfile ((type ARG1))
            (call .file.execfile_obj_type_transition
                (ARG1 execfile file "hal_rec_test")))

        (macro audio_hal_device_access ((type ARG1))
              (allow subj nodedev readwrite_chr_file))


    ;;
    ;; Policy
        ;;
        (blockinherit .agent.base_template)

    ;; search in config files is needed
    ;;which is done on start /Stop  of services
       (call .file.search_conffile_dirs (subj))

    ;; Need qipcrtr socket creations
       (allow subj  self  create_qipcrtr_socket)

    ;; Needed for  unix_dgram socket creation
       (allow subj self create_unix_dgram_socket)

    ;;Needed for creating of unix stream socket
       (allow subj self create_unix_stream_stream_socket)

    ;; Need creat and read of this uevent socket
       (allow subj self create_netlink_kobject_uevent_socket)

    ;;need for /dev/logd or logging
    ;; this will add write permission also
       (call .logd.unix_dgram_send(subj))
    ;; search  /dev tree .
    (call .devices.search_sysfile_dirs (subj))

    ;;(blockinherit .file.exec.obj_template)

    ;;(call .dev.readwriteinherited_csddev_chr_files (subj))
    (call .fs.write_sysfile_dirs (subj))
    ;;  (call .fs.search_tracefile_dirs (subj))

    (call .shell.execute_execfile_files (subj))

    ;;search sysfs files
    (call .sys.search_fs_dirs (subj))

    ;;getattr selinuxfs files
    (call .selinux.getattr_filesystems (subj))

    ;;search selinux conffile
    (call .selinux.search_conffile_dirs (subj))

    ;;search power sysfile
    (call .power.search_sysfile_dirs (subj))

    ;;write/open power sysfile
    (allow subj power.sysfile ( file ( write open)))

    ;;self block_suspend
    (allow subj self (capability2(block_suspend)))

    ;;read conffile
    (call .file.read_conffile_files (subj))

     ;;search snd dev node dir
    (call .snd.search_nodedev_dirs (subj))

     ;;read proc fs files
    (call .proc.read_fs_files (subj))

     ;;read/write/map snd chr files
    (call .snd.readwrite_nodedev_chr_files (subj))
    (call .snd.mapexecute_nodedev_chr_files (subj))

    ;;read conffile dir
    (call .file.readwrite_conffile_dirs (subj))

    ;;read dma_heap node chr files
    (call .dma_heap.read_nodedev_chr_files (subj))

     ;;read dma_heap node dir
    (call .dma_heap.search_nodedev_dirs (subj))

     ;; data files read/write/create
    (call .file.read_datafile_lnk_files (subj))
    (call .file.write_datafile_dirs (subj))
    (call .file.create_datafile_files (subj))
    (call .file.write_datafile_files(subj))

     ;;search/write kernel sysfile dir
    (call .kernel.search_sysfile_dirs (subj))
    (call .kernel.write_sysfile (subj))

    ;;connect to leprop socket
    (call .leprop.connectto_unix_stream_sockets (subj))

     ;;write leprop sock files
    (call .leprop.write_miscfile_sock_files (subj))

    ;;open pmsg_dev.nodedev
    (allow subj pmsg_dev.nodedev (chr_file (write open)))

     ;;read/write sys chr files
    (call .sys.readwriteinherited_ptydev_chr_files (subj))

    ;;read/open proc fs dir
    (allow subj proc.fs (dir (read open)))

    ;;connectto diag-router unix_stream_socket
    (call .diag-router.connectto_unix_stream_sockets (subj))

    ;;read/open/search debug fs dir
    (allow subj debug.fs (dir (read open search)))

    (allow subj .invalid (dir (search)))
    (allow subj .invalid (chr_file (ioctl read write open map)))
    (allow subj  .sys.subj (binder (call transfer)))

)

(block hal_play_test
    ;;
    ;; Contexts
    ;;

    (filecon
        "/usr/bin/hal_play_test"
        file
        execfile_file_context)

    ;;
    ;; Macros
    ;;
        (macro obj_type_transition_execfile ((type ARG1))
            (call .file.execfile_obj_type_transition
                (ARG1 execfile file "hal_play_test")))

    ;;
    ;; Policy
        ;;
        (blockinherit .agent.base_template)

    ;; search in config files is needed
    ;;which is done on start /Stop  of services
       (call .file.search_conffile_dirs (subj))

    ;; Need qipcrtr socket creations
       (allow subj  self  create_qipcrtr_socket)

    ;; Needed for  unix_dgram socket creation
       (allow subj self create_unix_dgram_socket)

    ;;Needed for creating of unix stream socket
       (allow subj self create_unix_stream_stream_socket)

    ;; Need creat and read of this uevent socket
       (allow subj self create_netlink_kobject_uevent_socket)

    ;;need for /dev/logd or logging
    ;; this will add write permission also
       (call .logd.unix_dgram_send(subj))
    ;; search  /dev tree .
    (call .devices.search_sysfile_dirs (subj))

    ;;(blockinherit .file.exec.obj_template)

    ;;(call .dev.readwriteinherited_csddev_chr_files (subj))
    (call .fs.write_sysfile_dirs (subj))
    ;;  (call .fs.search_tracefile_dirs (subj))

    (call .shell.execute_execfile_files (subj))
    ;;search sysfs files
    (call .sys.search_fs_dirs (subj))

    ;;getattr selinuxfs files
    (call .selinux.getattr_filesystems (subj))

    ;;search selinux conffile
    (call .selinux.search_conffile_dirs (subj))

    ;;search power sysfile
    (call .power.search_sysfile_dirs (subj))

    ;;write power sysfile
    (call .power.write_sysfile_files (subj))

    ;;write/open power sysfile
    (allow subj power.sysfile ( file ( write open)))

    ;;self block_suspend
    (allow subj self (capability2(block_suspend)))

    ;;read conffile
    (call .file.read_conffile_files (subj))

    ;;read/open procfs
    (allow subj proc.fs (dir (read open)))

    ;;read/open/search debugfs
    (allow subj debug.fs (dir (read open search)))

    ;;connectto diag-router unix_stream_socket
    (call .diag-router.connectto_unix_stream_sockets (subj))

    ;;open nodedev
    (allow subj dma_heap.nodedev (chr_file (open)))

    ;; manage tmp/proc file
    (allow subj proc.fs (file (open read)))

    (call .file.readwrite_conffile_dirs(subj))

    ;; search/read dma_heap nodedev dir/files
    (call .dma_heap.search_nodedev_dirs(subj))
    (call .dma_heap.read_nodedev_chr_files(subj))

    ;;open sysfile
    (allow subj power.sysfile (file (open)))

    ;;open conffile
    (allow subj file.conffile (file (open)))

    ;;connect/search/read-write socket/dir/file
    (call .sys.search_fs_dirs(subj))
    (call .sys.readwriteinherited_ptydev_chr_files (subj))

    ;;search/getattr selinux file/dir
    (call .selinux.search_conffile_dirs(subj))
    (call .selinux.getattr_filesystems(subj))

     ;;read datafiles
    (call .file.read_datafile_lnk_files(subj))
    (call .file.read_datafile_files(subj))

    ;;open datafile
    (allow subj file.datafile (file (open)))

    ;; search/read/write/map pcm dev nodes
    (call .snd.search_nodedev_dirs (subj))
    (call .snd.readwrite_nodedev_chr_files(subj))
    (call .snd.mapexecute_nodedev_chr_files (subj))

     ;;search/write kernel dir/files
    (call .kernel.search_sysfile_dirs(subj))
    (call .kernel.write_sysfile_files(subj))

    ;; connect/write leprop socket/sock files
    (call .leprop.connectto_unix_stream_sockets (subj))
    (call .leprop.write_miscfile_sock_files(subj))

    ;; manage miscfile
    (call .mnt.search_miscfile_dirs(subj))
    (call .mnt.read_miscfile_files(subj))
    (allow subj mnt.miscfile (file (open)))

    (allow subj .invalid (dir (search)))
    (allow subj .invalid (chr_file (ioctl read write open map)))
    (allow subj  .sys.subj (binder (call transfer)))

    ;;open pmsg_dev.nodedev
    (allow subj pmsg_dev.nodedev (chr_file (write open)))

    ;; manage sdcard miscfile
    (call .sdcard.search_miscfile_dirs(subj))
    (allow subj sdcard.miscfile (dir (search)))
    (allow subj sdcard.miscfile (file (read open)))
)
