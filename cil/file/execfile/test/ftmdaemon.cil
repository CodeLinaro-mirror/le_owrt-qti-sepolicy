(in .sys
	(call .ftmdaemon.subj_type_transition (subj))
)

(in .file
	(call .ftmdaemon.obj_type_transition_execfile (unconfined.subj_typeattr))
)

(block ftmdaemon

	;;Contexts

	(filecon
	"/usr/bin/ftmdaemon"
	file
	execfile_file_context)

	;;

	;; Macros

	(macro obj_type_transition_execfile ((type ARG1))
		(call .file.execfile_obj_type_transition
			(ARG1 execfile file "ftmdaemon")))

	;;

	;; Policy

	(blockinherit .agent.base_template)

	(allow subj self (capability (net_admin)))

	(allow subj self create_unix_dgram_socket)
	(allow subj self create_unix_stream_socket)
	(allow subj self create_netlink_generic_socket)
	(allow subj self create_qipcrtr_socket)

	(call .logd.unix_dgram_send (subj))
	(call .diag-router.connectto_unix_stream_sockets (subj))

	(call .file.search_conffile_dirs (subj))
	(call .file.read_conffile_lnk_files (subj))
	(call .sys.search_fs_dirs (subj))

	;; To access /dev/btpower
	(call .qbt_dev.readwrite_nodedev_chr_files(subj))

	;; Permissions for /sys/power/wake_lock /sys/power/wake_unlock
	(call .power.search_sysfile_dirs(subj))
	(call .power.readwrite_sysfile_files (subj))
	(allow subj self (capability2 (wake_alarm block_suspend)))

	(call .qbt.manage_datafile_dirs (subj))
	(call .qbt.manage_datafile_files (subj))

	(call .qcfirmware.search_miscfile_dirs (subj))
	(call .qcfirmware.read_miscfile_files (subj))

	;; To access /dev/socket/leprop-service
	(call .leprop.unix_dgram_send (subj))

	;; Need to print on adb shell
	(call .sys.readwriteinherited_ptydev_chr_files (subj))
	;; Need to print on serial console
	(call .dev.readwriteinherited_ttydev_chr_files (subj))
)
