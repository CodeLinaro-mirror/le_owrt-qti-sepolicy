 ;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-


(in .dev
    (call .android_mbim.obj_type_transition_nodedev (unconfined.subj_typeattr)))

(block android_mbim

       ;;
       ;; Contexts
       ;;

       (filecon
        "/dev/android_mbim"
        char
        nodedev_file_context)

       ;;
       ;; Macros
       ;;
       (macro obj_type_transition_nodedev ((type ARG1))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev chr_file "android_mbim")))
       ;;
       ;; Policy
       ;;

       (blockinherit .dev.node.obj_template))
