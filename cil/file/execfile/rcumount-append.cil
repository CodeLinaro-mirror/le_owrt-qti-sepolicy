;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-


(in .rcumount
	(booleanif user_debug
		(true
			(allow subj debug.fs (dir (search)))
		)
	)
	(allow subj mtd.stordev (chr_file (open read ioctl)))
	(allow subj cache.miscfile (filesystem (unmount)))
	(allow subj qcfirmware.miscfile (filesystem (unmount)))
)
