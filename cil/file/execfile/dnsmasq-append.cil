(in .dnsmasq

  ;; Need this to label dnsmasq.conf.* file.
  ;; This is temporary workaround to label file when /tmp/etc is coming in tmp.fs(default context)
  ;; When /tmp/etc dir comes with unique context(proper context)
  ;; relabelling doesn't takes place as it is not needed.
  (filecon
     "/tmp/etc/*"
     file
     conftmpfile_file_context)

  (macro obj_type_transition_conftmpfile_2 ((type ARG1)(class ARG2)(name ARG3))
      (call .tmp.fs_obj_type_transition
         (ARG1 conftmpfile ARG2 ARG3)))

;; policy

(allow subj self (capability (dac_read_search)))
(call .netifd.use_fds (subj))
(allow subj .netifd.subj (fifo_file (read write)))
(allow subj .netifd.subj (netlink_route_socket (read write)))
(allow subj .netifd.subj (netlink_kobject_uevent_socket (read write)))
(call .qcmap_cli.use_fds (subj))
(call .qcmap_cli.readwrite_unix_stream_sockets (subj))
(allow subj .qcmap_cli.subj (fifo_file (read write)))
;; Need open read append getattr on /tmp/data/dhcp.leases
(call .qcmap_cm.manage_tmpfile_files (subj))
(call .qcmap_cm.search_tmpfile_dirs (subj))
(call .dnsmasq.read_conftmpfile_files (subj))
(call .dnsmasq.search_conftmpfile_dirs (subj))
)



