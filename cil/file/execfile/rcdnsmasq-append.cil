(in .rcdnsmasq

(block rcdnsmasqtmp

       ;; policy

       (blockinherit .agent.base_template))
         (call .uci.search_conffile_dirs (subj))
         (call .uci.read_conffile_files (subj))
         (call .uci.search_tmpfile_dirs (subj))
         (call .random.read_nodedev_chr_files (subj))
         (allow subj self (capability (dac_read_search)))
         (call .netifd.use_fds (subj))
         (allow subj self (capability (dac_override)))
         (allow subj .netifd.subj (fifo_file (read write)))
         (allow subj .netifd.subj (netlink_route_socket (read write)))
         (allow subj .netifd.subj (netlink_kobject_uevent_socket (read write)))
         (call .netifd.manage_miscfile_dirs (subj))
         (call .qcmap_cli.use_fds (subj))
         (call .qcmap_cli.readwrite_unix_stream_sockets (subj))
         (allow subj .qcmap_cli.subj (fifo_file (read write)))
         (call .qcmap_cm.obj_type_transition_tmpfile (subj dir "data"))
         (call .qcmap_cm.manage_tmpfile_dirs (subj))
         (call .qcmap_cm.manage_tmpfile_files (subj))

         ;; Need this to label dnsmasq.conf.* file.
         ;; This is temporary workaround to label file when /tmp/etc is coming in tmp.fs(default context)
         ;; When /tmp/etc dir comes with unique context(proper context)
         ;; relabelling doesn't takes place as it is not needed
         (call .dnsmasq.obj_type_transition_conftmpfile_2 (subj file "*"))
         (call .dnsmasq.manage_conftmpfile_files (subj))
         (call .qcmap_ref.use_fds (subj))
         (call .qcmap_ref.readwrite_unix_stream_sockets (subj))
         (allow subj .qcmap_ref.subj (fifo_file (read write)))
         (allow subj .filesystems.procfile (file (read)))
         (call .sys.getattr_filesystems(subj))
         (allow .rcdnsmasq.subj .sys.fs (filesystem (getattr)))
         (call .filesystems.read_procfile_files (subj))
         (allow subj qcmap_ref.subj (netlink_route_socket (read write)))
)
