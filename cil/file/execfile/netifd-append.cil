(in .file
    (call .netifd.obj_type_transition_tmpfile_ext (unconfined.subj_typeattr))
    (call .netifd.obj_type_transition_runtimetmpfile_1 (unconfined.subj_typeattr))
)

(in .netifd

(block netifdtmp

       ;; policy

       (blockinherit .agent.base_template))

       (filecon
       "/tmp/ipv4config.*"
       file
       tmpfile_file_context)

       (filecon
       "/tmp/usb_bind_in_progress"
       file
       tmpfile_file_context)

       (filecon
       "/tmp/default\.route\.v4\.list"
       file
       tmpfile_file_context)

       (filecon
       "/tmp/default\.route\.v6\.list"
       file
       tmpfile_file_context)

       (macro obj_type_transition_tmpfile ((type ARG1)(class ARG2)(name ARG3))
            (call .tmp.fs_obj_type_transition
                (ARG1 tmpfile ARG2 ARG3)))

       (macro obj_type_transition_tmpfile_ext ((type ARG1))
            (call obj_type_transition_tmpfile (ARG1 file "ipv4config.wanwlan"))
            (call obj_type_transition_tmpfile (ARG1 file "ipv4config.wanusb"))
            (call obj_type_transition_tmpfile (ARG1 file "ipv4config.wanbt"))
            (call obj_type_transition_tmpfile (ARG1 file "ipv4config.waneth"))
            (call obj_type_transition_tmpfile (ARG1 file "ipv4config.lan"))
            (call obj_type_transition_tmpfile (ARG1 file "default.route.v4.list"))
            (call obj_type_transition_tmpfile (ARG1 file "default.route.v6.list"))
            (call obj_type_transition_tmpfile (ARG1 file "usb_bind_in_progress"))
       )

       (macro obj_type_transition_runtimetmpfile_1 ((type ARG1))
                 (call .tmpfile.runtimetmpfile_obj_type_transition
                        (ARG1 runtimetmpfile sock_file "charon.vici"))
                 (call .tmpfile.runtimetmpfile_obj_type_transition
                        (ARG1 runtimetmpfile sock_file "charon.ctl"))
                 (call .tmpfile.runtimetmpfile_obj_type_transition
                        (ARG1 runtimetmpfile sock_file "charon.dck"))
                 (call .tmpfile.runtimetmpfile_obj_type_transition
                        (ARG1 runtimetmpfile sock_file "charon.wlst"))
                 (call .tmpfile.runtimetmpfile_obj_type_transition
                        (ARG1 runtimetmpfile sock_file "charon.xml"))
                 (call .tmpfile.runtimetmpfile_obj_type_transition
                        (ARG1 runtimetmpfile file "starter.charon.pid"))
                 (call .tmpfile.runtimetmpfile_obj_type_transition
                        (ARG1 runtimetmpfile file "charon.pid")))

         (blockinherit .tmpfile.obj_template)
         (call obj_type_transition_tmpfile_ext (subj))
         (call obj_type_transition_runtimetmpfile_1 (subj))
         (allow subj mwan3.tmpfile (fifo_file (write open)))
         (allow subj netifd.tmpfile (file (create write open append read getattr unlink)))
         (allow subj .tmp.fs (dir (remove_name)))
         (allow subj odhcp6c.tmpfile (file (open read getattr write unlink)))
         (allow subj self (capability (dac_override dac_read_search)))
         (call .nameservice.read_miscfile_files (subj))
         (call .ifup.use_fds (subj))
          (call .iproute2.search_conffile_dirs (subj))
          ;; Need manage on /tmp/ipv{4/6}config[0-9]+
          (call .qcmap_cli.manage_tmpfile_files (subj))
          (call .ifup.subj_type_transition (subj))
          (call .rcdnsmasq.subj_type_transition (subj))
          (call .conntrack.subj_type_transition (subj))
          (call .xtables.subj_type_transition (subj))
          (call .ifstatus.subj_type_transition (subj))
          (call .file.search_initscriptfile_dirs (subj))
          (call .file.execute_initscriptfile_files (subj))
          (call .file.readwrite_conffile_dirs(subj))
          (call .file.readwrite_conffile_files (subj))
          ;; Need read , open, append on /etc/iproute2/rt_tables
          (call .iproute2.readwrite_conffile_files (subj))
          (call .sys.readwriteinherited_fifo_files (subj))
          (allow xtables.subj netifd.subj (fd (use)))
          (allow xtables.subj netifd.subj (netlink_route_socket (read write)))
          (allow xtables.subj netifd.subj (netlink_kobject_uevent_socket (read write)))
          ;; Need manage on /tmp/ipv{4/6}config[0-9]+
          (call .qcmap_ref.manage_tmpfile_files (subj))
          (call .qcmap_cm.search_runtimetmpfile_dirs (subj))
          (call .qcmap_cm.write_runtimetmpfile_dirs (subj))
          (call .qcmap_cm.create_runtimetmpfile_files (subj))
          (call .qcmap_cm.read_runtimetmpfile_files (subj))
          (call .qcmap_cm.write_runtimetmpfile_files (subj))

          (call .qcmap_cm.search_tmpfile_dirs (subj))
          ;; Need execute, read open on /etc/init.d/odhcpd
          (call .rcodhcpd.execute_initscriptfile_files (subj))
          (call .rcodhcpd.read_initscriptfile_files (subj))
          (call .rccommon.read_conffile_files (subj))
          ;; Need search, read on /tmp/lock/procd_odhcpd.lock
          (call .tmpfile.search_locktmpfile_dirs (subj))
          (call .tmpfile.readwrite_locktmpfile_dirs (subj))
          (call .tmpfile.read_locktmpfile_files (subj))
          (call .tmpfile.create_locktmpfile_files (subj))
          ;; Need execute/read on ipa
          (call .ipacli.execute_execfile_files (subj))
          (call .ipacli.read_execfile_files (subj))
          (call .rcfirewall.execute_initscriptfile_files (subj))
          (call .tmpfile.search_statetmpfile_dirs (subj))
          (call .uci.read_statetmpfile_files (subj))
          (call .qcmap_cm.write_tmpfile_dirs (subj))
          (call .qcmap_cm.manage_tmpfile_files (subj))
          (call .fw3.subj_type_transition (subj))
          (allow subj .fw3.execfile (file (getattr)))
          (call .fw3.execute_execfile_files (subj))
          (call .fw3.search_datafile_dirs (subj))
          (call .fw3.manage_datafile_files (subj))

          (allow subj .tmpfile.runtimetmpfile (dir (create rmdir)))

          (allow subj .sys.fs (filesystem (getattr)))
          (allow subj .filesystems.procfile (file (read)))

          ;; Need run chmod on /dev/socket/data/pd_manager
          (allow subj .qcmap_cm.tmpfile (sock_file (getattr setattr)))
          (allow subj self (capability (fsetid fowner)))

          (allow subj miniupnpd.datafile (file (open read getattr)))

          ;; Need read on fw3.state file
          (call .fw3.readwrite_runtimetmpfile_files (subj))
          (allow subj .fw3.runtimetmpfile (file (unlink)))
          ;; Need rules for mwan3
          (call .mwan3.obj_type_transition_runtimetmpfile (subj))
          (call .mwan3.search_runtimetmpfile_dirs (subj))
          (call .mwan3.manage_runtimetmpfile_files(subj))
          (call .mwan3.create_runtimetmpfile_dirs (subj))
          (call .mwan3.manage_runtimetmpfile_dirs (subj))
          (call .ipa.readwrite_nodedev_chr_files (subj))
          (allow subj diag-router.subj (unix_stream_socket (connectto)))
          (call .net.read_procfile_lnk_files (subj))
          ;; Need readon ip_table_names
          (call .net.readwrite_procfile_files (subj))
          ;; Need read_write on xtables
          (call .xtables.readwrite_runtimetmpfile_files (subj))
          (allow subj .xtables.execfile ( file (getattr)))
          ;; Need search, getattr on /sys/module/nf_conntrack_amanda
          (call .module.search_sysfile_dirs (subj))
          ;; Need getattr, associate on nf_conntrack
          (call .proc.getattr_filesystems (subj))
          (call .proc.associate_filesystems (subj))

          ;; Need obj_type_transition for /etc/firewall.user.*
          (call .firewall.obj_type_transition_conffile_ext (subj))
          (allow subj .firewall.conffile (file (getattr create)))
          ;; Need open write on /etc/firewall.user
          (call .firewall.manage_conffile_files (subj))

          (call .file.read_conffile_lnk_files (subj))
          (allow subj self create_netlink_netfilter_socket)
          (allow subj self readwrite_netlink_netfilter_socket)
          ;; Need permission for nf_conntrack
          (allow subj netifd.subj (dir (write add_name)))
          (allow subj netifd.subj (file (create)))
          ;;Need permission to manage conffile files and dirs
          (call .qcmap_cm.search_conffile_dirs (subj))
          (call .qcmap_cm.manage_conffile_files (subj))
          (call .qcmap_cm.execute_conffile_files (subj))
          ;; Need execute, read on /etc/init.d/network
          (call .rcnetwork.execute_initscriptfile_files (subj))
          (call .rcnetwork.read_initscriptfile_files (subj))
          ;; Need permissions on /lib/network/config.sh
          (call .network.search_miscfile_dirs (subj))
          (call .network.readwrite_miscfile_dirs (subj))
          (call .network.manage_miscfile_files (subj))
          (call .kmsg.readwrite_nodedev_chr_files (subj))
          (call .locale.manage_miscfile_files (subj))
          (call .locale.read_miscfile_files (subj))
          (call .locale.map_miscfile_files (subj))
          (allow subj .config.fs (dir (search getattr write add_name)))
          (allow subj .config.fs (file (create write open)))
          (allow subj .kernel.sysfile (dir (search)))
	  ;; Need permission to create firewall.user
	  (allow subj .file.conffile (file(create)))
          ;; Need permissions to allow link toggle from rmnet.script
          (call .debug.search_fs_dirs (subj))
          (call .wifi.subj_type_transition (subj))
          (call .wifi.readwrite_datafile_dirs (subj))
          (call .wifi.mapexecute_execfile_files (subj))
          (call .wifi.read_execfile_files (subj))
          (allow subj .wifi.miscfile (dir (read open search)))
          (allow subj .wifi.miscfile (file (read open getattr)))
          (allow subj .wifi.datafile (file (lock unlink)))
          (allow subj .wifi.datafile (file (read write append open create getattr)))
          (allow subj .wifi.datafile (sock_file (getattr)))
          (allow subj .wifi.datafile (dir (search read open getattr)))
          (allow subj .kpi_values.sysfile readwrite_file)
          (call capabilities.getattr_conffile_files (subj))
          (call .wifi.search_datafile_dirs (subj))
          (call capabilities.search_conffile_dirs (subj))

          ;; Need permissions write log from backhaulCommonConfig.sh
          (call .qcmap_cm.search_datafile_dirs (subj))
          (allow subj .qcmap_cm.datafile (file (append open)))

          ;; Need permission for backhaul status indicate feature
          (allow subj .netifd.subj (capability (kill)))
          (allow subj .qcmap_cm.subj (process(signal)))
          (allow subj sys.subj (process (signal)))

          ;; Need permission for iw operation from script
          (call .iw.subj_type_transition (subj))
          (allow subj self (netlink_generic_socket(create)))
          (allow iw.subj netifd.subj (fd (use)))
          (allow iw.subj netifd.subj (fifo_file (read write)))

          ;; Need permissions for /etc/data/qcmap_ipsec
	  (call .qcmap_cm.mapexecute_execfile_files (subj))
	  (call .qcmap_cm.execute_conffile_files (subj))
	  (call .file.execute_initscriptfile_files (subj))
	  (call .file.read_conffile_files (subj))
	  (allow subj .file.conffile (file (getattr map)))
	  (allow subj .file.conffile (dir (read open)))
	  (allow subj .xtables.execfile (file (getattr execute)))

	  ;; Need for /tmp/ipsec/strongswan.conf
	  (allow subj .tmp.fs (file (create read open getattr write)))
	  (allow subj .netifd.tmpfile (file (write unlink)))
	  (allow subj .tmpfile.conftmpfile (dir (search)))
	  (allow subj .netifd.subj (alg_socket (create)))

	  ;;Need access for /etc/ssl/engines.cnf.d
	  (allow subj .ssl.certfile (dir (read search getattr open)))
	  (allow subj .ssl.certfile (file (read open)))
	  (allow subj .ssl.conftmpfile (dir (search)))
	  (allow subj .ssl.conftmpfile (file (getattr read)))
	  (allow subj .sys.subj (unix_stream_socket (connectto)))

          ;; Need enable mwan3 for wanwlan
	  (allow subj hotplug.conffile (file (open read)))
	  (allow subj hotplug.conffile (dir (search)))

          ;; Needed for rmnet.script
          (dontaudit subj .tmpfile.locktmpfile (dir (write)))

          ;;Need for /tmp/ipsec/strongswan.conf and /tmp/swanctl/swanctl.conf
	  (allow subj .qcmap_cli.tmpfile (dir (search write add_name getattr)))
	  (allow subj .qcmap_cli.tmpfile (file (write)))

	  ;;Need for /tmp/run/charon files
	  (allow subj .qcmap_cli.runtimetmpfile (file (getattr read open)))
	  (allow subj .qcmap_cli.runtimetmpfile (sock_file (write unlink)))

          ;;Need for accessing strongswan module
	  (allow subj .qcmap_cli.subj (unix_stream_socket (connectto)))
	  (allow subj .qcmap_cli.subj (process (signull signal)))
	  (allow subj .sys.subj (process (signull signal)))

	  ;;Need for execute_no_trans denials for ipsec
	  (call .file.execute_libfile_files (subj))
	  (call .xtables.execute_execfile_files (subj))
	  (call .file.execute_execfile_files (subj))

          ;;Need for ipsec iptable rule
          (allow subj .file.conffile (lnk_file (read)))
	  (allow subj .locale.miscfile (file (map)))

          ;;Need for charon socket access(charon.vici,charon.xml,etc)
	  (allow subj .core.sysctlfile (dir (search)))
	  (allow subj .core.sysctlfile (file (write open ioctl)))
	  (allow subj .netifd.subj (unix_stream_socket (connectto accept)))
	  (allow subj .reserved.netport (udp_socket (name_bind node_bind)))

          ;;Need for datacall connected event from rmnet_script for ipsec
	  (allow subj .netifd.runtimetmpfile (sock_file (create setattr unlink write)))
	  (allow subj .netifd.subj (netlink_xfrm_socket (read create bind setopt write ioctl nlmsg_read nlmsg_write)))
	  (allow subj .netifd.subj (unix_stream_socket (listen)))
	  (allow subj .ssl.conftmpfile (file (open)))

          ;;Need for send out ipsec traffic
          (allow subj .unreserved.netport (udp_socket (name_bind)))
	  (allow subj .netifd.subj (lockdown (confidentiality)))
	  (allow subj .uci.subj (process (rlimitinh siginh)))
	  (allow subj .hotplugcall.subj (process (rlimitinh siginh)))
	  (allow subj .wpad.subj (process (rlimitinh siginh)))
	  (allow subj .wifi.subj (process (rlimitinh siginh)))

	  ;;Need for IPA CFG XML access in EoGRE
	  (allow subj .ipacm.conffile (dir (search write add_name remove_name)))
	  (allow subj .ipacm.conffile (file (read write open lock getattr create ioctl unlink)))

          ;;Need for swanctl append
          (call .tmp.readwrite_fs_files (subj))

          ;; Need for tinyproxy
          (call .rctinyproxy.execute_initscriptfile_files (subj))
)
