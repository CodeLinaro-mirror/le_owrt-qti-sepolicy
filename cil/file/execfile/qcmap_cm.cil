    (allow subj .mka_authenticator.initscriptfile (file (getattr execute read open)))
    (allow subj ipv6.sysctlfile ( dir ( search ) ) )
    (allow subj ipv6.sysctlfile ( file ( write ) ) )
    (allow subj ipv6.sysctlfile ( file ( open ) ) )
