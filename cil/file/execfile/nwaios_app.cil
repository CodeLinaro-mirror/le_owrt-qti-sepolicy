(in .sys
    (call .nwaios_app.subj_type_transition (subj)))

(in .file
    (call .nwaios_app.obj_type_transition_execfile (unconfined.subj_typeattr)))

(block nwaios_app
        ;;
        ;; Contexts
        ;;
        (filecon
         "/usr/bin/nwaios-sample-app"
         file
         execfile_file_context)

        (filecon
        "/usr/bin/nwaios-stats-app"
        file
        execfile_file_context)

        (filecon
        "/usr/bin/media_wrapper_app"
        file
        execfile_file_context)

        (macro obj_type_transition_execfile ((type ARG1))
            (call .file.execfile_obj_type_transition
            (ARG1 execfile file "nwaios-sample-app"))
            (call .file.execfile_obj_type_transition
            (ARG1 execfile file "nwaios-stats-app"))
            (call .file.execfile_obj_type_transition
            (ARG1 execfile file "media_wrapper_app")))

        ;; Policy
        (blockinherit .agent.base_template)

        ;; Rules

        ;; File-related rules
        (call .file.search_conffile_dirs (subj))

        ;; NWAIOS data access for AI model files and input files
        (call .nwaios.full_access (subj))

        ;; Unix socket-related rules
        (allow subj self create_unix_dgram_socket)
        (allow subj self create_unix_stream_stream_socket)

        ;; TCP socket for media_wrapper_app server on port 9000
        (allow subj self create_tcp_stream_socket)
        (allow subj .unreserved.netport (tcp_socket (name_bind)))
        (allow subj .net.netnode (tcp_socket (node_bind)))

        ;; Network egress for media_wrapper_app server responses
        (allow subj net.netif (netif (egress)))
        (allow subj net.netnode (node (sendto)))

        ;; UDP socket for media_wrapper_app on port 10000
        (allow subj self create_udp_socket)
        (allow subj .unreserved.netport (udp_socket (name_bind)))
        (allow subj .net.netnode (udp_socket (node_bind)))

        ;; Netlink route socket for address resolution
        (allow subj self create_netlink_route_socket)
        (allow subj self (netlink_route_socket (nlmsg_read)))

        ;; DNS resolution support
        (call .file.read_conffile_lnk_files (subj))
        (call .resolv.search_tmpfile_dirs (subj))
        (call .resolv.read_tmpfile_files (subj))
        (call .nameservice.read_miscfile_files (subj))

        ;; Pipe operations with sys.subj
        (allow subj sys.subj (fifo_file (read)))

        ;; Write to aios_daemon's socket file
        (allow subj aios_daemon.subj (sock_file (write)))

        ;; Logging support
        (call .logd.sendto_unix_dgram_sockets (subj))
        (call .logd.readwrite_miscfile_sock_files (subj))

        ;; Connect to aios_daemon unix stream socket
        (allow subj aios_daemon.subj (unix_stream_socket (connectto)))

        ;; Shared memory access with aios_daemon
        (allow subj aios_daemon.subj (shm (unix_read unix_write read write)))

        ;; Write output files to /data/nwaios/
        (allow subj nwaios.datafile (dir (write add_name search)))
        (allow subj nwaios.datafile (file (create write read open)))

        ;; Allow nwaios_app to write to aios_daemon's tmpfile sock_files
        (allow subj aios_daemon.tmpfile (sock_file (write)))
)
