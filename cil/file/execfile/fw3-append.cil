(in .fw3

;; policy

(allow subj self (capability (dac_read_search)))
(call .qcmap_cli.use_fds (subj))
(call .qcmap_cli.readwrite_unix_stream_sockets (subj))
(allow .fw3.subj .qcmap_cli.subj (fifo_file (read write ioctl)))

(call .qcmap_ref.use_fds (subj))
(call .qcmap_ref.readwrite_unix_stream_sockets (subj))
(allow .fw3.subj .qcmap_ref.subj (fifo_file (read write ioctl)))
(call .netifd.read_runtimetmpfile_files (subj))
(call .netifd.manage_runtimetmpfile_files(subj))
(call .mnt.search_miscfile_dirs (subj))
(allow subj .debug.fs (dir (search read open)))
)



