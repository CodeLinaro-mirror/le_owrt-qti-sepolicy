;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

(in .dev
    (call .qbt_dev.obj_type_transition_nodedev (unconfined.subj_typeattr)))

(block qbt_dev

       ;;
       ;; Contexts
       ;;

       (filecon
        "/dev/btpower"
        char
        nodedev_file_context)

       ;; BT SPI
       (filecon
        "/dev/btspi"
        char
        nodedev_file_context)

       ;; BT UART
       (filecon
        "/dev/ttyHS0"
        char
        nodedev_file_context)

       ;;
       ;; Macros
       ;;
       (macro obj_type_transition_nodedev ((type ARG1))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev chr_file "btpower"))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev chr_file "btspi"))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev chr_file "ttyHS0")))
       ;;
       ;; Policy
       ;;

       (blockinherit .dev.node.obj_template))
