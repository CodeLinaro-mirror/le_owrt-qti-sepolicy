(in .file
 ;;   (call .shell.obj_type_transition_execfile (unconfined.subj_typeattr))


       ;;
       ;; Contexts
       ;;


	(filecon
        "/sbin"
        file
        execfile_file_context)

	(filecon
        "/sbin/*"
        any
        execfile_file_context)

	(filecon
	"/usr/sbin"
	 file
	 execfile_file_context)

	(filecon
	"/data"
     	dir
     	datafile_file_context)

	(filecon
	"/data/.*"
     	any
     	datafile_file_context)



	   ;;; This section is added for upstream policy
	   
	   ;;#============= rcdnsmasq.subj ==============
	   (call .uci.search_conffile_dirs (rcdnsmasq.subj))
	   (call .uci.read_conffile_files (rcdnsmasq.subj))
	   (call .uci.search_tmpfile_dirs (rcdnsmasq.subj))
	   (call .random.read_nodedev_chr_files (rcdnsmasq.subj))

	   ;;#============= rcdropbear.subj ==============
	   (call .uci.search_conffile_dirs (rcdropbear.subj))
	   (call .uci.read_conffile_files (rcdropbear.subj))
	   (call .uci.search_tmpfile_dirs (rcdropbear.subj))
	   (allow rcdropbear.subj self (capability (chown dac_override fowner )))


	   ;;#============= rcsysntpd.subj ==============
	   (call .uci.search_conffile_dirs (rcsysntpd.subj))
	   (call .uci.read_conffile_files (rcsysntpd.subj))
	   (call .uci.search_tmpfile_dirs (rcsysntpd.subj))
	   (allow rcsysntpd.subj self create_unix_stream_stream_socket)


	;;#============= mountroot.subj ==============
	   (call .dev.stor.readwrite_all_blk_files (mountroot.subj))
	   ;;(call .stordev.getattr_all_blk_files (mountroot.subj))

	;;#============= rcboot.subj ==============
	   (call .kmsg.readwrite_nodedev_chr_files (rcboot.subj))
	   (call .modules.read_procfile_files (rcboot.subj))
	   (call .tmpfile.manage_locktmpfile_files (rcboot.subj))
	   (call .tmpfile.create_logtmpfile_dirs (rcboot.subj))
	  ;;(call .modulefiles.manage_modulesfile_dirs (rcboot.subj))


	;;#============= rcfirewall.subj ==============
	 (call .random.read_nodedev_chr_files (rcfirewall.subj))
	 (call .sys.search_sysctlfile_dirs (rcfirewall.subj))
	 (call .ipv4.search_sysctlfile_dirs (rcfirewall.subj))
	 (call .ipv4.write_sysctlfile_files (rcfirewall.subj))
	 (call .ipv6.search_sysctlfile_dirs (rcfirewall.subj))
	 (call .ipv6.write_sysctlfile_files (rcfirewall.subj))

	;;#============= ubiutil.subj ==============
	 (call .subj.writeinherited_all_fifo_files(ubiutil.subj))


	;;#============= rcsysfixtime.subj ==============
	(allow rcsysfixtime.subj self (capability (dac_override dac_read_search)))

	;;#============= ubus.subj ==============
	(allow ubus.subj self create_unix_stream_stream_socket)

	;;all libfile need execute seems pic flag is not been used
	;;(call .libfiles.execmod_libfile_files (sys.subj))

	;;#============= dnsmasq.subj ==============
	(allow dnsmasq.subj self (capability (dac_read_search)))

	;;#============= fw3.subj ==============
	(allow fw3.subj self (capability (dac_read_search)))

	;;#============= rcumount.subj ==============
	 ;;(call .mtd.read_stordev_chr_files (rcumount.subj))

	;;#============= uci.subj ==============
	(allow uci.subj self (capability (dac_override dac_read_search)))


	;;#============= udevtrigger.subj ==============
	 (call .zram.search_sysfile_dirs (udevtrigger.subj))

      ;; (blockinherit file.exec.obj_template)
	)
