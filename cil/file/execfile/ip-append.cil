(in .ip

  ;; policy

  (allow subj self (capability (dac_read_search)))
  ;; Need by "ip -6 addr" command
  (allow subj self create_tcp_socket)
  ;; TODO : Observing this denials due to domain transition to netmgrd
  ;; But currently netmgrd is running in sys.subj
  ;; Need to remove this once netmgrd.cil gets merged
  (allow subj .sys.subj (fifo_file (read write)))
  (allow subj .sys.subj (netlink_socket (read write)))
  (allow subj .sys.subj (netlink_route_socket (read write)))
  (allow subj .sys.subj (netlink_kobject_uevent_socket (read write)))
  (call .sys.readwrite_unix_stream_sockets (subj))
  (call .qcmap_cm.use_fds (subj))
  (allow subj .qcmap_cm.subj (fifo_file (read write ioctl)))
  (allow subj .qcmap_cm.subj (netlink_socket (read write)))
  (allow subj .qcmap_cm.subj (packet_socket (read write)))
  (allow subj .qcmap_cm.subj (rawip_socket (read write)))
  (allow subj .qcmap_cm.subj (netlink_route_socket (read write)))
  (allow subj .qcmap_cm.subj (netlink_kobject_uevent_socket (read write)))
  (allow subj .tlpd.subj (netlink_socket (bind create write read)))
  (allow subj .netmgrd.subj (udp_socket (read write)))
  (call .qcmap_cm.readwrite_unix_stream_sockets (subj))
  (allow subj .qcmap_cm.subj (unix_dgram_socket (read write)))
  ;; Need ioctl write on /tmp/data/tmpfdbtable.txt
  (call .qcmap_cm.write_tmpfile_files (subj))
  (allow subj .qcmap_cm.tmpfile (file (ioctl)))
  (call .qcmap_cm.read_conffile_files (subj))
  ;; Allow ip.subj to use fd
  (allow subj .dnsmasq.subj (fd (use)))
  (allow subj .dnsmasq.subj (fifo_file (read write ioctl)))
  ;; IPQ sigma_dut
  (allow subj .wifi.logtmpfile readwrite_file)
  (allow subj .wifi.subj readwrite_tcp_socket)
  ;; Need read on /sys/devices/soc0/platform_subtype_id
  (allow subj .devices.sysfile (file (read)))
  (allow subj .qcmap_cm.tmpfile (file (read)))
  ;; rule for iptables
  (allow subj .qcmap_cm.runtimetmpfile (file (create read write append open ioctl)))
  (allow subj self create_netlink_generic_socket)
  (allow subj .qcmap_cm.subj (udp_socket (read write)))

  ;; For QCMAP 'Activate supplicant'
  (allow subj .netifd.subj (netlink_route_socket (read write)))
  (allow subj .netifd.subj (netlink_kobject_uevent_socket (read write)))
  ;; rule for pbr
  (allow subj sys.sysctlfile (dir (search)))
  (allow subj net.sysctlfile (dir (search)))
  (allow subj ipv4.sysctlfile (dir (search)))
  (call .ipv4.readwrite_sysctlfile_files (subj))
  (allow subj .sys.subj (udp_socket (read write)))
  (allow subj .sys.subj (packet_socket (read write)))
  ;; rule for ipv6
  (allow subj ipv6.sysctlfile (file (read)))
  (allow subj file.conffile (lnk_file(read)))

  ;;rule for ip
  (allow subj locale.miscfile (file (open read getattr map)))
  (allow subj self (netlink_xfrm_socket (read write nlmsg_read nlmsg_write)))

  ;;STC
  (allow subj qcmap_cm.subj readwrite_tcp_socket)

  (call .ipa.readwrite_nodedev_chr_files (subj))
  (allow subj self create_udp_socket)

  ;; Allow ip to add routes
  (allow ip.subj qms.subj (fd (use)))
  (allow ip.subj qms.subj (fifo_file (read write)))
  (allow ip.subj qms.subj (unix_stream_socket (read write)))
  (allow ip.subj qms.subj (netlink_route_socket (read write)))

  (dontaudit subj self (capability (sys_admin)))
)
