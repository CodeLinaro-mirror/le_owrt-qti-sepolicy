;; Sepolicy rules for location daemon - location_hal_daemon
(in .sys
	(call .loc_hal_daemon.subj_type_transition (subj)))

(in .file
	;; location exec files transition
	(call .loc_hal_daemon.obj_type_transition_execfile (unconfined.subj_typeattr)))

;;#============= Location Hal Daemon ==============
(block loc_hal_daemon
	;;
	;; Contexts
	;; --------
	(filecon "/usr/bin/location_hal_daemon" file execfile_file_context)

	;;
	;; Macros
	;; ------
	(macro obj_type_transition_execfile ((type ARG1))
		(call .file.execfile_obj_type_transition
			(ARG1 execfile file "location_hal_daemon")))

	;;
	;; Policy
	;; ------
	(blockinherit .agent.base_template)
	(blockinherit .loc_daemons_common.loc_daemons_common_template)

	;; Set supplementary groups
	(allow subj self (capability (setgid)))

	;; import common rules for location deamons
	(call loc_daemons_common_rules (subj))

	;; connect to loc_launcher target stream
	(call .loc_launcher.connectto_unix_stream_sockets (subj))
	;; manage loc_socket nodedev link files
	(call .loc_socket.manage_nodedev_lnk_files (subj))

	;; Lcs related
	(call .file.read_conffile_lnk_files(subj))

	;; communicate with location test apps which runs in sys.subj ctxt
	(call .sys.sendto_unix_dgram_sockets (subj))
	;; connect to location test apps target stream
	(call .sys.connectto_unix_stream_sockets (subj))
	;; Need open read perm on /
	(call .sys.list_rootfile_dirs (subj))

	;; Need search on sysfile dir
	(call .fs.search_sysfile_dirs (subj))

	;; Need gettarr on selinux filesystem
	(call .selinux.getattr_filesystems (subj))
	;; Need search on selinux dir
	(call .selinux.search_conffile_dirs(subj))
	;; Need execute on shell.execfile files
	(call .shell.execute_execfile_files (subj))

	;; read kernel sysfs
	(call .kernel.search_sysfile_dirs (subj))

	;; read debug.fs dir
	(call .debug.search_fs_dirs (subj))

	;; read /etc/group
	(call .nameservice.read_miscfile_files (subj))
	;; Lcs related
	(call .locale.read_miscfile_files (subj))
	(call .locale.map_miscfile_files (subj))

	;; Search system directory
	(call .unknown.search_miscfile_dirs(subj))

	;;connect to leprop socket
	(call .leprop.connectto_unix_stream_sockets (subj))
	(call .leprop.manage_miscfile_sock_files (subj))

	;; Need read open execute on /etc/data/backhaulWWANConfig.sh
	(call .qcmap_cm.search_conffile_dirs (subj))
	(call .qcmap_cm.execute_conffile_files (subj))
	(call .qcmap_cm.sendto_unix_dgram_sockets (subj))

	;; qcmap related
	(call .qcmap_ref.read_tmpfile_files (subj))
	;; Lcs related
	(call .qms.readwrite_tmpfile_sock_files(subj))
	(call .qms.connectto_unix_stream_sockets (subj))

	;; KPI node access
	(call .kpi_values.manage_sysfile_files (subj))
	;; read urandom
	(call .random.read_nodedev_chr_files (subj))

	;; Need execute on /sbin/uci
	(call .uci.execute_execfile_files (subj))
	(call .uci.read_execfile_files (subj))

	;; Need read perm on uci.conf files.
	(call .uci.list_conffile_dirs (subj))
	(call .uci.read_conffile_files (subj))

	;; Need read perm on uci.tmp files.
	(call .uci.search_tmpfile_dirs (subj))
	(call .uci.read_tmpfile_files (subj))

	;; Need read perm on libubox files.
	(call .libubox.list_datafile_dirs(subj))
	(call .libubox.read_datafile_files (subj))

	;; Need read perm on tmpfile.locktmpfile files.
	(call .tmpfile.list_locktmpfile_dirs (subj))
	(call .tmpfile.read_locktmpfile_files (subj))

	;; Need search, read on /etc/init.d - backhaulWWANCon
	(call .file.list_initscriptfile_dirs (subj))

	;; Need execute, read on /etc/init.d/network - backhaulWWANCon
	(call .rcnetwork.execute_initscriptfile_files (subj))
	(call .rcnetwork.read_initscriptfile_files (subj))

	;; Need execute, read on /etc/init.d/firewall - backhaulWWANCon
	(call .rcfirewall.execute_initscriptfile_files (subj))
	(call .rcfirewall.read_initscriptfile_files (subj))

	;; Need read open on /etc/rc.common/network
	(call .rccommon.read_conffile_files (subj))

	;;Need search read on /lib/functions.sh
	(call .functions.list_miscfile_dirs(subj))
	(call .functions.read_miscfile_files(subj))

	;; Needed to for diagrebootapp to connect to diag-router
	(call .diag-router.unix_stream_connect(subj))

	;; Deep sleep related
	(call .httpproxy.tcp_connect_netports (subj))

	(call .net.egress_netifs (subj))
	(call .net.recvfromsendto_netnodes (subj))

	(call .powerstate_socket.search_nodedev_dirs (subj))
	(call .powerstate_socket.manage_powerstate_socket_files (subj))
	(call .powerstate.connectto_unix_stream_sockets (subj))

	;; Permissions for /sys/power/wake_unlock
	(call .power.search_sysfile_dirs(subj))
	(call .power.append_sysfile_files(subj))

	;; Qwes related permissions
	(call .qwesd_mink_socket.search_nodedev_dirs (subj))
	(call .qwesd_mink_socket.readwrite_nodedev_sock_files (subj))
	(call .qwesd.connectto_unix_stream_sockets (subj))

	;; ssgtzd related permissions
	(call .ssgtzd_socket.manage_ssgtzd_socket_files (subj))
	(call .ssgtzd.connectto_unix_stream_sockets (subj))


	;; Need qipcrtr socket creations
	(allow subj  self  create_qipcrtr_socket)

	;; Lcs related
	(allow subj file.conffile (file (getattr)))

	;; Send messages to mbb_device_agent
	(call .mbb_device_agent.sendto_unix_dgram_sockets (subj))
)
