    (allow subj dnsmasq.subj (netlink_route_socket (read write)))
    (allow subj rcdnsmasq.subj (netlink_route_socket (read write)))
    (allow kmodloader.subj qcmap_cm.subj (netlink_route_socket (read write)))
    (allow rcdnsmasq.subj qcmap_cm.subj (netlink_route_socket (read write)))
    (allow dnsmasq.subj qcmap_cm.subj (netlink_route_socket (read write)))

    ;; Need permission for wifitool command
    (allow subj wifi.datafile (file (map)))
