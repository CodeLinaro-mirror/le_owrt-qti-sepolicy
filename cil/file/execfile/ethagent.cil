(in .sys
    (call .ethagent.subj_type_transition (subj)))

(in .file
    (call .ethagent.obj_type_transition_execfile (unconfined.subj_typeattr)))

(block ethagent
	;;
	;;

        (filecon
        "/usr/bin/ethagent"
        file
        execfile_file_context)

        ;;
        ;; Macros
        ;;
        (macro obj_type_transition_execfile ((type ARG1))
              (call .file.execfile_obj_type_transition
                        (ARG1 execfile file "ethagent")))

        ;;
        ;; Policy
        ;;

	(blockinherit .agent.base_template)

	(allow subj self (capability(net_admin)))
	(allow subj self (qipcrtr_socket(create)))
	(allow subj self (unix_dgram_socket(create connect write ioctl)))
	(allow subj self (netlink_route_socket(create bind read setopt getattr write nlmsg_read)))
	(allow subj self (udp_socket(create ioctl)))
	(allow subj self (netlink_socket(create bind read)))
	(allow subj self (unix_stream_socket(create connect read write)))

	(allow subj sys.subj (system(module_request)))
	(allow subj sys.fs (dir(search)))

	(allow subj logd.miscfile (sock_file(write)))
	(allow subj logd.subj (unix_dgram_socket(sendto)))

	(allow subj class.sysfile (dir(search)))
	(allow subj class.sysfile (lnk_file(read)))

	(allow subj devices.sysfile (dir(getattr read open search)))
	(allow subj devices.sysfile (file(getattr read open)))

	(call .tmpfile.search_conftmpfile_dirs (subj))
	(allow subj tmpfile.runtimetmpfile (dir(search)))

	(allow subj qcmap_cm.conffile(dir(search)))
	(allow subj qcmap_cm.conffile (file(read open)))
	(allow subj qcmap_cm.runtimetmpfile (dir(search)))
	(allow subj qcmap_cm.runtimetmpfile(sock_file(write)))

	(allow subj diag-router.subj (unix_stream_socket(create connect connectto)))

	(allow subj tlpd.subj(unix_stream_socket(connectto)))

	(allow subj file.conffile (dir(search)))
	(allow subj file.conffile(lnk_file (read)))

	(allow subj kernel.sysfile(dir(search)))

	(allow subj debug.fs(dir(getattr read open search)))
	(allow subj debug.fs(file(read open getattr)))

	(allow subj selinux.conffile(dir(search)))
	(allow subj selinux.fs(filesystem(getattr)))
	(allow subj locale.miscfile (file(read open getattr map)))

	(allow subj shell.execfile(file(read open execute map getattr execute_no_trans)))

	(allow subj fs.sysfile(dir(search)))

	(call .ssl.search_certfile_dirs (subj))
	(call .ssl.read_certfile_files (subj))
	(call .ssl.search_conftmpfile_dirs (subj))
	(call .ssl.read_conftmpfile_files (subj))
	(allow subj ssl.certfile(dir(read open)))

	(call .pmsg_dev.readwrite_nodedev_chr_files (subj))

	(dontaudit subj ethagent.subj (capability( dac_override )))
)
