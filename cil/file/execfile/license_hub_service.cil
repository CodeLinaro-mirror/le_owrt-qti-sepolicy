(in .sys
    (call .license_hub_service.subj_type_transition (subj)))

(in .file
    (call .license_hub_service.obj_type_transition_execfile (unconfined.subj_typeattr))
    (call .license_hub_service.obj_type_transition_datafile (unconfined.subj_typeattr)))

(block license_hub_service

    ;;
    ;; Contexts
    ;;

    (filecon
    "/usr/bin/license_hub_service"
    file
    execfile_file_context)

    (filecon
    "/data/licensehub_config.json"
    file
    datafile_file_context)

    ;;
    ;; Macros
    ;;

    (macro obj_type_transition_execfile ((type ARG1))
        (call .file.execfile_obj_type_transition
            (ARG1 execfile file "license_hub_service")))

    (macro obj_type_transition_datafile ((type ARG1))
        (call .file.datafile_obj_type_transition
            (ARG1 datafile file "licensehub_config.json")))

    ;;
    ;; Policy
    ;;

    (blockinherit .agent.base_template)
    (blockinherit file.conf.obj_template)
    (blockinherit file.data.obj_template)
    (blockinherit .tmpfile.runtime.obj_template)
    (blockinherit .tmpfile.obj_template)

    ;; Need qipcrtr socket creation and read/write
    (allow subj self create_qipcrtr_socket)

    ;; Need unix_dgram socket for logging
    (allow subj self create_unix_dgram_socket)

    ;; Need for /dev/log logging (write on logd.miscfile sock_file + sendto logd.subj)
    (call .logd.unix_dgram_send (subj))

    ;; Need unix_stream socket for diag-router connection
    (allow subj self create_unix_stream_socket)

    ;; Need connectto diag-router unix stream socket
    (call .diag-router.unix_stream_connect (subj))

    ;; Need read/write/open/ioctl on /dev/smcinvoke
    (allow subj .smcinvoke.nodedev (chr_file (read write open ioctl)))

    ;; Need udp socket for DNS resolution
    (allow subj self create_udp_socket)

    ;; Need to read /etc/hosts (nameservice.miscfile)
    (call .nameservice.read_miscfile_files (subj))

    ;; Need to read /etc/resolv.conf (lnk_file) and /tmp/resolv.conf.d/ (resolv.tmpfile)
    (call .resolv.read.subj_type (subj))

    ;; Need node_bind for udp socket on net.netnode
    (allow subj .net.netnode (udp_socket (node_bind)))

    ;; Need to connect to HTTPS port 443 (http.netport)
    (call .http.tcp_connect_netports (subj))

    ;; Need to read own datafile /data/licensehub_config.json
    (allow subj license_hub_service.datafile (file (getattr open read)))

    ;; Need egress on net.netif for DNS/network traffic
    (call .net.egress_netifs (subj))

    ;; Need sendto on net.netnode for DNS/network traffic
    (call .net.sendto_netnodes (subj))

    ;; Need to read /dev/urandom (random.nodedev)
    (call .random.read_nodedev_chr_files (subj))

    ;; Need to search/read SSL certificates (/etc/ssl/ca-certificates.crt)
    (call .ssl.read.subj_type (subj))

)
