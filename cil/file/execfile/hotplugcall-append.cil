;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-


(in .hotplugcall


;;Needed for search on /dev dir
      (allow  subj  dma_heap.nodedev  search_dir)

;;Need for setattr
      (allow  subj smcinvoke.nodedev  (chr_file (setattr)))
      (allow  subj dma_heap.nodedev (chr_file (setattr)))

;;Needed to do  chown/chmod/fowner/fsetid on the new node
      (allow subj self (capability (chown fowner fsetid net_admin net_raw)))

;;Need to update dma_heap/qcom,qseecom and smcinvoke for getattr
      (call .dma_heap.read_nodedev_chr_files (subj))
      (call .smcinvoke.read_nodedev_chr_files (subj))

;; Need for qcmap_cli
      (call .qcmap_cli.use_fds (subj))
      (call .qcmap_cli.readwrite_unix_stream_sockets (subj))
      (allow .hotplugcall.subj .qcmap_cli.subj (fifo_file (read write ioctl)))
      (call .qcmap_cm.addname_tmpfile_dirs (subj))
      (call .qcmap_cm.create_tmpfile_files (subj))
      (call .qcmap_cm.manage_tmpfile_files (subj))
      (call .qcmap_cm.manage_tmpfile_dirs (subj))
;; For /etc/data/mbbUtils.sh
      (allow subj .qcmap_cm.conffile search_dir)
      (allow subj .qcmap_cm.conffile read_file)

;; Need for sdcard
      (call .file.read_conffile_files(subj))
      (allow  .hotplugcall.subj .mnt.miscfile (dir (search mounton getattr write add_name create)))
      (allow  .hotplugcall.subj .mmc.stordev (blk_file (getattr)))
      (allow  .hotplugcall.subj .filesystems.procfile (file (read open)))
      (allow  .hotplugcall.subj .file.conffile(dir (write setattr add_name remove_name)))
      (allow  .hotplugcall.subj .file.conffile(file (open read)))
      (allow  .hotplugcall.subj .mnt.miscfile (filesystem (relabelto relabelfrom mount unmount)))
      (allow  .hotplugcall.subj .dos.fs (filesystem (relabelfrom)))
      (allow  .mnt.miscfile  .mnt.miscfile (filesystem (associate)))
      (allow  .sys.subj  .mnt.miscfile (filesystem (getattr)))
      (allow  .hotplugcall.subj .sdcard.miscfile (dir (getattr mounton)))
      (allow  .hotplugcall.subj dos.fs (filesystem (mount unmount)))
      (allow  .hotplugcall.subj dos.fs (dir (getattr)))

;; Needed for the mount as this will be running in sys.subj
      (allow  .sys.subj  qcfirmware.miscfile (filesystem ( relabelto relabelfrom mount unmount getattr)))
      (allow  .qcfirmware.miscfile  qcfirmware.miscfile (filesystem (associate)))

;; Need for default route /tmp/default.route.*
      (allow  subj .netifd.tmpfile (file (read open)))

;; Need permissions on xtables-legacy-multi
      (call .xtables.manage_runtimetmpfile_files(subj))
      (call .xtables.read_execfile_files (subj))
      (call .xtables.mapexecute_execfile_files (subj))
      (call .xtables.subj_type_transition (subj))
      (allow xtables.subj hotplugcall.subj (fd (use)))
      (allow xtables.subj hotplugcall.subj readwriteinherited_fifo_file)
      (call .sys.readwriteinherited_fifo_files (subj))

;; Need permissions on mwan3
      (call .mwan3.obj_type_transition_runtimetmpfile (subj))
      (call .mwan3.manage_runtimetmpfile_dirs (subj))
      (call .mwan3.manage_runtimetmpfile_files(subj))
      (allow subj mwan3.conffile (file(getattr)))
      (call .mwan3.read_conffile_files (subj))
      (call .mwan3.execute_conffile_files (subj))

;; Need for call netifd
     (call .netifd.subj_type_transition (subj))
     (allow subj .netifd.miscfile (dir (read open)))
     (allow subj .netifd.statetmpfile (file (getattr write read open lock ioctl)))

;; Need for qcmap_ref
      (call .qcmap_ref.use_fds (subj))
      (call .qcmap_ref.readwrite_unix_stream_sockets (subj))
      (allow .hotplugcall.subj .qcmap_ref.subj (fifo_file (read write ioctl)))
      (call .netifd.manage_runtimetmpfile_files(subj))
      (allow subj .netifd.subj (fifo_file (read write)))
      (call .tmpfile.readwrite_runtimetmpfile_files (subj))

;; Need execute read on ip.execfile
      (call .ip.read_execfile_files (subj))
      (call .ip.subj_type_transition (subj))
      (allow ip.subj hotplugcall.subj (fd (use)))
      (allow ip.subj hotplugcall.subj readwriteinherited_fifo_file)
;; mount umount of sdcard need this
      (allow subj self (capability (sys_admin)))
;; Need create on netlink_netfilter_socket
      (allow subj self create_netlink_netfilter_socket)
;; Need permission on iproute2
      (call .iproute2.search_conffile_dirs (subj))
      (call .iproute2.read_conffile_files (subj))
      (call .net.read_procfile_lnk_files (subj))
      (allow subj .net.procfile (file(getattr)))
;; Need for dnsmasq restart
      (call .rcdnsmasq.subj_type_transition (subj))
      (allow rcdnsmasq.subj hotplugcall.subj (fd (use)))
;; Need to share fifo_file for jsonfilter
      (allow .jsonfilter.subj .hotplugcall.subj (fifo_file (read write ioctl)))
      (call .file.execute_execfile_files (subj))
;; Need to add rule for netfilter.
      (allow subj .net.procfile (file (read open getattr)))

      (allow .hotplugcall.subj .sys.fs (filesystem (getattr)))
      (allow subj .sys.fs (filesystem (getattr)))
      (call .sys.search_fs_dirs (subj))
      (allow subj .qcmap_cm.conffile (dir (search read getattr)))
      (allow subj .qcmap_cm.conffile (file (read open write)))

;; Need for qcmap switch backhaul for mwan3 track ip
      (allow subj .qcmap_cm.runtimetmpfile (dir (search)))
      (allow subj .qcmap_cm.runtimetmpfile (file (write open)))
      (allow subj .netifd.tmpfile (file (getattr)))
      (allow subj .odhcp6c.tmpfile (file (getattr read open)))

;; Need search read and execute permissions for miniupnpd files
      (call .miniupnpd.obj_type_transition_conftmpfile(subj))
      (call .miniupnpd.obj_type_transition_runtimetmpfile (subj))
      (allow subj .miniupnpd.conftmpfile (dir (write add_name)))
      (call .miniupnpd.manage_conftmpfile_files (subj))
      (call .miniupnpd.manage_runtimetmpfile_files  (subj))

;; Need search read and execute permissions for /etc/data/mbbUtils.sh
      (call .qcmap_cm.search_conffile_dirs (subj))
      (call .qcmap_cm.manage_conffile_files (subj))
      (call .file.execute_execfile_files (subj))
      (allow .hotplugcall.subj .logd.subj (unix_dgram_socket(sendto)))
      (call .tmpfile.search_conftmpfile_dirs (subj))

;; Need execute and getattr permission for mwan3 and /etc/hotplug.d/iface/
      (call .file.execute_datafile_files (subj))
      (allow subj file.datafile (file(getattr)))
      (allow .hotplugcall.subj .tmp.fs (file(getattr)))


;; Ref daemon netlink thread
      (allow subj qcmap_ref.subj (netlink_route_socket (read write)))
      (allow .hotplugcall.subj .sd.stordev(blk_file(getattr)))

;; Need permission for miniupnpd
      (allow subj debug.fs (dir (search)))
      (allow subj kernel.sysfile (dir (search)))
      (allow subj file.execfile (file (open read execute)))

      (allow subj .tmp.fs (file(create read write open append getattr rename unlink)))
      (allow subj .tmp.fs (dir(write add_name remove_name create)))
      (allow subj .tmp.fs (lnk_file(create)))

;; For QCMAP 'Activate supplicant'
      (allow subj .netifd.subj (netlink_route_socket (read write)))
      (allow subj .netifd.subj (netlink_kobject_uevent_socket (read write)))

;; Need For Ezmesh, hyctl communication
      (call .ezmesh.subj_type_transition (subj))
      (call .kmodloader.subj_type_transition (subj))
      (call .validatedata.subj_type_transition (subj))
      (call .validatedata.mapexecute_execfile_files (subj))
      (call .wifi.readwrite_runtimetmpfile_files (subj))

;; EasyMesh specific denial handling

      (allow subj sys.subj (system (module_request)))

      (allow subj self (udp_socket (create ioctl read setopt bind getattr listen sendto connect write)))
      (allow subj self (netlink_socket (ioctl read setopt bind getattr listen sendto create write)))
      (allow subj self (netlink_generic_socket (ioctl read setopt bind getattr listen sendto)))

      (allow subj wifi.miscfile (dir (search getattr read open map ioctl add_name)))
      (allow subj wifi.miscfile (file (unlink getattr read open map rename)))

      (allow subj cron.miscfile (dir (search getattr read open map ioctl add_name write create append remove_name rename reparent setattr)))
      (allow subj cron.miscfile (file (unlink getattr read open map rename create append)))
      (allow subj cron.miscfile (lnk_file (getattr read open map)))

      (allow subj devices.sysfile (lnk_file (getattr)))

      (allow subj class.sysfile (dir (search remove_name add_name read open getattr map ioctl)))

      (allow subj qcmap_cli.tmpfile (file (unlink getattr read open map rename write)))

      (allow subj hotplug.conffile (file (unlink getattr read open map rename execute execute_no_trans )))
      (allow subj console.ttydev (chr_file (open write)))


      (allow subj modules.procfile (file (unlink getattr read open map rename)))
      (allow subj modules.procfile (dir  (search getattr read open map ioctl add_name)))
      (allow subj modules.procfile (lnk_file (getattr read open map)))


      (allow subj ezmesh.tmpfile (dir (search remove_name add_name read open getattr map ioctl)))
      (allow subj ezmesh.tmpfile (file (unlink getattr read open map rename)))
      (allow subj ezmesh.tmpfile (lnk_file (getattr read open map)))
      (allow subj ezmesh.tmpfile (fifo_file (unlink getattr read open map rename ioctl)))
      (allow subj ezmesh.tmpfile (sock_file (ioctl read getattr unlink setattr)))


      ;;WPS Onboarding Easymesh Specific

      (allow subj ezmesh.runtimetmpfile (fifo_file (write open)))
      (allow subj random.nodedev (chr_file (open read)))

      ;;Hotplug call

      (allow subj self (tcp_socket (create ioctl)))
      (allow subj self (unix_stream_socket (create ioctl)))

;;EasyMesh dependent libqca_nl80211_wrapper.so
      (allow subj wifi.datafile (file (unlink getattr read open map rename)))
;;open/write pmsg_dev.nodedev
      (allow subj .pmsg_dev.nodedev (chr_file (write open)))

      ;; IPQ EasyMesh
      (allow subj .ipacm.runtimetmpfile (file (getattr write unlink)))
      (allow subj wifi.tmpfile (file (unlink getattr read open map rename)))
      (allow subj wpad.runtimetmpfile (file (unlink getattr read open map rename)))
      (allow subj wpad.runtimetmpfile (dir (search remove_name add_name read open getattr map ioctl)))
      (allow subj wpad.runtimetmpfile (sock_file (ioctl read getattr unlink setattr write)))
      (allow subj .wpad.execfile (file (unlink getattr read open map rename execute)))
      (allow subj .wpad.subj (unix_dgram_socket (read sendto accept)))
      (call .wifi.subj_type_transition (subj))
      (allow subj uci.statetmpfile (file (read open)))
      (call .validatedata.subj_type_transition (subj))
      (allow subj validatedata.execfile (file (execute read open map)))
      (allow subj dnsmasq.tmpfile (dir (getattr)))
      (call .dnsmasq.subj_type_transition (subj))
      (allow subj dnsmasq.execfile (file (getattr execute read open map)))
      (allow subj ipv4.sysctlfile (dir (search)))
      (allow subj ipv4.sysctlfile (file (write open)))
      (allow subj uci.conffile (file (lock)))
      (allow subj uci.tmpfile (dir (search)))
      (allow subj uci.tmpfile (file (getattr read open lock)))
      (call .sys.search_sysctlfile_dirs (subj))
      (allow subj net.sysctlfile (file (write open)))
      (call .net.search_sysctlfile_dirs (subj))
      (call .iproute2.readwrite_conffile_dirs (subj))
      (call .dnsmasq.search_tmpfile_dirs (subj))
      (call .iproute2.manage_conffile_files (subj))
      (call .qcmap_cm.execute_conffile_files (subj))
      (call .qcmap_cm.subj_type_transition (subj))
      (allow subj .nftables.execfile (file(read open execute getattr map)))
      (call .nftables.subj_type_transition (subj))
      (call .kmsg.readwrite_nodedev_chr_files (subj))
      (call .conntrack.read_execfile_files (subj))
      (call .conntrack.mapexecute_execfile_files (subj))
      (call .conntrack.subj_type_transition (subj))
      (allow subj hotplugcall.subj (fd( use )))
      (call .dnsmasq.manage_tmpfile_files (subj))
      (call .dnsmasq.readwrite_tmpfile_dirs (subj))
      ;; Need read and open permission for osrelease file
      (allow subj .osrelease.miscfile (file (read open)))

      ;;Need create permission for pbr.lock
      (allow subj tmpfile.runtimetmpfile (file (create)))
      (allow subj tmpfile.runtimetmpfile (dir( remove_name )))
      (call .tmpfile.manage_runtimetmpfile_files (subj))
      (allow subj net.netnode (udp_socket( node_bind )))
      (allow subj net.netif (netif( egress )))
      (allow subj net.netnode (node( sendto )))

;; Need for USB to bind with configfs after exiting host mode
      (allow subj .config.fs (file (create open read write)))
      (allow subj .config.fs (dir (search add_name write)))

      ;; Need for pbr nftables files
      (call .file.readwrite_conffile_files (subj))
      (call .dnsmasq.obj_type_transition_tmpfile (subj dir "dnsmasq.d"))
      (allow subj .pppd.subj (fd (use)))


;; Need for sysfs setattr access
	(allow .hotplugcall.subj .devices.sysfile (file (setattr)))
)
