(in .configgenerate

(block configgeneratetmp

;; policy

	(blockinherit .agent.base_template))

	(allow subj self (capability (dac_read_search dac_override)))

	(call .sys.manage_rootfile_dirs (subj))

	(allow subj file.conffile (dir (setattr remove_name)))

	(dontaudit subj self (capability (sys_admin)))
)
