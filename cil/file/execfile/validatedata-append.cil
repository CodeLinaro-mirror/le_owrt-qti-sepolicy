(in .validatedata

	;; policy

	(allow subj self (capability (dac_override dac_read_search)))

	(call .qcmap_cli.use_fds (subj))
	(call .qcmap_cli.readwrite_unix_stream_sockets (subj))
	(allow .validatedata.subj .qcmap_cli.subj (fifo_file (read write ioctl)))

	(allow subj netifd.subj (netlink_route_socket( read write )))
	(allow subj netifd.subj (netlink_kobject_uevent_socket( read write )))
	(allow subj netifd.subj (fd( use )))

	;; Ezmesh specific
	(allow subj hotplugcall.subj (fd (use)))
	(allow subj hotplugcall.subj (fifo_file(write)))

	;; Ezmesh Sigma specific
	(allow subj wifi.subj (fd (use)))
	(allow subj wifi.subj (tcp_socket (read write)))
	(allow subj wifi.subj (fifo_file (write ioctl)))
	(allow subj wifi.logtmpfile (file (read append)))

	(allow subj tmpfile.runtimetmpfile (dir (search)))
)






