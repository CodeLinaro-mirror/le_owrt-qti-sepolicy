;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

(in .sys
	(call .qms.subj_type_transition (subj)))

(in .file
	(call .qms.obj_type_transition_datafile (unconfined.subj_typeattr))
	(call .qms.obj_type_transition_execfile (unconfined.subj_typeattr)))

(block qms
	(filecon
	"/usr/bin/qms"
	file
	execfile_file_context)

	(filecon
	"/dev/socket/qms"
	socket
	tmpfile_file_context)

	(filecon
	"/data/vendor/qms"
	dir
	datafile_file_context)

	(filecon
	"/data/vendor/qms/.*"
	any
	datafile_file_context)

	(filecon
	"/data/vendor/qms_logs"
	dir
	datafile_file_context)

	(filecon
	"/data/vendor/qms_logs/.*"
	any
	datafile_file_context)

	;;
	;; Macros
	;;
	(macro obj_type_transition_execfile ((type ARG1))
		(call .file.execfile_obj_type_transition
			(ARG1 execfile file "qms")))

	(macro obj_type_transition_datafile ((type ARG1))
		(call .file.datafile_obj_type_transition
			(ARG1 datafile dir "qms"))
		(call .file.datafile_obj_type_transition
			(ARG1 datafile dir "qms_logs")))

	(macro obj_type_transition_tmpfile ((type ARG1)(class ARG2)(name ARG3))
		(call .tmp.fs_obj_type_transition
			(ARG1 tmpfile ARG2 ARG3)))
	(macro qms_read_access_to_obj ((type TARGET_OBJ_TYPE))
		(allow subj TARGET_OBJ_TYPE (dir (search getattr)))
		(allow subj TARGET_OBJ_TYPE (file (getattr read open)))
		(allow subj TARGET_OBJ_TYPE (lnk_file (read getattr))))
	;;
	;; Policy
	;;
	(blockinherit .agent.base_template)
	(blockinherit .file.conf.obj_template)
	(blockinherit .file.data.obj_template)
	(blockinherit .tmpfile.obj_template)

	(allow subj self (capability (net_admin dac_read_search chown)))

	(call obj_type_transition_tmpfile (subj sock_file "qms"))
	(allow subj self create_qipcrtr_socket)

	(allow subj self create_netlink_socket)
	(allow subj self create_netlink_generic_socket)
	(allow subj self create_netlink_route_socket)
	(allow subj self (netlink_socket (read write)))
	(allow subj self (netlink_route_socket (read write nlmsg_write nlmsg_read)))

	(allow subj self create_udp_socket)
	(allow subj self create_unix_dgram_socket)
	(call qms.sendto_unix_dgram_sockets (subj))
	(allow subj self create_unix_stream_stream_socket)
	(call qms.connectto_unix_stream_sockets(subj))
	(allow subj self (unix_stream_socket (sendto)))

	(allow subj self create_tipc_socket)

	(call diag-router.connectto_unix_stream_sockets(subj))

	(allow subj logd.miscfile (sock_file (write)))
	(call logd.sendto_unix_dgram_sockets (subj))

	(allow subj .qcmap_cm.runtimetmpfile (dir (search write add_name)))
	(allow subj .qcmap_cm.runtimetmpfile (file (create read write append open)))

	(allow subj .tmpfile.runtimetmpfile (dir (search)))
	(allow subj .tmpfile.conftmpfile (dir (search)))

	(allow subj leprop.miscfile (sock_file (read write)))
	(call leprop.connectto_unix_stream_sockets(subj))

	(allow subj .ssl.conftmpfile (dir (search)))
	(allow subj .ssl.conftmpfile (file (read getattr open)))

	(allow subj .ssl.certfile (dir (search read open getattr)))
	(allow subj .ssl.certfile (file (read open getattr)))

	(allow subj .wifi.datafile (dir (search)))
	(allow subj .wifi.datafile (sock_file (getattr)))

	(allow subj .tmp.fs (dir (remove_name)))
	(allow subj qms.tmpfile (sock_file (create setattr unlink write)))

	;; Manage files in /data/vendor/
	(call .qms.manage_datafile_dirs (subj))
	(call .qms.manage_datafile_files (subj))

	(allow subj kernel.sysfile (dir (search)))

	;; To execute /usr/sbin/wpa_cli
	(call .wpad.subj_type_transition (subj))
	(allow subj .wpad.execfile (file (getattr execute read open)))

	(call .selinux.search_conffile_dirs (subj))
	(call .selinux.getattr_filesystems (subj))
	(allow subj .locale.miscfile (file (getattr map open read)))

	(call .fs.search_sysfile_dirs (subj))
	(call .sys.search_fs_dirs (subj))
	(allow subj .sys.fs (filesystem (getattr)))

	(allow subj shell.execfile (file (execute execute_no_trans getattr map open read)))

	(call .kpi_values.append_sysfile_files (subj))
	(allow subj .kpi_values.sysfile (file (read)))

	;;read proc fs files
	(call .proc.read_fs_files (subj))

	;; Read devices sysfile
	(call .devices.search_sysfile_dirs (subj))
	(call .devices.read_sysfile_files (subj))

	;; Read class sysfile
	(call .class.search_sysfile_dirs (subj))
	(call .class.list_sysfile_dirs(subj))
	(call .class.read_sysfile_lnk_files (subj))

	;; ssgtzd related permissions
	(call .ssgtzd_socket.manage_ssgtzd_socket_files (subj))
	(call .ssgtzd.connectto_unix_stream_sockets (subj))

	;; Allow qms to monitor thermal zone files (e.g., /sys/devices/virtual/thermal/thermal_zone11/temp)
	(call qms_read_access_to_obj (devices.sysfile)) 

	;; /data/vendor folder
	(call .file.manage_datafile_dirs (qms.subj))
	(call .file.manage_datafile_files (qms.subj))
	(allow qms.subj file.datafile (dir (add_name remove_name watch)))

	;; Access to DNS resolver temp files
	(call qms_read_access_to_obj (resolv.tmpfile)) ; Assuming resolv.tmpfile can be a subject type

	;;Allow qms.subj to getattr on xattr.fs (filesystem root)
	(allow qms.subj xattr.fs (filesystem (getattr)))

	;;Allow qms.subj to read build.prop labeled as unknown.miscfile
	(call qms_read_access_to_obj (unknown.miscfile))

	;;Allow qms.subj to search qcfirmware.miscfile directory
	(call .qcfirmware.search_miscfile_dirs (qms.subj))

	;;Allow qms.subj to read board.json labeled as file.conffile
	(call qms_read_access_to_obj (board.miscfile))
	(call qms_read_access_to_obj (file.conffile))

	;; Allow qms.subj to read Ver_Info.txt labeled as qcfirmware.miscfile
	(call .qcfirmware.read_miscfile_files (qms.subj))
	(call .module.search_sysfile_dirs (qms.subj))

	;; Covers (dir (search)) and (lnk_file (read)) from original
	(call qms_read_access_to_obj (bus.sysfile))
	(allow qms.subj bus.sysfile (dir (read open)))
	(allow qms.subj devices.sysfile (file (watch watch_reads write)))

	;; Network socket permissions for qms
	(allow qms.subj net.netnode (udp_socket (node_bind)))
	(allow qms.subj net.netif (netif (egress)))
	(allow qms.subj net.netnode (node (sendto)))
	(allow qms.subj self create_tcp_stream_socket)

	;; Standard named permission set (covers more than just create/connect to self)
	(allow qms.subj http.netport (tcp_socket (name_connect)))
	(allow qms.subj httpproxy.netport (tcp_socket (name_connect)))

	;; Allow qms.subj to set socket options and write to its own tcp_socket
	(allow qms.subj qms.subj (tcp_socket (setopt write read bind getattr)))
	(allow qms.subj tmp.fs (chr_file (read open write getattr map ioctl)))

	;; Allow qms.subj to access microdump sysfs nodes and also enable microdump (e.g /sys/module/microdump_collector/parameters/enable_microdump)
	(allow qms.subj module.sysfile (file (open read write setattr)))
	(allow qms.subj firmware.sysfile (dir (search)))
	(allow qms.subj firmware.sysfile (file (open read getattr)))
	(allow qms.subj self (netlink_kobject_uevent_socket (create setopt bind getattr write read)))
	(allow qms.subj file.execfile (file (read open execute getattr execute_no_trans map)))
	(allow qms.subj nameservice.miscfile (file (open getattr read)))
	;; Allow qms.subj to run coresight_reset_source_sink.sh to reset and reconfigure Coresight connections at runtime.
	(allow qms.subj file.conffile (file (execute)))
	;; Allow qms to connect to DNS netport
	(allow qms.subj dns.netport (tcp_socket (name_connect)))

	(dontaudit subj self (capability (sys_admin)))
)

