(in .nftables

;; policy

(allow subj .sys.subj (fifo_file (read)))
(allow subj .qcmap_ref.subj (fd(use)))
(allow subj .qcmap_ref.subj (unix_stream_socket(read write)))
(allow subj .qcmap_cli.subj (fd(use)))
(allow subj .qcmap_cli.subj (unix_stream_socket(read write)))
(allow subj .qcmap_cli.subj (fifo_file(read write)))
(allow subj .qcmap_ref.subj (netlink_route_socket(read write)))
(allow subj .qcmap_ref.subj (fifo_file(read write)))
(allow subj .netifd.subj (fifo_file(write)))
;; Need permission for /dev/null
(allow subj .hotplugcall.subj (fd (use)))
(allow subj .rcfirewall.subj (fd (use)))
(allow subj .hotplugcall.subj (fifo_file(read write ioctl)))
;; Need permission for pppd
(allow subj .pppd.subj (fd (use)))
(call .file.read_datafile_files (subj))
(call .tmpfile.read_runtimetmpfile_files (subj))
(call .tmpfile.search_runtimetmpfile_dirs (subj))
(dontaudit subj nftables.subj (capability (dac_read_search sys_admin)))
)

