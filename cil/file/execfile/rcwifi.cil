(in .sys
    (call .rcwifi.subj_type_transition (subj)))

(in .file
    (call .rcwifi.obj_type_transition_initscriptfile
          (unconfined.subj_typeattr)))

(block rcwifi

       ;;
       ;; Contexts
       ;;

       (filecon
        "/etc/init\.d/wlan_services\.init"
        file
        initscriptfile_file_context)

       ;;
       ;; Macros
       ;;

       (macro obj_type_transition_initscriptfile ((type ARG1))
              (call .file.initscriptfile_obj_type_transition
                    (ARG1 initscriptfile file "wlan_services.init")))

       ;;
       ;; Policy
       ;;

       (blockinherit .initscript.base_template)

       ;; Need chown on /data/vendor/wifi
       (allow subj self (capability (chown)))

       ;; Need to print log to /dev/kmsg
       (allow subj .kmsg.nodedev (chr_file (open write)))

       ;; Need manage on /data/vendor/wifi
       (call .wifi.manage_datafile_dirs (subj))
       (call .wifi.manage_datafile_files (subj))

       ;; Need manage on /tmp/run/wlan_services.pid
       (call .wifi.manage_runtimetmpfile_files (subj))
)
