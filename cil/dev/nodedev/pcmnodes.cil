;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

(in .dev
    (call .snd.obj_type_transition_nodedev (unconfined.subj_typeattr)))

(block snd

       ;;
       ;; Contexts
       ;;

       (filecon
        "/dev/snd"
        dir
        nodedev_file_context)


       (filecon
        "/dev/snd/.*"
        char
        nodedev_file_context)

       (filecon
        "/dev/aud_pasthru_modem"
        char
        nodedev_file_context)

       (filecon
        "/dev/msm_audio_ion"
        char
        nodedev_file_context)

       ;;
       ;; Macros
       ;;
       (macro obj_type_transition_nodedev ((type ARG1))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev dir  "snd"))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev chr_file "pcmC0D3p"))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev chr_file "pcmC0D4p"))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev chr_file "aud_pasthru_modem"))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev chr_file "msm_audio_ion")))
       ;;
       ;; Policy
       ;;

       (blockinherit .dev.node.obj_template))
