(in .sys
    (call .port-bridge.subj_type_transition (subj)))

(in .file
    (call .port-bridge.obj_type_transition_execfile (unconfined.subj_typeattr))
    (call .port-bridge.obj_type_transition_tmpfile (unconfined.subj_typeattr chr_file "at_mdm0"))
    (call .port-bridge.obj_type_transition_tmpfile (unconfined.subj_typeattr chr_file "at_usb0"))
    (call .port-bridge.obj_type_transition_tmpfile (unconfined.subj_typeattr chr_file "mhi_pipe_32"))
)

(block port-bridge
        (filecon
        "/usr/bin/port-bridge"
        file
        execfile_file_context)

        (filecon
         "/dev/mhi_pipe_32"
         char
         tmpfile_file_context)

        (filecon
         "/dev/at_usb0"
         char
         tmpfile_file_context)

         (filecon
         "/dev/at_mdm0"
         char
         tmpfile_file_context)

        ;;
        ;; Macros
        ;;
        (macro obj_type_transition_execfile ((type ARG1))
              (call .file.execfile_obj_type_transition
                        (ARG1 execfile file "port-bridge")))

        (macro obj_type_transition_tmpfile ((type ARG1)(class ARG2)(name ARG3))
               (call .tmp.fs_obj_type_transition
                           (ARG1 tmpfile ARG2 ARG3)))



        ;;
        ;; Policy
        ;;
        (blockinherit .agent.base_template)
        (blockinherit file.conf.obj_template)
        (blockinherit .tmpfile.runtime.obj_template)
        (blockinherit file.data.obj_template)
        (blockinherit .tmpfile.obj_template)

        (call .shell.mapexecute_execfile_files(subj))
        (call .shell.read_execfile_files (subj))
        (call .fs.search_sysfile_dirs (subj))
        (call .devices.readwrite_sysfile_files (subj))
        (call .devices.search_sysfile_dirs (subj))
        (call .sys.search_fs_dirs (subj))
        (call .selinux.getattr_filesystems(subj))
        (call .selinux.search_conffile_dirs (subj))

        (dontaudit subj .shell.execfile (file (execute_no_trans open read execute)))
        (allow subj file.conffile (dir (search)))
        (allow subj .qcmap_cm.conffile (dir (search)))
        (allow subj .qcmap_cm.conffile (file (read open write)))
        (allow subj port-bridge.tmpfile (chr_file (open read write ioctl getattr)))
        (allow subj .qti.nodedev (chr_file (getattr read )))
        (allow subj self create_unix_stream_stream_socket)

        ;; Allow full access to USB FunctionFS directory and files
        (allow subj .usb_ffs.nodedev (dir (search read open getattr)))
        (allow subj .usb_ffs.nodedev (file (read write open getattr)))

        ;; Allow access to /sys/class directory and subdirectories
        (allow subj .class.sysfile (dir (search read open getattr)))

        ;; Allow access to /sys/kernel directory
        (allow subj .kernel.sysfile (dir (search read open getattr)))

        ;; Allow access to configfs for USB gadget configuration
        (allow subj .config.fs (dir (search read open getattr)))
        (allow subj .config.fs (file (read write open getattr)))

        ;; Allow ubus calls
        (allow subj .tmpfile.runtimetmpfile (dir (search)))
        (allow subj .ubusd.runtimetmpfile (dir (search)))
        (allow subj .ubusd.runtimetmpfile (sock_file (read write)))
        (allow subj ubusd.subj (unix_stream_socket (connectto)))
)
