;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-


(in .sys
    (call .diag-router.subj_type_transition (subj)))

;(in .file
 ;   (call .diag-router.obj_type_transition_execfile (unconfined.subj_typeattr)))

(block diag-router
	;;
	;; Contexts
	;;
	(filecon
		"/usr/bin/diag-router"
		file
		execfile_file_context)
	;;
	;; Macros
       ;;
		(macro obj_type_transition_execfile ((type ARG1))
			(call .file.execfile_obj_type_transition
				(ARG1 execfile file "diag-router")))

		(macro unix_stream_connect ((type ARG1))
              (call connectto_unix_stream_sockets (ARG1)))

	;;
	;; Policy
       ;;
       (blockinherit .agent.base_template)

	;; search in config files is needed
	;;which is done on start /Stop  of services
	   (call .file.search_conffile_dirs (subj))

	;;search sysfs files
	(call .sys.search_fs_dirs (subj))
	(call .kernel.search_sysfile_dirs (subj))

	;; Need qipcrtr socket creations
	   (allow subj  self  create_qipcrtr_socket)

	;; Needed for  unix_dgram socket creation
	   (allow subj self create_unix_dgram_socket)

	;;Needed for creating of unix stream socket
	   (allow subj self create_unix_stream_stream_socket)

	;;Needed for invalid and unlabed deniels
	(allow subj .invalid readwrite_dir)
	(allow subj .invalid readwrite_file)
	(allow subj self (unix_dgram_socket (sendto)))

	;; TODO:we will allow this for intial version will remove later
           (allow subj self (capability (dac_override dac_read_search)))

	;; Need creat and read of this uevent socket
	   (allow subj self create_netlink_kobject_uevent_socket)

	;;need for /dev/logd or logging
	;; this will add write permission also
	   (call .logd.unix_dgram_send(subj))

	;; search  /dev tree .
	(call .devices.search_sysfile_dirs (subj))
	(call .devices.read_sysfile_files (subj))

	(allow subj .devices.sysfile (file (open)))

	;;(blockinherit .file.exec.obj_template)
	(allow subj .kpi_values.sysfile readwrite_file)

	(allow subj .qti.nodedev (chr_file (open read write)))

	;; allow signal and kill capability
	(allow subj .sys.subj (process (signal)))
	(allow subj self (capability (kill)))

	;; search /sys/bus tree and allow read and write for qdss nodes :
	;; out_mode, enable_source, curr_sink, enable_sink etc"
	(allow subj .bus.sysfile (dir (search)))
	(allow subj .bus.sysfile (lnk_file (read)))
	(allow subj .devices.sysfile (file ( write)))
)

(block kpi_values

       ;;
       ;; Contexts
       ;;

     (genfscon
        "sysfs"
        "/kernel/boot_kpi/kpi_values"
        sysfile_file_context)

    (blockinherit .sysfile.module.obj_template))

(in .sysfile

    (block kpi_values

           ;;
           ;; Policy
           ;;

           (blockinherit .file.obj_all_macro_template)

           ;;
           ;; Templates
           ;;

           (block obj_base_template

                  ;;
                  ;; Policy
                  ;;

                  (blockabstract obj_base_template)

                  (blockinherit .sysfile.obj_base_template)

                  (call .sysfile.kpi_values.obj_type (sysfile)))

           (block obj_template

                  ;;
                  ;; Policy
                  ;;

                  (blockabstract obj_template)

                  (blockinherit .sysfile.kpi_values.obj_base_template)
                  (blockinherit .sysfile.obj_macro_template))))
