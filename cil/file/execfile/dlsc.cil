(in .sys
	(call .dlsc.subj_type_transition (subj)))

(in .file
	(call .dlsc.obj_type_transition_execfile (unconfined.subj_typeattr)))

(block dlsc
	(filecon
	"/usr/bin/dlsc"
	file
	execfile_file_context)

	;;
	;; Macros
	;;
	(macro obj_type_transition_execfile ((type ARG1))
		(call .file.execfile_obj_type_transition
			(ARG1 execfile file "dlsc")))

	;;
	;; Policy
	;;
	(blockinherit .agent.base_template)
	(blockinherit file.data.obj_template)
	(blockinherit file.conf.obj_template)
	(blockinherit .tmpfile.runtime.obj_template)
	(blockinherit .tmpfile.obj_template)

	(allow subj self (capability (net_admin)))

	(allow subj self create_qipcrtr_socket)

	;; Need permission for ifconfig
	(allow subj .sys.subj (system (module_request)))

	(call .fs.search_sysfile_dirs (subj))
	(call .sys.search_fs_dirs (subj))

	;; Need search on selinux dir
	(call .selinux.search_conffile_dirs (subj))
	(call .selinux.getattr_filesystems (subj))
	(allow subj .locale.miscfile (file (read getattr open map)))

	;; Need for busybox read, open, execute
	(call .shell.execute_execfile_files (subj))

	(call .logd.unix_dgram_send (subj))

	(call .diag-router.connectto_unix_stream_sockets (subj))

	(call .tlpd.connectto_unix_stream_sockets (subj))

	(allow subj .qcmap_cm.conffile (dir (search)))
	(allow subj .qcmap_cm.conffile (file (read open getattr)))
	(allow subj .qcmap_cm.runtimetmpfile (dir (search)))
	(allow subj .qcmap_cm.runtimetmpfile (sock_file (read write)))

	(allow subj tmpfile.conftmpfile (dir (search)))
	(allow subj .tmpfile.runtimetmpfile (dir (search)))

	(allow subj file.conffile (dir (search)))
	(allow subj file.conffile (lnk_file (read write getattr)))

	(allow subj ssl.conftmpfile (dir (search)))
	(allow subj ssl.conftmpfile (file (open getattr read)))
	(allow subj ssl.certfile (dir (search read open getattr)))
	(allow subj ssl.certfile (file (read open)))

	(allow subj self create_netlink_route_socket)
	(allow subj self create_udp_socket)
	(allow subj self create_unix_dgram_socket)
	(allow subj self create_unix_stream_socket)
	(allow subj self create_netlink_socket)
	(allow subj self (netlink_route_socket (nlmsg_read)))

	(allow subj .net.procfile (lnk_file (read)))
	(allow subj .net.procfile (file (read open getattr)))

)

