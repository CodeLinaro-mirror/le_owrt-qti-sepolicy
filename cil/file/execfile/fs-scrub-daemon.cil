;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-


(in .sys
    (call .fs-scrub-daemon.subj_type_transition (subj)))

;(in .file
 ;   (call .fs-scrub-daemon.obj_type_transition_execfile (unconfined.subj_typeattr)))
(in .file
	(call .fs-scrub-daemon.obj_type_transition_datafile (unconfined.subj_typeattr dir fs_scrub)))

(block fs-scrub-daemon
	;;
	;; Contexts
	;;
	(filecon
		"/usr/bin/fs-scrub-daemon"
		file
		execfile_file_context)
	(filecon
		"/data/fs_scrub"
		dir
		datafile_file_context)
	(filecon
		"/data/fs_scrub/.*"
		any
		datafile_file_context)

	;;
	;; Macros
	;;
		(macro obj_type_transition_execfile ((type ARG1))
			(call .file.execfile_obj_type_transition
				(ARG1 execfile file "fs-scrub-daemon")))

		(macro obj_type_transition_datafile ((type ARG1)(class ARG2)(name ARG3))
			(call .file.datafile_obj_type_transition
				(ARG1 datafile ARG2 ARG3)))
	;;
	;; Policy
	;;
	(blockinherit .agent.base_template)
	(blockinherit file.data.obj_template)
	(call obj_type_transition_datafile (subj dir "fs_scrub"))
	   ;; search in config files is needed
	   ;;which is done on start /Stop  of services
	   (call .file.search_conffile_dirs (subj))

	   ;; Need qipcrtr socket creations
	   (allow subj  self  create_qipcrtr_socket)

	   ;; Needed for  unix_dgram socket creation
	   (allow subj self create_unix_dgram_socket)

	   ;; needed for writing to dev/kmsg
	   (call .kmsg.readwrite_nodedev_chr_files (subj))

	   ;; Needed for searching sysfs
	   (call .sys.search_fs_dirs (subj))

           (call .logd.sendto_unix_dgram_sockets (subj))
           (call .power.append_sysfile_files(subj))
           (allow subj class.sysfile ( dir ( read open)))
           (allow subj devices.sysfile ( file ( read open)))

           (call .class.read_sysfile_lnk_files (subj))

	;;(blockinherit .file.exec.obj_template)

	;;Latest denials
        (allow subj logd.miscfile (sock_file ( write)))
	(allow subj fs-scrub-daemon.datafile (dir ( write add_name remove_name search)))
	(allow subj class.sysfile (dir ( search)))
	(allow subj devices.sysfile (dir ( search)))
	(allow subj devices.sysfile (file ( write)))
	(allow subj fs-scrub-daemon.datafile (file ( read create write open rename
	unlink getattr )))
	(allow subj tmp.fs (chr_file ( getattr)))
	(allow subj mtd.stordev (chr_file ( open ioctl getattr )))
	(dontaudit subj mtd.stordev (chr_file ( read )))

)

(block fs_scrub
	(genfscon
		"sysfs"
		"/sys/class/ubi/ubi[0-9]/scrub_all"
		sysfile_file_context)
	(blockinherit .sysfile.module.obj_template))

(in .sysfile
	(block fs_scrub

	;;
	;; Policy
	;;
	(blockinherit .file.obj_all_macro_template)

	;;
	;; Templates
	;;
	(block obj_base_template

		;;
		;; Policy
		;;

		(blockabstract obj_base_template)
		(blockinherit .sysfile.obj_base_template)
		(call .sysfile.fs_scrub.obj_type (sysfile)))

	(block obj_template

		;;
		;; Policy
		;;

		(blockabstract obj_template)
		(blockinherit .sysfile.fs_scrub.obj_base_template)
		(blockinherit .sysfile.obj_macro_template))))
