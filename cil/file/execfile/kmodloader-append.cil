(in .kmodloader

;; policy

  (allow subj .invalid search_dir)
  (allow subj self (lockdown (all)))
  (allow subj .wifi.subj (fd (use)))

  ;; Write /tmp/.wireless.tmp
  (allow subj .wifi.tmpfile (file (write)))

  ;;
  (allow subj .qcmap_cli.subj (fd (use)))
  (allow subj .qcmap_cli.subj (unix_stream_socket (read write)))
  (allow subj .qcmap_cli.subj readwriteinherited_fifo_file)
  (allow subj .qcmap_cli.subj (netlink_route_socket( read write )))
  (allow subj .qcmap_ref.subj (fd (use)))
  (allow subj .qcmap_ref.subj (unix_stream_socket (read write)))
  (allow subj .qcmap_ref.subj readwriteinherited_fifo_file)
  (allow subj .qcmap_ref.subj (netlink_route_socket( read write )))

  ;; IPQ sigma_dut
  (allow subj .wifi.subj (tcp_socket (read write)))
  (allow subj .wifi.logtmpfile readwrite_file)

  (allow subj .sys.subj (system (module_request)))

  ;; IPQ ctrl_app_dut
  (allow subj .wifi.subj readwrite_udp_socket)
  (allow subj .wifi.tmpfile readwrite_file)
)



