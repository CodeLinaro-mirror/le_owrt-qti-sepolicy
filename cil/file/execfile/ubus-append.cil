(in .ubus

;; policy

(allow subj self create_unix_stream_stream_socket)

(allow subj ucode.subj (fd (use)))
(allow subj ucode.subj (fifo_file (write ioctl)))
(allow subj fw3.datafile (file (read)))

(call .qcmap_cli.use_fds (subj))
(allow subj self (capability (dac_read_search)))
(call .qcmap_cli.readwrite_unix_stream_sockets (subj))
(allow .ubus.subj .qcmap_cli.subj (fifo_file (read write ioctl)))
;; Need manage on /tmp/ipv{4/6}config[0-9]+
(call .qcmap_cli.manage_tmpfile_files (subj))

(allow subj .wifi.subj (fifo_file (write ioctl)))
;; Need manage on /tmp/ipv{4/6}config[0-9]+
(call .qcmap_ref.manage_tmpfile_files (subj))
(call .qcmap_ref.use_fds (subj))
(call .qcmap_ref.readwrite_unix_stream_sockets (subj))
(allow .ubus.subj .qcmap_ref.subj (fifo_file (read write ioctl)))
;; Need append on /tmp/resolve.conf
(call .resolv.append_tmpfile_files (subj))
(allow subj .kmsg.nodedev (chr_file (open write ioctl)))
(call .fw3.write_runtimetmpfile_files (subj))

;; odhcp6c Need run ifstatus which use ubus
(allow .ubus.subj .odhcp6c.subj (fifo_file (read write ioctl)))

;; IPQ sigma_dut
(allow subj .wifi.logtmpfile readwrite_file)
(allow subj .wifi.subj readwrite_tcp_socket)

;; Ref daemon netlink thread
(allow subj qcmap_ref.subj (netlink_route_socket (read write)))

(allow subj odhcpd.subj (rawip_socket (read write)))

;; For QCMAP 'Activate supplicant'
(allow subj .netifd.subj (netlink_route_socket (read write)))
(allow subj .netifd.subj (netlink_kobject_uevent_socket (read write)))
;;open/write pmsg_dev.nodedev
(allow subj .pmsg_dev.nodedev (chr_file (write open)))

;; IPQ ctrl_app_dut
(allow subj .wifi.subj readwrite_udp_socket)
(allow subj .wifi.tmpfile readwrite_file)

;; Need manage on /tmp/ipv{4/6}config[0-9]+
(call .qcmap_cm.manage_tmpfile_files (subj))

;; Speedtest related permissions
(allow subj qcmap_cm.subj (unix_dgram_socket( read write )))
(call .tmp.read_fs_files (subj))

;; Need permission for ubus
(allow subj qcmap_cm.subj (udp_socket (read write)))
(allow subj sys.subj (packet_socket (read write)))
(allow subj sys.subj (netlink_socket (read write)))
(allow subj sys.subj (unix_stream_socket (read write)))
(allow subj sys.subj (netlink_kobject_uevent_socket (read write)))

;; Need permission for pppd
(allow subj .pppd.subj (fifo_file (write ioctl)))

(allow subj ipv6.sysctlfile (file (read)))
(allow subj qcmap_cm.runtimetmpfile (file (read write)))
(allow subj qcmap_cm.conffile (file (read)))
(allow subj resolv.tmpfile (file (read)))

;;STC
(allow subj qcmap_cm.subj readwrite_tcp_socket)
(allow subj qcmap_cm.subj readwrite_netlink_netfilter_socket)

(call .ipa.readwrite_nodedev_chr_files (subj))
(dontaudit subj self (capability (sys_admin)))
)
