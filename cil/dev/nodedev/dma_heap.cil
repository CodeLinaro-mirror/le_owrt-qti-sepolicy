;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

(in .dev
    (call .dma_heap.obj_type_transition_nodedev (unconfined.subj_typeattr)))

(block dma_heap

       ;;
       ;; Contexts
       ;;

       (filecon
        "/dev/dma_heap"
        dir
        nodedev_file_context)

      
       (filecon
        "/dev/dma_heap/.*"
        char
        nodedev_file_context)

       ;;
       ;; Macros
       ;;
       (macro obj_type_transition_nodedev ((type ARG1))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev dir  "dma_heap"))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev chr_file "system"))
              (call .tmp.fs_obj_type_transition
                    (ARG1 nodedev chr_file "qcom,system")))
       ;;
       ;; Policy
       ;;

       (blockinherit .dev.node.obj_template))
