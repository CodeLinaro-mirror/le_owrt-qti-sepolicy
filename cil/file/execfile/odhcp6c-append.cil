(in .odhcp6c

    (filecon
    "/tmp/ipv6config.*"
    file
    tmpfile_file_context)

     ;;macros
   (macro obj_type_transition_tmpfile ((type ARG1)(class ARG2)(name ARG3))
        (call .tmp.fs_obj_type_transition
            (ARG1 tmpfile ARG2 ARG3)))

    (macro obj_type_transition_tmpfile_ext ((type ARG1))
        (call obj_type_transition_tmpfile (ARG1 file "ipv6config.wanwlan"))
        (call obj_type_transition_tmpfile (ARG1 file "ipv6config.wanusb"))
        (call obj_type_transition_tmpfile (ARG1 file "ipv6config.wanbt"))
        (call obj_type_transition_tmpfile (ARG1 file "ipv6config.waneth"))
        (call obj_type_transition_tmpfile (ARG1 file "ipv6config.lan"))
    )

    ;;policy
    (blockinherit .tmpfile.obj_template)
    (call obj_type_transition_tmpfile_ext (subj))
    (allow subj mwan3.tmpfile (fifo_file (write open)))
    (call .nameservice.read_miscfile_files (subj))
    (allow subj self create_rawip_socket)
    (allow subj self (capability (net_admin)))
    (allow odhcpd.update.subj odhcpd.subj (rawip_socket (read write)))
    (call .qcmap_cm.search_conffile_dirs (subj))
    (call .qcmap_cm.readwrite_conffile_files (subj))
    (call .qcmap_cm.execute_conffile_files (subj))
    (allow subj odhcp6c.tmpfile (file (create write open append read getattr)))
    ;; Need domian transition
    (call .qcmap_cm.subj_type_transition (subj))
    (call .uci.subj_type_transition (subj))
    (call .netifd.read_miscfile_files (subj))
    (allow qcmap_cli.subj odhcp6c.tmpfile (file (getattr read open)))
    (allow qcmap_ref.subj odhcp6c.tmpfile (file (getattr)))
    (allow subj qcmap_ref.tmpfile (file (getattr read open)))
    (allow subj .netifd.miscfile (dir (read open)))
    (allow subj .tmp.fs (dir (remove_name)))
    (allow subj odhcp6c.tmpfile (file (unlink)))

    ;; Need permissions write log from backhaulCommonConfig.sh
    (call .qcmap_cm.search_datafile_dirs (subj))
    (allow subj .qcmap_cm.datafile (file (append open)))

    ;; Need permissoins to run ifstatus from odhcp6c
    (allow ifstatus.subj odhcp6c.subj (unix_stream_socket (read write)))
    (allow ifstatus.subj odhcp6c.subj readwriteinherited_fifo_file)
    (allow ifstatus.subj odhcp6c.subj (fd (use)))
    (allow subj .ifstatus.execfile (file (execute read open getattr)))
    (call .ifstatus.subj_type_transition (subj))
    ;; Need permissions to run brctl command
    (allow subj .class.sysfile (lnk_file (read)))
    (allow subj .class.sysfile (dir (read open search)))
    ;; Need reload firewall anc access init.d from odhcp6c
    (allow subj .file.initscriptfile (dir (read search)))
    (call .rcfirewall.subj_type_transition (subj))

    ;; Need obj_type_transition for /etc/firewall.user.*
    (call .firewall.obj_type_transition_conffile_ext (subj))

    ;; Need read open on /sys/devices/soc0/platform_subtype_id and run brctl command
    (allow subj .devices.sysfile (dir (search read open)))
    (allow subj .devices.sysfile (file (read open)))

    ;; Need transition to run odhcpd reload
    (call .rcodhcpd.subj_type_transition (subj))
    (allow subj .rcodhcpd.initscriptfile (file (getattr execute read open)))

    ;; Need transition to run dnsmasq reload
    (call .rcdnsmasq.subj_type_transition (subj))

    ;;Need for single route feature
    (allow subj resolv.tmpfile (file (getattr read append write open create ioctl setattr rename unlink)))
    (allow subj resolv.tmpfile (dir (search write add_name remove_name)))

    ;; Need permission for backhaul status indicate feature
    (call .file.read_conffile_lnk_files (subj))
    (call .ip.execute_execfile_files (subj))
    (call .iproute2.search_conffile_dirs (subj))
    (call .iproute2.readwrite_conffile_files (subj))
    (allow subj self (netlink_route_socket (nlmsg_read nlmsg_write)))
    (allow subj .netifd.tmpfile (file (getattr read open append create)))
    (allow subj .qcmap_cm.subj (process (signal)))
    (allow subj .odhcp6c.subj (capability (kill)))
    (call .iw.subj_type_transition (subj))
    (allow subj self (netlink_generic_socket(create)))
    (allow iw.subj odhcp6c.subj (fd (use)))
    (allow iw.subj odhcp6c.subj (fifo_file (read write ioctl)))

    ;; Need permission for proc/pidof QCMAP_ConnectionManager from backhaulCommonConfig.sh
    (allow subj .proc.fs (dir (read open)))
    (allow subj .proc.fs (file (read open)))
    (allow subj .qcmap_cm.subj (dir (search open read)))
    (allow subj .qcmap_cm.subj (file (open read)))
    (allow subj .qcmap_cm.subj (lnk_file (read)))
    (call .qcmap_cm.search_runtimetmpfile_dirs (subj))
    (call .qcmap_cm.write_runtimetmpfile_dirs (subj))
    (call .qcmap_cm.create_runtimetmpfile_files (subj))
    (call .qcmap_cm.read_runtimetmpfile_files (subj))
    (call .qcmap_cm.write_runtimetmpfile_files (subj))
    (allow subj .netifd.tmpfile (file (write)))
    (allow subj .sys.subj (dir (search)))
    (allow subj .sys.subj (file (read open)))
    (allow subj .sys.subj (lnk_file (read open)))
    (allow subj .ubusd.subj (dir (search)))
    (allow subj .ubusd.subj (file (read open)))
    (allow subj .ubusd.subj (lnk_file (read open)))
    (allow subj .urngd.subj (dir (search)))
    (allow subj .urngd.subj (file (read open)))
    (allow subj .urngd.subj (lnk_file (read open)))
    ;; Need to create netlink_netfilter_socket
    (allow subj self create_netlink_netfilter_socket)

    ;; Need permissions for sed and pidof
    (allow subj tftp_server.subj (dir (search)))
    (allow subj qwesd.subj (dir (search)))
    (allow subj diag-router.subj (dir (search)))
    (allow subj qseecomd.subj (dir (search)))
    (allow subj leprop.subj (dir (search)))
    (dontaudit subj self (capability (sys_ptrace)))
    (call .tmp.manage_fs_files (subj))
    ;; Need permission for /tmp/default.route.v6.listHPjeNc
    (allow subj tftp_server.subj (file (read)))
    (allow subj qwesd.subj (file (read)))
    (allow subj diag-router.subj (file (read)))
    (allow subj qseecomd.subj (file (read)))
    (allow subj uhttpd.subj (dir (search)))
    (allow subj leprop.subj (file (read)))
    (allow subj netifd.subj (dir (search)))
    (allow subj logd.subj (dir (search)))
    (allow subj rpcd.subj (dir (search)))

    ;; Need permission for awk and backhaulCommonC
    (allow subj resolv.tmpfile (dir (search)))
    (allow subj .qcmap_cm.tmpfile (file (read open getattr)))

    ;; Need permission for pidof
    (allow subj csd_server.subj (dir (search)))
    (allow subj .qcmap_cm.tmpfile (dir (search)))

    ;; Need permission for ip6tables and odhcpd
    (allow subj .rccommon.conffile (file (read)))
    (allow subj .tmpfile.locktmpfile (dir (search)))
    (allow subj .tmpfile.locktmpfile (file (open)))

    ;; Need for tinyproxy
    (call .rctinyproxy.execute_initscriptfile_files (subj))
    (call .rctinyproxy.subj_type_transition (subj))
    (allow subj .tinyproxy.subj (dir (search read open getattr)))
    (allow subj .tinyproxy.subj (file (read open)))
    (allow subj .tinyproxy.subj (lnk_file (read open)))
    (allow subj .tmpfile.logtmpfile (dir (search getattr read open write remove_name)))
    (allow subj .tinyproxy.logtmpfile (file (getattr unlink)))
)
