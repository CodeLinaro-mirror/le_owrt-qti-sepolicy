(in .xtables

  (call .sys.readinherited_fifo_files (subj))
  ;; Need permission to run iptables in netifd script
  (allow subj .netifd.subj readwriteinherited_fifo_file)
  (allow subj self create_netlink_netfilter_socket)
  (allow subj .qcmap_ref.subj (fd (use)))
  (allow subj .qcmap_ref.subj readwriteinherited_fifo_file)
  (allow subj .qcmap_ref.subj (unix_stream_socket (read write)))
  ;; Need for adding iptable-save
  (allow subj .locale.miscfile (file (read open getattr map)))
  ;; Add rule for fw3 sub
  (allow subj .fw3.subj (fifo_file (read write ioctl)))
  (allow subj .qcmap_ref.subj (netlink_route_socket (read write)))
  (allow subj .fw3.subj (fifo_file (write)))
  (allow subj .fw3.subj (fifo_file (ioctl)))
  ;;open/write pmsg_dev.nodedev
  (allow subj .pmsg_dev.nodedev (chr_file (write open)))
  (allow subj .ucode.subj (fd (use)))
  ;;Need permission for fw3
  (allow subj fw3.datafile (file (read)))
  ;;Need permission for odhcp6c
  (allow subj odhcp6c.subj (fd (use)))
  ;;Need permission for ip6tables
  (allow subj .iproute2.conffile (dir (search)))
)
