;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

(in .sys
    (call .mbim.subj_type_transition (subj)))

(in .file
    (call .mbim.obj_type_transition_datafile (unconfined.subj_typeattr))
    (call .mbim.obj_type_transition_runtimetmpfile (unconfined.subj_typeattr)))

(block mbim
        ;;
        ;; Contexts
        ;;
        (filecon
         "/usr/bin/mbimd"
         file
         execfile_file_context)

        (filecon
         "/data/mbimd"
         dir
         datafile_file_context)

        (filecon
         "/data/mbimd/.*"
         any
         datafile_file_context)

        (filecon
         "/tmp/run/mbim"
         dir
         runtimetmpfile_file_context)

        (filecon
         "/tmp/run/mbim/.*"
         any
         runtimetmpfile_file_context)

        ;;
        ;; Macros
        ;;
        (macro obj_type_transition_execfile ((type ARG1))
            (call .file.execfile_obj_type_transition
                (ARG1 execfile file "mbimd")))

        (macro obj_type_transition_datafile ((type ARG1))
            (call .file.datafile_obj_type_transition
                (ARG1 datafile dir "mbimd")))

        (macro obj_type_transition_runtimetmpfile ((type ARG1))
            (call .tmpfile.runtimetmpfile_obj_type_transition
                (ARG1 runtimetmpfile dir "mbim")))

        ;;
        ;; Policy
        ;;
        (blockinherit .agent.base_template)
        (blockinherit .file.data.obj_template)
        (blockinherit .file.data.obj_macro_template)
        (blockinherit .tmpfile.runtime.obj_template)

        ;; permission to create netlink_kobject_uevent_socket
        (allow subj self create_netlink_kobject_uevent_socket)

        ;; permission to read from netlink_kobject_uevent_socket
        (call .devices.read_sysfile_files (subj))

        ;; permission for unix_stream_socket, qipcrtr_socket
        (allow subj self create_unix_stream_socket)
        (allow subj self create_qipcrtr_socket)
        (allow subj diag-router.subj (unix_stream_socket (connectto)))
        (allow subj self create_unix_dgram_socket)

        (allow subj logd.miscfile (sock_file (write)))
        (allow subj logd.subj (unix_dgram_socket (sendto)))

        ;; permission to access /etc/data/mbim_mode
        (call .file.search_conffile_dirs (subj))

        (allow subj .file.conffile (lnk_file (read)))
        (allow subj .locale.miscfile (file (getattr open read map)))

        ;; permission to access all configuration files under /data/mbimd
        (call .mbim.manage_datafile_dirs (subj))
        (call .mbim.manage_datafile_files (subj))

        ;; permission to manage runtime files under /tmp/run/mbim
        (call .mbim.manage_runtimetmpfile (subj))

        ;; permission to search tmpfile.runtimetmpfile
        (call .tmpfile.search_runtimetmpfile_dirs (subj))

        ;; permission to read/write /dev/kmsg
        (call .kmsg.readwrite_nodedev_chr_files (subj))

        ;; Need search for tcontext=u:r:sys.fs tclass=dir
        (call .sys.search_fs_dirs (subj))

        ;; Permissions to search kernel sys files
        (call .kernel.search_sysfile_dirs (subj))

        ;; Permissions for /sys/power/wake_lock /sys/power/wake_unlock
        (call .power.readwrite_sysfile_files (subj))
        (call .power.search_sysfile_dirs (subj))

        ;; search  /dev tree
         (call .devices.search_sysfile_dirs (subj))

        ;; permission to read from urandom
        (call .random.read_nodedev_chr_files (subj))
        (allow subj .kpi_values.sysfile readwrite_file)
        (allow subj self (capability2 (block_suspend)))

        ;; Permissions to access fimware directory and Ver_Info.txt
        (allow subj .qcfirmware.miscfile (dir (search)))
        (allow subj .qcfirmware.miscfile (file (getattr read open)))
        (allow subj .xattr.fs (filesystem (getattr)))
        (allow subj .cache.miscfile (dir (search)))
        (allow subj .cache.miscfile (file (getattr open read)))

        ;; Permissions to access productId
        (allow subj .config.fs (dir (search)))
        (allow subj .config.fs (file (getattr read open)))

        ;; Permission to invoke init file via ubus
        (call .ubusd.readwrite_runtimetmpfile_dirs(subj))
        (call .ubusd.readwrite_runtimetmpfile_sock_files(subj))
        (allow subj ubusd.subj (unix_stream_socket (connectto)))

        ;; permission to access device nodes
        (call .android_mbim.readwrite_nodedev_chr_files (subj))
        (call .smdcntl.readwrite_nodedev_chr_files (subj))
        (call .ipa.readwrite_nodedev_chr_files (subj)))

