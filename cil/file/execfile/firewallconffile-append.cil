(in .file
    (call .firewall.obj_type_transition_conffile_ext (unconfined.subj_typeattr)))

(in .firewall

    (filecon
    "/etc/firewall\.user\.qcmap"
    file
    conffile_file_context)

    (filecon
    "/etc/firewall\.user\.qcmap\.tmp"
    file
    conffile_file_context)

    (macro obj_type_transition_conffile_ext ((type ARG1))
           (call .file.conffile_obj_type_transition(ARG1 conffile file "firewall.user.qcmap"))
           (call .file.conffile_obj_type_transition(ARG1 conffile file "firewall.user.qcmap.tmp")))

)



