;; -*- mode: CIL; fill-column: 79; indent-tabs-mode: nil; -*-

(in .file

    ;;
    ;; Contexts
    ;;

	(call .sdcard.tmp_obj_type_transition_miscfile (unconfined.subj_typeattr))

	(filecon
        "/lib"
        dir
        libfile_file_context)


    (filecon
     "/lib/.*"
     any
     libfile_file_context)

     (filecon
     "/usr/lib/libq*"
     file
     libfile_file_context)


    ;(blockinherit lib.obj_template)

    (call datafile_obj_type_transition_libfile (unconfined.subj_typeattr))
    (call obj_type_transition_libfile (unconfined.subj_typeattr))

)
(in .file
    (call .qcfirmware.rootfile_obj_type_transition_miscfile
          (unconfined.subj_typeattr)))

(in .file
    (call .persist.rootfile_obj_type_transition_miscfile
          (unconfined.subj_typeattr)))

(in .file
    (call .cache.rootfile_obj_type_transition_miscfile
          (unconfined.subj_typeattr)))


(block qcfirmware

       ;;
       ;; Contexts
       ;;

       (filecon
        "/firmware"
        dir
       miscfile_file_context)
      
      (filecon
        "/firmware/.*"
        any
        miscfile_file_context)


 (macro rootfile_obj_type_transition_miscfile ((type ARG1))
              (call .sys.rootfile_obj_type_transition
                    (ARG1 miscfile dir "firmware")))

        (call .xattr.associate_filesystems (miscfile))
        (blockinherit file.misc.obj_template)
)

(block persist

       ;;
       ;; Contexts
       ;;

       (filecon
        "/persist"
        dir
       miscfile_file_context)

      (filecon
        "/persist/.*"
        any
        miscfile_file_context)

    (macro rootfile_obj_type_transition_miscfile ((type ARG1))
              (call .sys.rootfile_obj_type_transition
                    (ARG1 miscfile dir "persist")))


        (call .xattr.associate_filesystems (miscfile))
        (blockinherit file.misc.obj_template)
)
(block sdcard


       ;;
       ;; Contexts
       ;;

       (filecon
        "/mnt/sdcard"
        dir
       miscfile_file_context)

    (macro tmp_obj_type_transition_miscfile ((type ARG1))
      (call .tmp.fs_obj_type_transition
            (ARG1 miscfile dir "sdcard")))

    (blockinherit file.misc.obj_template)
)

(block cache

	;;
	;; Contexts
	;;

	(filecon
		"/cache"
		dir
		miscfile_file_context)

	(filecon
		"/cache/.*"
		any
		miscfile_file_context)

	(macro rootfile_obj_type_transition_miscfile ((type ARG1))
		(call .sys.rootfile_obj_type_transition
			(ARG1 miscfile dir "cache")))

		(call .xattr.associate_filesystems (miscfile))
	(blockinherit file.misc.obj_template)
)
