;; Sepolicy rules for location daemon - xtwifi-client
(in .file
    ;; location exec files transition
    (call .loc_xtwifi_client.obj_type_transition_execfile (unconfined.subj_typeattr)))

;;#============= Xtwifi client ==============
(block loc_xtwifi_client
    ;;
    ;; Contexts
    ;; --------
    (filecon "/usr/bin/xtwifi-client" file execfile_file_context)

    ;;
    ;; Macros
    ;; ------
    (macro obj_type_transition_execfile ((type ARG1))
          (call .file.execfile_obj_type_transition
                (ARG1 execfile file "xtwifi-client")))

    ;;
    ;; Policy
    ;; ------
    (blockinherit .agent.base_template)
    (blockinherit .file.exec.obj_macro_template)
    (blockinherit .loc_daemons_common.loc_daemons_common_template)

    ;; import common rules for location deamons
    (call loc_daemons_common_rules (subj))

    ;; Need qipcrtr socket creations
    (allow subj  self  create_qipcrtr_socket)

    ;; read urandom
    (call .random.read_nodedev_chr_files (subj))

    (allow subj loc_launcher.subj (unix_stream_socket (read write)))

    ;; connect to loc_launcher target stream
    (call .loc_launcher.connectto_unix_stream_sockets (subj))

    (call .loc_launcher.use_fds (subj))
)
